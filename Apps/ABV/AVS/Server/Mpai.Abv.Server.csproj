    <ProjectReference Include="..\..\..\..\Store\AIF.Store.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\PAF\V1.6\PDX\Mpai.Paf.Pdx.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\PAF\V1.6\PMX\Mpai.Paf.Pmx.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\PAF\V1.6\VCR\Mpai.Paf.Vcr.csproj" />
  </ItemGroup>

</Project>
