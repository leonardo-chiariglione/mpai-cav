<Project Sdk="Microsoft.NET.Sdk">

  <!-- Emotion Enhanced Speech, the App: it runs the User Agent (EES.orch) on the Controller of the Module, whose AIMs run on an AIM host of their own. It takes speech and an emotion
       (or a model utterance), and writes the speech with emotion. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EesApp</AssemblyName>
    <RootNamespace>Mpai.Cae.Ees</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Support\Mpai.Cae.Apps.csproj" />
  </ItemGroup>

</Project>