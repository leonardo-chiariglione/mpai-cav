<Project Sdk="Microsoft.NET.Sdk">

  <!-- What the stand-alone Apps of CAE-USC (Speech Restoration System, Emotion Enhanced Speech, Audio Recording Preservation, Enhanced Audioconference Experience) share: starting the
       Module they run - a Controller of its own and the Module's AIMs on an AIM host, a process of its own - and the reading and writing of the files they take and give. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Mpai.Cae.Apps</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\AIF\Controller\AIF.Controller.csproj" />
    <ProjectReference Include="..\..\..\AIF\ControllerApi\Mpai.Aif.Api.csproj" />
    <ProjectReference Include="..\..\..\AIF\UserAgent\Ua\Mpai.Ua.csproj" />
    <ProjectReference Include="..\..\..\AIMs\CAE1\V2.5\Provider\Mpai.Cae.Usc.csproj" />
    <ProjectReference Include="..\..\..\AIF\AimHost\AIF.AimHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>