<Project Sdk="Microsoft.NET.Sdk">

  <!-- Speak Model with Emotion, the App: it runs the User Agent (SME.orch) on the Controller of the Module, whose AIMs run on an AIM host of their own. It takes speech and a model utterance,
       and writes the speech with emotion. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SmeApp</AssemblyName>
    <RootNamespace>Mpai.Cae.Sme</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Support\Mpai.Cae.Apps.csproj" />
  </ItemGroup>

</Project>