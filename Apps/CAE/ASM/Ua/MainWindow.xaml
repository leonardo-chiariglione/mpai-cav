<Window x:Class="Mpai.Cae.AsmUa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:Mpai.Cae.AsmUa"
        Title="Audio scene by voice" Height="780" Width="1180">
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="380"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="InstructionText" Grid.Row="0" Grid.ColumnSpan="2" Text="Wait while the avatar loads" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,8"/>

    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#CCC" BorderThickness="1" Margin="0,0,8,0">
      <local:SceneView x:Name="Room"/>
    </Border>
    <wv2:WebView2 x:Name="Web" Grid.Row="1" Grid.Column="1"/>

    <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="#CCC" BorderThickness="1" Margin="0,8,0,0" Padding="8">
      <StackPanel>
        <TextBlock Text="What I heard:" FontWeight="Bold"/>
        <TextBlock x:Name="HeardText" TextWrapping="Wrap" FontSize="15" Margin="0,2,0,6"/>
        <TextBlock Text="What she answered:" FontWeight="Bold"/>
        <TextBlock x:Name="AnswerText" TextWrapping="Wrap" FontSize="15" Margin="0,2,0,6"/>
        <TextBlock x:Name="StatusText" Foreground="#666" FontSize="13"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="StopButton" Grid.Column="0" Content="Stop" Padding="12,4" Margin="0,0,8,0" Click="StopButton_Click" IsEnabled="False"/>
      <ToggleButton x:Name="MicButton" Grid.Column="1" Content="Microphone is on" IsChecked="True" Padding="12,4" Margin="0,0,8,0" Click="MicButton_Click"/>
      <Button x:Name="LoadButton" Grid.Column="2" Content="Load a sound..." Padding="12,4" Margin="0,0,8,0" Click="LoadButton_Click" IsEnabled="False"/>
      <Button x:Name="HearButton" Grid.Column="3" Content="Hear the scene" Padding="12,4" Margin="0,0,8,0" Click="HearButton_Click" IsEnabled="False"/>
      <TextBox x:Name="InputBox" Grid.Column="4" FontSize="14" VerticalContentAlignment="Center" Padding="6,2" IsEnabled="False"/>
      <Button x:Name="SendButton" Grid.Column="5" Content="Send" Padding="16,4" Margin="8,0,0,0" IsEnabled="False" Click="SendButton_Click"/>
    </Grid>
  </Grid>
</Window>
