<Project Sdk="Microsoft.NET.Sdk">

  <!-- AsmServer - the Controller of Audio Scene Management behind the Controller API's routes (Mpai.Mas.Server). It holds no AIM: the Module's AIMs run on an
       AIM host (AIF.AimHost) of their own. The adapter between the Controller API and the routes, and the shape of the configuration, are those of the Service:
       compiled in, not copied. -->

  <PropertyGroup>
    <AssemblyName>AsmServer</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Mpai.Cae.Asm.Server</RootNamespace>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\..\MAS\Service\src\ControllerApiRunner.cs" Link="ControllerApiRunner.cs" />
    <Compile Include="..\..\..\MAS\Service\src\MasServerConfig.cs" Link="MasServerConfig.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\AIF\Controller\AIF.Controller.csproj" />
    <ProjectReference Include="..\..\..\..\Store\AIF.Store.csproj" />
    <ProjectReference Include="..\..\..\..\AIF\Communication\GlobalStorage\AIF.GlobalStorage.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\Core\Mpai.Core.csproj" />
    <ProjectReference Include="..\..\..\..\AIF\ControllerApi\Mpai.Aif.Api.csproj" />
    <ProjectReference Include="..\..\..\..\AIF\PortData\Mpai.Aif.PortData.csproj" />
    <ProjectReference Include="..\..\..\MAS\Server\Mpai.Mas.Server.csproj" />
  </ItemGroup>

</Project>
