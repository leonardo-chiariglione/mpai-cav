# =============================================================================
#  MMC-AMQ.orch - MPAI Picture Question Answering Service
#  Workflow Description Language v0.3, AIF V3.0
#
#  One Controller, one Module. The User Agent offers the Controller data
#  identified by Data Type and Port Number, and asks for data identified the
#  same way. It names no AIM.
#
#  The Module is Answer to Multimodal Question (MMC-AMQ): it takes a picture,
#  a question about it - spoken, or typed - and the ID of the machine that
#  answers, and gives the answer as that machine's Portable Avatar, which carries
#  the answer as a Text Object. The client shows the words and has them spoken.
#
#  There is no welcome here: this App runs under the MAS launcher, which welcomes
#  the person and offers the Apps (MPAI-MAS.orch). The person chooses a picture,
#  asks, hears the answer, and goes on with another picture until Stop.
#
#  A step completes before the next begins.
# =============================================================================

workflow MMC-AMQ over 1MMC-AMQ-V2.5-I01

on Start:

    ask Controller to start

    loop until Stop:

        # --- the picture the person chooses, shown on the stage ---

        acquire Picture (OSD-BVO-V1.5) = { "Formats": { "Content": { "2D": { "Static": "JPEG" } } } }
        present Picture

        # --- the question, spoken or typed, whichever comes first ---

        acquire UserQuestion (OSD-BSO-V1.5) via VAD
             or TypedQuestion (OSD-BTO-V1.5)

        # --- the Module is given the picture, the question and the machine's ID ---

        offer Picture (OSD-BVO-V1.5)
        branch on TypedQuestion {
            offer TypedQuestion (OSD-BTO-V1.5:1)
        } else {
            offer UserQuestion (OSD-BSO-V1.5:1)
        }
        offer MachineID (string:1) = "Thalia"

        # --- and gives the answer, as the machine's Portable Avatar ---

        ask   MachinePortableAvatar (PAF-PAV-V1.6)
        present MachinePortableAvatar

        wait 2s

on Stop:
    ask Controller to stop