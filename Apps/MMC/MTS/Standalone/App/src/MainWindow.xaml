<Window x:Class="MmcMts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MMC-MTS - Multimodal Translation Service" Height="720" Width="1100">
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="420"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="InstructionText" Grid.Row="0" Grid.ColumnSpan="2" Text="Wait while the avatar loads" FontSize="16" Margin="0,0,0,8"/>

    <!-- the languages -->
    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="I speak" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <ComboBox x:Name="FromBox" Width="140"/>
      <TextBlock Text="  say it in" VerticalAlignment="Center" Margin="6,0"/>
      <ComboBox x:Name="ToBox" Width="140"/>
      <Button x:Name="LanguagesButton" Content="OK" Padding="14,2" Margin="12,0,0,0" IsEnabled="False"/>
    </StackPanel>

    <!-- left: what was said and its translation -->
    <TextBox x:Name="Transcript" Grid.Row="2" Grid.Column="0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
             FontSize="15" Padding="8" Margin="0,0,8,0" BorderBrush="#CCC"/>

    <!-- right: the avatar (speaks the translation) -->
    <wv2:WebView2 x:Name="Web" Grid.Row="2" Grid.Column="1"/>

    <!-- the sentence -->
    <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="TextBoxIn" Grid.Column="0" FontSize="14" VerticalContentAlignment="Center" Padding="6,2"/>
      <Button x:Name="StopButton" Grid.Column="1" Content="Stop" Padding="14,4" Margin="8,0,0,0" Click="StopButton_Click" IsEnabled="False"/>
      <Button x:Name="TranslateButton" Grid.Column="2" Content="Translate" Padding="16,4" Margin="8,0,0,0" IsEnabled="False"/>
    </Grid>

    <TextBlock x:Name="StatusText" Grid.Row="4" Grid.ColumnSpan="2" Foreground="#888" Margin="0,6,0,0"/>
  </Grid>
</Window>
