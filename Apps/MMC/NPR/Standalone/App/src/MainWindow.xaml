<Window x:Class="MmcNpr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MMC-NPR - Newspaper Reading" Height="800" Width="1200">
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="400"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="InstructionText" Grid.Row="0" Grid.ColumnSpan="2" Text="Wait while the avatar loads" FontSize="16" Margin="0,0,0,8"/>

    <!-- left: the page; a click at the top of a column asks for it -->
    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#CCC" BorderThickness="1" Margin="0,0,8,0">
      <Image x:Name="PageView" Stretch="Uniform"/>
    </Border>

    <!-- right: the avatar (reads the column) -->
    <wv2:WebView2 x:Name="Web" Grid.Row="1" Grid.Column="1"/>

    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
      <Button x:Name="StopButton" Content="Stop" Padding="12,4" Click="StopButton_Click" IsEnabled="False"/>
    </StackPanel>

    <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="#CCC" BorderThickness="1" Margin="0,8,0,0" Padding="8">
      <StackPanel>
        <TextBlock Text="The column:" FontWeight="Bold"/>
        <TextBox x:Name="ColumnText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto" FontSize="14" BorderThickness="0" Margin="0,4,0,0"/>
        <TextBlock x:Name="StatusText" Foreground="#888" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
