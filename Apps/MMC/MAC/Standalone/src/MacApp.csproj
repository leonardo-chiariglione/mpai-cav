  </ItemGroup>
  <ItemGroup>
    <!-- Framework -->
    <ProjectReference Include="..\..\..\..\..\AIMs\Core\Mpai.Core.csproj" />
    <!-- The Human-CAV Interaction avatar surface (WebView renderer + present) -->
    <ProjectReference Include="..\..\..\..\..\AIF\UserAgent\UaKit\Mpai.UaKit.csproj" />
    <ProjectReference Include="..\..\..\..\..\AIF\UserAgent\PhysicalLayer\Mpai.PhysicalLayer.csproj" />
    <!-- The workflow interpreter and the parser of the Workflow Description -->
    <ProjectReference Include="..\..\..\..\..\AIF\UserAgent\Ua\Mpai.Ua.csproj" />
    <ProjectReference Include="..\..\..\..\..\AIF\UserAgent\Wdl\Mpai.Wdl.csproj" />
    <!-- The HCI API -->
    <ProjectReference Include="..\..\..\..\..\AIF\ControllerApi\Mpai.Aif.Api.csproj" />
    <!-- the Controller API of a Controller that is a program of its own -->
    <ProjectReference Include="..\..\..\..\..\AIF\UserAgent\Remote\Mpai.Mas.Client.csproj" />
    <!-- Description AIMs (kept) -->
    <!-- Reconciliation: the reused fusion (HCI-IDR) + the new OSD-IDR (verdict + Personal Status) -->
    <!-- Recognition AIMs (CAV-MAC leaves) -->
    <!-- Response and Scene Rendering leaves (PAF-RSR = PSD + TTS + GFD) -->
    <!-- Webcam capture (VOA.Windows) -->
    <ProjectReference Include="..\..\..\..\..\AIMs\CVE\V1.0\VOA.Windows\Mpai.Cve.Voa.Windows.csproj" />
