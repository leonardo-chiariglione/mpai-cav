<Project Sdk="Microsoft.NET.Sdk">

  <!-- MmcController - THE CONTROLLER of the stand-alone Apps of MPAI-MMC (AMC, AMQ, MCA, MTS, NPR), a program of its own. Each App is a User Agent in a program of its own: it reads its workflow and the
       workflow asks this Controller, through the Controller API, to start its Module; this Controller starts the Module and its AIMs as the L3 says. The Controller API is carried over the routes of
       Mpai.Mas.Server. The Module that makes the machine's voice (1PAF-RSR-V1.6-I01) is held here too, which the Apps start in the same way. -->

  <PropertyGroup>
    <AssemblyName>MmcController</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Mpai.Mmc.Controller</RootNamespace>
    <EnableDefaultItems>false</EnableDefaultItems>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\MAS\Service\src\ControllerApiRunner.cs" Link="ControllerApiRunner.cs" />
    <!-- the providers of the Apps that bind a gallery or their own leaves -->
    <Compile Include="AcrProvider.cs" />
    <Compile Include="MacProvider.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\AIF\Controller\AIF.Controller.csproj" />
    <ProjectReference Include="..\..\..\Store\AIF.Store.csproj" />
    <ProjectReference Include="..\..\..\AIF\Communication\GlobalStorage\AIF.GlobalStorage.csproj" />
    <ProjectReference Include="..\..\..\AIMs\Core\Mpai.Core.csproj" />
    <ProjectReference Include="..\..\..\AIF\ControllerApi\Mpai.Aif.Api.csproj" />
    <ProjectReference Include="..\..\..\AIF\PortData\Mpai.Aif.PortData.csproj" />
    <ProjectReference Include="..\..\MAS\Server\Mpai.Mas.Server.csproj" />
    <!-- the AIMs the Controller builds: the providers of the Apps and the leaves they name -->
    <ProjectReference Include="..\..\..\AIMs\Providers\Mpai.Providers.csproj" />
    <ProjectReference Include="..\..\..\AIMs\MMC\V2.5\ASR\Mpai.Mmc.Asr.csproj" />
    <ProjectReference Include="..\..\..\AIMs\MMC\V2.5\TTS\Mpai.Mmc.Tts.csproj" />
    <ProjectReference Include="..\..\..\AIMs\PAF\V1.6\PSD\Mpai.Paf.Psd.csproj" />
    <ProjectReference Include="..\..\..\AIMs\PAF\V1.6\GFD\Mpai.Paf.Gfd.csproj" />
    <ProjectReference Include="..\..\..\AIMs\PAF\V1.6\EFD\Mpai.Paf.Efd.csproj" />
    <ProjectReference Include="..\..\..\AIMs\MMC\V2.5\ESD\Mpai.Mmc.Esd.csproj" />
    <ProjectReference Include="..\..\..\AIMs\OSD\V1.5\IDR\Mpai.Osd.Idr.csproj" />
    <ProjectReference Include="..\..\..\AIMs\PAF\V1.6\FIR\Mpai.Paf.Fir.csproj" />
    <ProjectReference Include="..\..\..\AIMs\MMC\V2.5\SIR\Mpai.Mmc.Sir.csproj" />
    <ProjectReference Include="..\..\..\AIMs\OSD\V1.5\VisualScene\Mpai.Osd.VisualScene.csproj" />
  </ItemGroup>

</Project>
