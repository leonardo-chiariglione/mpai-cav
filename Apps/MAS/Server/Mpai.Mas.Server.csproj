<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Mpai.Mas.Server</RootNamespace>
    <AssemblyName>Mpai.Mas.Server</AssemblyName>
  </PropertyGroup>

  <!-- Kestrel, in a plain library. HttpListener cannot serve HTTPS on Linux at
       all, and on Windows binds its certificate administratively, outside the
       application; Kestrel takes one in-process, the same way on both. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Data Types only. No Controller, no AIMs, no application. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\AIF\PortData\Mpai.Aif.PortData.csproj" />
    <!-- Bouts on the data plane (MPAI-MAS V1.1, API 3.3) and the Instance Credential of the RCA (API 2.1). -->
    <ProjectReference Include="..\..\..\AIF\Communication\Bout\Mpai.Aif.Bout.csproj" />
  </ItemGroup>

</Project>