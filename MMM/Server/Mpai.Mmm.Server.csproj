<Project Sdk="Microsoft.NET.Sdk">

  <!-- Mpai.Mmm.Server: the MMM-API of an M-Instance (MMM/Api/MMM-API.json), on
       Kestrel. Run alone (Program.cs: url, schemas folder) or started in-process
       by the tests. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Mpai.Mmm.Server</RootNamespace>
    <AssemblyName>Mpai.Mmm.Server</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Instance\Mpai.Mmm.csproj" />
    <!-- Use Case 2, which the server can play (demo mode) -->
    <ProjectReference Include="..\Client\Mpai.Mmm.Client.csproj" />
  </ItemGroup>

</Project>
