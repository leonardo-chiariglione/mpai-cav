<Project Sdk="Microsoft.NET.Sdk">

  <!-- ASM STUDIO: the application of Audio Scene Management, on the current AIMs of D:\DI. A User Agent: it holds the names the user gives, issues
       User Commands to Audio Object Editing and Audio Scene Editing (which can undo them), asks the dialogue AIM to understand typed and spoken
       commands, renders the scene with the spatial renderer, and shows Thalia speaking. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AsmStudio</AssemblyName>
    <RootNamespace>Mpai.AsmStudio</RootNamespace>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\AIMs\Core\Mpai.Core.csproj" />
    <ProjectReference Include="..\..\..\ControllerApi\Mpai.Aif.Api.csproj" />
    <ProjectReference Include="..\..\Rca\Mpai.Rca.csproj" />
    <ProjectReference Include="..\..\Wdl\Mpai.Wdl.csproj" />
    <ProjectReference Include="..\..\Remote\Mpai.Mas.Client.csproj" />
    <ProjectReference Include="..\..\UaKit\SpatialAudio\Mpai.SpatialAudio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\thalia.html" CopyToOutputDirectory="PreserveNewest" Link="Assets\thalia.html" />
    <Content Include="..\..\Assets\cav-avatar.glb" CopyToOutputDirectory="PreserveNewest" Link="Assets\cav-avatar.glb" />
    <Content Include="..\..\Assets\studio.hdr" CopyToOutputDirectory="PreserveNewest" Link="Assets\studio.hdr" />
  </ItemGroup>

</Project>
