<Project Sdk="Microsoft.NET.Sdk">

  <!-- AIF.SecureProfile - the Controller of the Secure Profile split in two parts (AIF V3.0, Zero Trust and Profiles 6.2; Security API 1):
       the Secure Controller, in the area where secure code is executed, holds the Controller - and so the Module - and the Security API on the root of trust;
       the Non-Secure Controller interfaces with the User Agent and relays its requests, whose data is protected end to end between the User Agent and the
       Secure Controller with a key agreed after the User Agent has verified the Attestation of the Secure Controller. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControllerApi\Mpai.Aif.Api.csproj" />
    <ProjectReference Include="..\Security\AIF.Security.csproj" />
  </ItemGroup>

</Project>
