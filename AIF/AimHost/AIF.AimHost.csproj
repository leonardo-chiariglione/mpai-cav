<Project Sdk="Microsoft.NET.Sdk">

  <!-- THE AIM HOST (M3217 3.1): a program on a machine that is to hold AIMs. It
       instantiates them on a Controller's orders and does nothing else. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AIF.AimHost</AssemblyName>
    <RootNamespace>AIF.RemoteHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Controller\AIF.Controller.csproj" />
    <ProjectReference Include="..\Store\AIF.Store.csproj" />
    <ProjectReference Include="..\Trust\AIF.Trust.csproj" />
    <ProjectReference Include="..\Communication\Channels\AIF.Channels.csproj" />
    <ProjectReference Include="..\Communication\SharedStorage\AIF.SharedStorage.csproj" />
  </ItemGroup>

</Project>
