aim:MMC-EDP-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-EDP-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-cav/blob/main/AIMs/MMC/V2.5/EDP/EdpAimProcessor.cs> ;
    mkg:codePath "AIMs/MMC/V2.5/EDP/EdpAimProcessor.cs" ;
    mkg:description "This AIM implements the Entity Dialogue Processing function: it produces the Machine Text and Machine Personal Status from the human Text, its Text Descriptors, the human Personal Status and identity, the identifiers of the scene objects and the Basic Audio and Visual Scene Geometries, using the running Summary as dialogue memory. In Audio Scene Management (CAE-ASM), given the Audio Scene the User edits, it turns what the User says into User Commands for CAE-ASM, says what was done or asks when the request is unclear, and tells the User Agent, as Text For UA, what only the User Agent does: undo, save, stop." ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-EDP-V2.5/port/Input/CAV-AHM-V2.0/0>,
        <https://mpai.community/kg/aim/MMC-EDP-V2.5/port/Input/CAV-ERH-V2.0/0>,
        <https://mpai.community/kg/aim/MMC-EDP-V2.5/port/Input/MMC-EPS-V2.5/1>,
        <https://mpai.community/kg/aim/MMC-EDP-V2.5/port/Input/MMC-EPS-V2.5/2>,
        <https://mpai.community/kg/aim/MMC-EDP-V2.5/port/Input/MMC-SUM-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-EDP-V2.5/port/Input/MMC-TDO-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-EDP-V2.5/port/Input/OSD-ASD-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-EDP-V2.5/port/Input/OSD-BAG-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-EDP-V2.5/port/Input/OSD-BAS-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-EDP-V2.5/port/Input/OSD-BMS-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-EDP-V2.5/port/Input/OSD-BOO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-EDP-V2.5/port/Input/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-EDP-V2.5/port/Input/OSD-BTO-V1.5/2>,
        <https://mpai.community/kg/aim/MMC-EDP-V2.5/port/Input/OSD-BTO-V1.5/3>,
        <https://mpai.community/kg/aim/MMC-EDP-V2.5/port/Input/OSD-BVG-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-EDP-V2.5/port/Input/OSD-IID-V1.5/1>,
