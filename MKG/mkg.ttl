        <https://mpai.community/kg/aim/UAG-3OD-V1.0/port/Output/OSD-3DO-V1.5/0>,
        <https://mpai.community/kg/aim/UAG-3OD-V1.0/port/Output/OSD-B3O-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/UAG/V1.0/AIMs/3DModelObjectDelivery.json> ;
