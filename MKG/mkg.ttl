    mkg:schema <https://schemas.mpai.community/OSD/V1.5/AIMs/BasicUltrasoundSceneDescription.json> ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-osd/v1-5/ai-modules/basic-ultrasound-scene-description/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-osd/v1-5/> .

aim:OSD-UID-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-UID-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "User Identification: identifies a user from their face and their speech and reconciles the two into one answer. Speaker Identity Recognition matches the speech, Face Identity Recognition matches the face, and Identity Reconciliation combines the two identities. Identification states whether the face and the speech match somebody known; User ID states who." ;
    mkg:flow <https://mpai.community/kg/aim/OSD-UID-V1.5/flow/1>,
        <https://mpai.community/kg/aim/OSD-UID-V1.5/flow/2>,
        <https://mpai.community/kg/aim/OSD-UID-V1.5/flow/3>,
        <https://mpai.community/kg/aim/OSD-UID-V1.5/flow/4>,
        <https://mpai.community/kg/aim/OSD-UID-V1.5/flow/5>,
        <https://mpai.community/kg/aim/OSD-UID-V1.5/flow/6>,
        <https://mpai.community/kg/aim/OSD-UID-V1.5/flow/7>,
        <https://mpai.community/kg/aim/OSD-UID-V1.5/flow/8> ;
    mkg:ofStandard standard:OSD ;
    mkg:port <https://mpai.community/kg/aim/OSD-UID-V1.5/port/Input/OSD-BAS-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-UID-V1.5/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-UID-V1.5/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-UID-V1.5/port/Input/OSD-BVS-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-UID-V1.5/port/Output/OSD-IID-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-UID-V1.5/port/Output/boolean/0> ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/AIMs/UserIdentification.json> ;
    mkg:subAIM aim:MMC-SIR-V2.5,
        aim:OSD-IDR-V1.5,
        aim:PAF-FIR-V1.6 ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-osd/v1-5/> .

aim:PAF-SAS-V1.6 a mkg:AIM ;
    mkg:acronym "PAF-SAS-V1.6" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-cav/blob/main/AIMs/PAF/V1.6/SAS/SasAimProcessor.cs> ;
    mkg:codePath "AIMs/PAF/V1.6/SAS/SasAimProcessor.cs" ;
    mkg:description "Speaking Avatar Synthesis: makes a Speaking Avatar of the input Avatar - its 3D Model animated by the Face Descriptors and the Body Descriptors, uttering the Speech. The Speaking Avatar is ready to play: the Avatar it holds carries the Model, the Speech and the Face and Body Descriptors, time-aligned. The Avatar is kept: given once - when the Module starts, or when the User Agent changes avatar - it is used for every utterance until another arrives." ;
    mkg:ofStandard standard:PAF ;
    mkg:port <https://mpai.community/kg/aim/PAF-SAS-V1.6/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-SAS-V1.6/port/Input/OSD-SPO-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-SAS-V1.6/port/Input/PAF-AVT-V1.6/0>,
        <https://mpai.community/kg/aim/PAF-SAS-V1.6/port/Input/PAF-BDO-V1.6/0>,
        <https://mpai.community/kg/aim/PAF-SAS-V1.6/port/Input/PAF-FDO-V1.6/0>,
        <https://mpai.community/kg/aim/PAF-SAS-V1.6/port/Output/XRV-SAV-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/PAF/V1.6/AIMs/SpeakingAvatarSynthesis.json> ;
    mkg:title "Speaking Avatar Synthesis V1.6" ;
    mkg:webPage <https://mpai.community/standards/mpai-paf/v1-6/ai-modules/speaking-avatar-synthesis/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-paf/v1-6/> .

