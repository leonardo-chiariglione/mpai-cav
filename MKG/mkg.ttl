        <https://mpai.community/kg/aim/CAV-BED-V2.0/port/Input/OSD-BOS-V1.5/0>,
        <https://mpai.community/kg/aim/CAV-BED-V2.0/port/Input/OSD-BRS-V1.5/0>,
        <https://mpai.community/kg/aim/CAV-BED-V2.0/port/Input/OSD-BUS-V1.5/0>,
        <https://mpai.community/kg/aim/CAV-BED-V2.0/port/Input/OSD-BVS-V1.5/0>,
        <https://mpai.community/kg/aim/CAV-BED-V2.0/port/Input/OSD-OSA-V1.5/0>,
        <https://mpai.community/kg/aim/CAV-BED-V2.0/port/Output/CAV-BED-V2.0/0> ;
    mkg:schema <https://schemas.mpai.community/CAV2/V2.0/AIMs/BasicEnvironmentDescription.json> ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-cav/tec/v2-0/ai-modules/basic-environment-description/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-cav/> .

aim:PAF-SAF-V1.6 a mkg:AIM ;
    mkg:acronym "PAF-SAF-V1.6" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Speaking Avatar Formation: forms the Speaking Avatar of the input Avatar - its Model animated as it utters the Speech. Generative Face Description and Generative Body Description make the Face and Body Descriptors from the Speech and the Text, expressive when a Face or Body Personal Status is supplied; Speaking Avatar Synthesis packages the Avatar, the Speech and the Descriptors, time-aligned and ready to play." ;
    mkg:flow <https://mpai.community/kg/aim/PAF-SAF-V1.6/flow/1>,
        <https://mpai.community/kg/aim/PAF-SAF-V1.6/flow/10>,
