<https://mpai.community/kg/datatype/CVE/VisualProfile> a mkg:DataType ;
    mkg:acronym "CVE/VisualProfile" ;
    mkg:description "How an Object or a Scene looks, as the Acoustic Profile says how it sounds. An Object's: its colour, metalness, roughness, transparency and emission - what it looks like wherever it is (#/$defs/Object). A Scene's: its light sources, its ambient light and its atmosphere - what the space does to what is seen in it (#/$defs/Scene). A Data Type refers to the one it has. Like the Acoustic Profile, it belongs to Basic Objects and Basic Scenes." ;
    mkg:noAcronym true ;
    mkg:schema <https://schemas.mpai.community/CVE/V1.0/data/VisualProfile.json> ;
    mkg:title "Visual Profile V1.0" ;
    mkg:uses datatype:OSD-LTS-V1.5,
        datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0,
        datatype:TFA-CLQ-V1.5 .

