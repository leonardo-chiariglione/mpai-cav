        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/4>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/5>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/6>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/7>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/8>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/9> ;
    mkg:ofStandard standard:PAF ;
    mkg:port <https://mpai.community/kg/aim/PAF-CRX-V1.6/port/Input/OSD-OPV-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/port/Input/PAF-PAV-V1.6/0>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/port/Output/OSD-BMS-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/port/Output/OSD-BTO-V1.5/0>,
