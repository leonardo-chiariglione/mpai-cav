datatype:MMC-EPS-V2.5 a mkg:DataType ;
    mkg:acronym "MMC-EPS-V2.5" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-cav/blob/main/AIMs/Core/OSD/PersonalStatus.cs> ;
    mkg:codePath "AIMs/Core/OSD/PersonalStatus.cs" ;
    mkg:description "",
        "The Personal Status of an Entity, assembled by Personal Status Multiplexing from the per-modality Personal Statuses (Text, Speech, Face, Body). It combines the modality Personal Statuses that are present; each is optional and at least one is expected." ;
    mkg:ofStandard standard:MMC ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/data/EntityPersonalStatus.json>,
        <https://schemas.mpai.community/MMC/V2.5/data/PersonalStatus.json> ;
    mkg:title "Entity Personal Status V2.5",
        "Personal Status V2.5" ;
    mkg:uses datatype:MMC-BPS-V2.5,
        datatype:MMC-ECS-V2.5,
        datatype:MMC-EEM-V2.5,
        datatype:MMC-ESA-V2.5,
        datatype:MMC-FPS-V2.5,
        datatype:MMC-SPS-V2.5,
        datatype:MMC-TPS-V2.5,
        datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 .

