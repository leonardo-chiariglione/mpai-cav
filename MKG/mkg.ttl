aim:PAF-RSR-V1.6 a mkg:AIM ;
    mkg:acronym "PAF-RSR-V1.6" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Response and Scene Rendering: renders the machine's response - a Text - as a Speaking Avatar of the input Avatar Model, ready to play; whoever requested it places it in a scene and renders it (e.g. with Scene and Avatar Rendering). Personal Status De-multiplexing splits a Personal Status into the Speech, Face and Body Personal Statuses that make the avatar expressive; Text-To-Speech makes the Machine Speech, with a Speech Model when one is supplied; Speaking Avatar Formation forms the Speaking Avatar from it - or from an Input Speech, when one is supplied." ;
    mkg:flow <https://mpai.community/kg/aim/PAF-RSR-V1.6/flow/1>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/flow/10>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/flow/11>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/flow/2>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/flow/3>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/flow/4>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/flow/6>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/flow/7>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/flow/8>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/flow/9> ;
    mkg:notAligned true ;
    mkg:ofStandard standard:PAF ;
    mkg:port <https://mpai.community/kg/aim/PAF-RSR-V1.6/port/Input/AIP-MLO-V1.0/0>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/port/Input/MMC-EPS-V2.5/0>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/port/Input/OSD-B3O-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/port/Input/OSD-BMS-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/port/Input/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/port/Input/OSD-BTO-V1.5/2>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/port/Input/OSD-OPV-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/port/Input/OSD-SPO-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/port/Input/OSD-TXO-V1.5/1>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/port/Input/OSD-TXO-V1.5/2>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/port/Input/PAF-AVT-V1.6/0>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/port/Output/OSD-BMS-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/port/Output/XRV-SAV-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/PAF/V1.6/AIMs/ResponseAndSceneRendering.json> ;
    mkg:subAIM aim:MMC-PDX-V2.5,
        aim:MMC-TTS-V2.5,
        aim:PAF-SAF-V1.6 ;
    mkg:title "Response and Scene Rendering V1.6" ;
