    mkg:webSpec <https://mpai.community/standards/mpai-cve/V1-0/ai-modules/visual-object-acqusition/> .

aim:OSD-LOA-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-LOA-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "LiDAR Object Acquisition: receives what a LiDAR sensor captures and provides it as a Basic LiDAR Object, time-stamped, its Qualifier stating the sensor, its calibration and its mounting pose." ;
    mkg:ofStandard standard:OSD ;
    mkg:port <https://mpai.community/kg/aim/OSD-LOA-V1.5/port/Input/OSD-BLO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-LOA-V1.5/port/Output/OSD-BLO-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/AIMs/LiDARObjectAcquisition.json> ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-osd/> .

aim:OSD-ROA-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-ROA-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "RADAR Object Acquisition: receives a Basic RADAR Object and provides a Basic RADAR Object." ;
