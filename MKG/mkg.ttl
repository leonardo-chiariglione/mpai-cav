<https://mpai.community/kg/datatype/CAE3/AcousticProfile> a mkg:DataType ;
    mkg:acronym "CAE3/AcousticProfile" ;
    mkg:description "The acoustics of an Object or of a Scene. An Object's: its frequency range, spectrogram, loudness and directional patterns (#/$defs/Object). A Scene's: its reflectivity, reverberation, diffusion, absorption and Doppler effect (#/$defs/Scene). A Data Type refers to the one it has." ;
    mkg:noAcronym true ;
    mkg:schema <https://schemas.mpai.community/CAE3/V1.0/data/AcousticProfile.json> ;
    mkg:title "Acoustic Profile V1.0" ;
    mkg:uses datatype:OSD-PLT-V1.5,
        datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 .

