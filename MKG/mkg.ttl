aim:CAE-AOE-V1.0 a mkg:AIM ;
    mkg:acronym "CAE-AOE-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-cav/blob/main/AIMs/CAE3/V1.0/AOE/AoeAimProcessor.cs> ;
    mkg:codePath "AIMs/CAE3/V1.0/AOE/AoeAimProcessor.cs" ;
    mkg:description "Audio Object Editing. One Basic Audio Object is open at a time, so a User Command need not name it: a Basic Audio Object arriving is opened - from Shared Storage, by its identifier - or, new (a sound the User Agent captured), created. The User Command modifies what it is like (ModifiedObjects: the Object part of the Acoustic Profile; LUFS) and where it is heard from (UserPoV, also on its own Port). Every edit is a new version in Shared Storage. Outputs: the open Basic Audio Object, to the Module and to Audio Scene Editing, and the User Command, with its report half (UserCommandReport) saying how each action was executed." ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-AOE-V1.0/port/Input/CAE-UCM-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-AOE-V1.0/port/Input/OSD-BAO-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-AOE-V1.0/port/Input/OSD-OPV-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-AOE-V1.0/port/Output/CAE-UCM-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-AOE-V1.0/port/Output/OSD-BAO-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/CAE3/V1.0/AIMs/AudioObjectEditing.json> ;
    mkg:title "Audio Object Editing V1.0" ;
    mkg:webPage <https://mpai.community/standards/mpai-cae/asm/v1-0/ai-modules/audio-object-editing/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-cae/> .

aim:CAE-ASE-V1.0 a mkg:AIM ;
    mkg:acronym "CAE-ASE-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-cav/blob/main/AIMs/CAE3/V1.0/ASE/AseAimProcessor.cs> ;
    mkg:codePath "AIMs/CAE3/V1.0/ASE/AseAimProcessor.cs" ;
    mkg:description "Audio Scene Editing. One Basic Audio Scene is open at a time, so a User Command need not name it: a Basic Audio Scene arriving is opened, and the first Object added to no open Scene creates one. The User Command places Basic Audio Objects - named by their identifiers in Shared Storage - (AddedObjects), moves them (MovedObjects), changes where they are (ChangedObjects), takes them out (RemovedObjects) and sets where the Scene is heard from (UserPoV, also on its own Port). Every edit is a new version in Shared Storage. Outputs: the open Basic Audio Scene, and the User Command, with its report half (UserCommandReport) saying how each action was executed." ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-ASE-V1.0/port/Input/CAE-UCM-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-ASE-V1.0/port/Input/OSD-BAO-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-ASE-V1.0/port/Input/OSD-BAS-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-ASE-V1.0/port/Input/OSD-OPV-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-ASE-V1.0/port/Output/CAE-UCM-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-ASE-V1.0/port/Output/OSD-BAS-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/CAE3/V1.0/AIMs/AudioSceneEditing.json> ;
    mkg:title "Audio Scene Editing V1.0" ;
    mkg:webPage <https://mpai.community/standards/mpai-cae/asm/v1-0/ai-modules/audio-scene-editing/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-cae/> .

aim:CAE-SSE-V1.0 a mkg:AIM ;
    mkg:acronym "CAE-SSE-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-cav/blob/main/AIMs/CAE3/V1.0/SSE/SseAimProcessor.cs> ;
    mkg:codePath "AIMs/CAE3/V1.0/SSE/SseAimProcessor.cs" ;
    mkg:description "Speech Scene Editing. One Basic Speech Scene is open at a time: a Basic Speech Scene arriving is opened, and the first Object added to no open Scene creates one. The User Command places Basic Speech Objects - named by their identifiers in Shared Storage - (AddedObjects), moves them, changes where they are, takes them out and sets where the Scene is heard from (UserPoV, also on its own Port). Every edit is a new version in Shared Storage; a member is held by its identifier and read from Shared Storage when the Scene is output. Outputs: the open Basic Speech Scene, and the User Command, with its report half (UserCommandReport) saying how each action was executed." ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-SSE-V1.0/port/Input/CAE-UCM-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-SSE-V1.0/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-SSE-V1.0/port/Input/OSD-BSS-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-SSE-V1.0/port/Input/OSD-OPV-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-SSE-V1.0/port/Output/CAE-UCM-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-SSE-V1.0/port/Output/OSD-BSS-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/CAE3/V1.0/AIMs/SpeechSceneEditing.json> ;
    mkg:title "Speech Scene Editing V1.0" ;
    mkg:webSpec <https://mpai.community/standards/mpai-cae/> .

