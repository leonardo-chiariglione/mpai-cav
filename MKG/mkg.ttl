        unit:CameraUnit,
        unit:LoudspeakerUnit,
        unit:MicrophoneUnit .

aim:CUI-CAP-V2.0 a mkg:AIM ;
    mkg:acronym "CUI-CAP-V2.0" ;
    mkg:apiProfile "Secure" ;
    mkg:description "This composite AIM computes the Organisation, Primary Default, and Primary Discontinuity Descriptors of CUI-CPP." ;
    mkg:notAligned true ;
    mkg:ofStandard standard:CUI ;
    mkg:port <https://mpai.community/kg/aim/CUI-CAP-V2.0/port/Input/CUI-CRD-V2.0/0>,
        <https://mpai.community/kg/aim/CUI-CAP-V2.0/port/Input/CUI-FND-V2.0/0>,
        <https://mpai.community/kg/aim/CUI-CAP-V2.0/port/Input/CUI-GVS-V2.0/0>,
        <https://mpai.community/kg/aim/CUI-CAP-V2.0/port/Input/CUI-LRD-V2.0/0>,
        <https://mpai.community/kg/aim/CUI-CAP-V2.0/port/Input/number/0>,
        <https://mpai.community/kg/aim/CUI-CAP-V2.0/port/Output/CUI-ORD-V2.0/0>,
        <https://mpai.community/kg/aim/CUI-CAP-V2.0/port/Output/CUI-PDD-V2.0/0>,
        <https://mpai.community/kg/aim/CUI-CAP-V2.0/port/Output/CUI-PSD-V2.0/0> ;
    mkg:schema <https://schemas.mpai.community/CUI1/V2.0/AIMs/CompanyAssessmentAndPrediction.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:CUI-CDP-V2.0,
        aim:CUI-OMA-V2.0,
