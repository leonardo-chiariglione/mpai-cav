aim:CAE-SOE-V1.0 a mkg:AIM ;
    mkg:acronym "CAE-SOE-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-cav/blob/main/AIMs/CAE3/V1.0/SOE/SoeAimProcessor.cs> ;
    mkg:codePath "AIMs/CAE3/V1.0/SOE/SoeAimProcessor.cs" ;
    mkg:description "Speech Object Editing. One Basic Speech Object is open at a time: a Basic Speech Object arriving is opened - from Shared Storage, by its identifier - or kept. The User Command changes where it is heard from (UserPoV, also on its own Port) and its Speech Qualifier or Spatial Attitude (ChangedObjects), and has it translated (TranslatedObjects): the Speech and a Language Selector go to Text and Speech Translation, and the Translation, when it comes back, replaces the original under its identifier - so every Speech Scene holding it holds the translation, at its place. Outputs: the open Basic Speech Object, to the Module and to Speech Scene Editing, and the User Command, with its report half (UserCommandReport) saying how each action was executed (for a translation, when it is done)." ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-SOE-V1.0/port/Input/CAE-UCM-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-SOE-V1.0/port/Input/OSD-BSO-V1.5/1>,
        <https://mpai.community/kg/aim/CAE-SOE-V1.0/port/Input/OSD-BSO-V1.5/2>,
        <https://mpai.community/kg/aim/CAE-SOE-V1.0/port/Input/OSD-OPV-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-SOE-V1.0/port/Output/CAE-UCM-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-SOE-V1.0/port/Output/OSD-BSO-V1.5/1>,
        <https://mpai.community/kg/aim/CAE-SOE-V1.0/port/Output/OSD-BSO-V1.5/2>,
        <https://mpai.community/kg/aim/CAE-SOE-V1.0/port/Output/OSD-SEL-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/CAE3/V1.0/AIMs/SpeechObjectEditing.json> ;
    mkg:title "Speech Object Editing V1.0" ;
    mkg:webSpec <https://mpai.community/standards/mpai-cae/> .

aim:CAV-SAG-V2.0 a mkg:AIM ;
    mkg:acronym "CAV-SAG-V2.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Spatial Attitude Generation: produces the ego Spatial Attitude of the CAV - position, orientation, their velocities and accelerations, with their accuracies - on one frame of reference, from the Spatial Attitude the Motion Actuation Subsystem estimates from odometry and inertial sensors, corrected by GNSS where a GNSS Object is available." ;
