        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/3>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/4>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/5>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/6>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/7>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/8>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/9> ;
    mkg:ofStandard standard:PAF ;
    mkg:port <https://mpai.community/kg/aim/PAF-AVS-V1.6/port/Input/MMC-SUM-V2.5/0>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/port/Input/OSD-BMS-V1.5/0>,
