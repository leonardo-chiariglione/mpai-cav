    mkg:schema <https://schemas.mpai.community/PAF/V1.6/AIMs/VideoconferenceClientReceiver.json> ;
    mkg:subAIM aim:PAF-AVC-V1.6,
        aim:PAF-PDX-V1.6,
        aim:PAF-RSR-V1.6,
        aim:PAF-VSC-V1.6 ;
    mkg:title "Videoconference Client Receiver V1.6" ;
    mkg:webPage <https://mpai.community/standards/mpai-paf/v1-6/ai-modules/videoconference-client-receiver/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-paf/v1-6/> .

aim:PAF-SPA-V1.6 a mkg:AIM ;
    mkg:acronym "PAF-SPA-V1.6" ;
    mkg:apiProfile "Basic" ;
    mkg:description "This AIM authenticates a participant: from its Participant ID, its Speech Object and its Face Object it gives the Avatar ID (the Subscriber ID) the participant is known by." ;
