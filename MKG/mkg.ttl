aim:CAV-ESS-V2.0 a mkg:AIM ;
    mkg:acronym "CAV-ESS-V2.0" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-cav/blob/main/AIMs/CAV/V2.0/ESS/BasicEnvironmentDescription.cs> ;
    mkg:codePath "AIMs/CAV/V2.0/ESS/BasicEnvironmentDescription.cs" ;
    mkg:description "Environment Sensing Subsystem: senses the environment of the CAV with its Audio, Visual, RADAR, LiDAR and Ultrasound sensors, describes what each technology senses as Basic Scene Descriptors on the ego frame of reference given by Spatial Attitude Generation, converts the Offline Map into Basic Scene Descriptors of the same kind, and fuses them all into the Basic Environment Descriptors it gives the Autonomous Motion Subsystem. Each scene describer raises an Alert, without waiting for fusion, when what it senses requires urgent consideration. The Basic Environment Descriptors return to each scene describer as its prior. It runs continuously, and goes on when a sensor fails." ;
    mkg:flow <https://mpai.community/kg/aim/CAV-ESS-V2.0/flow/1>,
        <https://mpai.community/kg/aim/CAV-ESS-V2.0/flow/10>,
