aim:OSD-IDR-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-IDR-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-cav/blob/main/AIMs/OSD/V1.5/IDR/IdrAimProcessor.cs> ;
