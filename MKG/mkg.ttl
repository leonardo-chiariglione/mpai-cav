    mkg:webSpec <https://mpai.community/standards/mpai-aih/hsp/v1-0/> .

aim:CAV-AMI-V2.0 a mkg:AIM ;
    mkg:acronym "CAV-AMI-V2.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "This AIM interprets AMS-MAS Messages into Brake/Motor/Wheel Commands and interprets responses into an AMS-MAS Message." ;
    mkg:ofStandard standard:CAV ;
    mkg:port <https://mpai.community/kg/aim/CAV-AMI-V2.0/port/Input/CAV-AMM-V2.0/0>,
        <https://mpai.community/kg/aim/CAV-AMI-V2.0/port/Output/CAV-AMM-V2.0/0>,
        <https://mpai.community/kg/aim/CAV-AMI-V2.0/port/Output/CAV-BRC-V2.0/0>,
        <https://mpai.community/kg/aim/CAV-AMI-V2.0/port/Output/CAV-MRC-V2.0/0>,
        <https://mpai.community/kg/aim/CAV-AMI-V2.0/port/Output/CAV-WHC-V2.0/0> ;
    mkg:schema <https://schemas.mpai.community/CAV2/V2.0/AIMs/AMSMASMessageInterpretation.json> ;
    mkg:title "AMS-MAS Message Interpretation V2.0" ;
    mkg:webPage <https://mpai.community/standards/mpai-cav/tec/v2-0/ai-modules/ams-mas-message-interpretation/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-cav/> .

aim:CAV-MSA-V2.0 a mkg:AIM ;
    mkg:acronym "CAV-MSA-V2.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "This AIM computes the Spatial Attitude of the CAV from its Spatial Data: the odometer, the speedometer, the accelerometer, the inclinometers and, for the heading, the gyroscope." ;
    mkg:ofStandard standard:CAV ;
    mkg:port <https://mpai.community/kg/aim/CAV-MSA-V2.0/port/Input/CAV-SPD-V2.0/0>,
        <https://mpai.community/kg/aim/CAV-MSA-V2.0/port/Output/OSD-OSA-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/CAV2/V2.0/AIMs/MASSpatialAttitudeGeneration.json> ;
    mkg:title "MAS Spatial Attitude Generation V2.0" ;
    mkg:webPage <https://mpai.community/standards/mpai-cav/tec/v2-0/ai-modules/mas-spatial-attitude-generation/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-cav/> .

aim:CVE-VSI-V1.0 a mkg:AIM ;
    mkg:acronym "CVE-VSI-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-cav/blob/main/AIMs/CVE/V1.0/VSI/CveVsiAimProcessor.cs> ;
    mkg:codePath "AIMs/CVE/V1.0/VSI/CveVsiAimProcessor.cs" ;
    mkg:description "Visual Scene object Identification: for each visual object of the Basic Visual Scene, runs SCRFD and tags the object's Visual Qualifier with VisualObjectType (Face if a face is detected, else Object), emitting the re-qualified Basic Visual Object. Face Recognition and Visual Instance Identification each act on their own type." ;
    mkg:ofStandard standard:CVE ;
    mkg:port <https://mpai.community/kg/aim/CVE-VSI-V1.0/port/Input/OSD-BVS-V1.5/0>,
        <https://mpai.community/kg/aim/CVE-VSI-V1.0/port/Output/OSD-BVO-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/CVE/V1.0/AIMs/VisualSceneObjectIdentification.json> ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-cve/v1-0/> .

aim:MMC-MAT-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-MAT-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Multimodal Anonymous Translation: the HCI Module for spoken translation with a Speaking Avatar. Automatic Speech Recognition recognises the human's speech into text; Text-to-Text Translation translates it into the language named by the Language Selector; Response and Scene Rendering speaks the translation and produces the lip-synced Machine Face Descriptors in the target language. The translated text is also exposed. Non-affective; no Personal Status is supplied. Acquisition and delivery are the User Agent, not sub-AIMs." ;
    mkg:flow <https://mpai.community/kg/aim/MMC-MAT-V2.5/flow/1>,
        <https://mpai.community/kg/aim/MMC-MAT-V2.5/flow/2>,
        <https://mpai.community/kg/aim/MMC-MAT-V2.5/flow/3>,
        <https://mpai.community/kg/aim/MMC-MAT-V2.5/flow/4>,
        <https://mpai.community/kg/aim/MMC-MAT-V2.5/flow/7>,
        <https://mpai.community/kg/aim/MMC-MAT-V2.5/flow/8> ;
    mkg:notAligned true ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-MAT-V2.5/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MAT-V2.5/port/Input/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-MAT-V2.5/port/Input/OSD-BTO-V1.5/2>,
        <https://mpai.community/kg/aim/MMC-MAT-V2.5/port/Input/OSD-SEL-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MAT-V2.5/port/Input/PAF-AVT-V1.6/0>,
        <https://mpai.community/kg/aim/MMC-MAT-V2.5/port/Output/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MAT-V2.5/port/Output/XRV-SAV-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/MultimodalAnonymousTranslation.json> ;
    mkg:subAIM aim:MMC-ASR-V2.5,
        aim:MMC-TTT-V2.5,
        aim:PAF-RSR-V1.6 ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/> .

