    mkg:port <https://mpai.community/kg/aim/PAF-GFD-V1.6/port/Input/MMC-FPS-V2.5/0>,
        <https://mpai.community/kg/aim/PAF-GFD-V1.6/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-GFD-V1.6/port/Input/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-GFD-V1.6/port/Input/OSD-TXO-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-GFD-V1.6/port/Output/PAF-FDO-V1.6/0> ;
    mkg:schema <https://schemas.mpai.community/PAF/V1.6/AIMs/GenerativeFaceDescription.json> ;
    mkg:title "Generative Face Description V1.6" ;
    mkg:webPage <https://mpai.community/standards/mpai-paf/v1-6/ai-modules/generative-face-description/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-paf/v1-6/> .

