aim:CAE-AOA-V1.0 a mkg:AIM ;
    mkg:acronym "CAE-AOA-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "This AIM acquires an Audio Object from a source. A device yields a Basic Audio Object, because a microphone produces samples and not a composition; a stored source may yield either, because what was stored may already be composed. The output Port therefore accepts both, and the value's Header says which was acquired. The source, not this Port, decides." ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-AOA-V1.0/port/Input/CAE-UCM-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-AOA-V1.0/port/Input/OSD-AUO-V1.5/2>,
        <https://mpai.community/kg/aim/CAE-AOA-V1.0/port/Input/OSD-BAO-V1.5/1>,
        <https://mpai.community/kg/aim/CAE-AOA-V1.0/port/Input/OSD-BAO-V1.5/2>,
        <https://mpai.community/kg/aim/CAE-AOA-V1.0/port/Output/OSD-AUO-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-AOA-V1.0/port/Output/OSD-BAO-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/CAE3/V1.0/AIMs/AudioObjectAcquisition.json> ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-cae/asm/v1-0/ai-modules/audio-object-acquisition/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-cae/> .

aim:CVE-VOA-V1.0 a mkg:AIM ;
    mkg:acronym "CVE-VOA-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Visual Object Acquisition: receives a User Command, a Visual Object, and provides a Visual Object." ;
