    mkg:schema <https://schemas.mpai.community/CAV2/V2.0/AIMs/SpatialAttitudeGeneration.json> ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-cav/tec/v2-0/ai-modules/spatial-attitude-generation/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-cav/> .

