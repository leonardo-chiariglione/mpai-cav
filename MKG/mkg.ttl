    mkg:schema <https://schemas.mpai.community/PAF/V1.6/AIMs/AvatarVideoconferenceServer.json> ;
    mkg:subAIM aim:MMC-TST-V2.5,
        aim:PAF-PDX-V1.6,
        aim:PAF-PMX-V1.6,
        aim:PAF-SPA-V1.6 ;
    mkg:title "Avatar Videoconference Server V1.6" ;
    mkg:webPage <https://mpai.community/standards/mpai-paf/v1-6/ai-modules/avatar-videoconference-server/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-paf/v1-6/> .

