aim:CAE-AII-V2.5 a mkg:AIM ;
    mkg:acronym "CAE-AII-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-cav/blob/main/AIMs/CAE3/V1.0/AII/CaeAiiAimProcessor.cs> ;
    mkg:codePath "AIMs/CAE3/V1.0/AII/CaeAiiAimProcessor.cs" ;
    mkg:description "Audio Instance Identification: identifies a (generic, non-speech) Basic Audio Object against the AudioSet taxonomy, producing an Audio Object Identifier (OSD-IID). The audio analogue of Visual Instance Identification. Engine: YAMNet. The audio arrives already mono, 16 kHz, 16-bit PCM (from Audio Qualifier Conversion), so the samples are read directly." ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-AII-V2.5/port/Input/OSD-BAO-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-AII-V2.5/port/Output/OSD-IID-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/CAE3/V1.0/AIMs/AudioInstanceIdentification.json> ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-cae/v1-0/> .

