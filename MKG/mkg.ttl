datatype:OSD-RPP-V1.5 a mkg:DataType ;
    mkg:acronym "OSD-RPP-V1.5" ;
    mkg:description "A rectangle (2D) given by 3 of its vertices not on a straight line, or a right parallelepiped (3D) given by 4 of its vertices not on a plane: a vertex, then the three vertices adjacent to it. From the first vertex, the second gives the parallelepiped's Right, the third its Front and the fourth its Up; its faces are named accordingly: Floor (through the first, second and third vertices) and Ceiling opposite; Back (through the first, second and fourth) and Front opposite; Left (through the first, third and fourth) and Right opposite." ;
    mkg:ofStandard standard:OSD ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/data/RightParallelepiped.json> ;
    mkg:title "Right Parallelepiped V1.5" ;
    mkg:uses datatype:OSD-SPT-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-osd/v1-5/data-types/right-parallelepiped/> .

