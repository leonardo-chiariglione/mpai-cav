aim:MAS-APP-V1.0 a mkg:AIM ;
    mkg:acronym "MAS-APP-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "MPAI as a Service App: the Module over which the MPAI-MAS workflow runs, letting a User Agent that has not yet chosen an App speak to the person through a Speaking Avatar. Response and Scene Rendering renders the Text the User Agent supplies into Machine Speech and Machine Face Descriptors; Automatic Speech Recognition gives as Text the person's spoken reply to a question the Module asked." ;
    mkg:flow <https://mpai.community/kg/aim/MAS-APP-V1.0/flow/1>,
        <https://mpai.community/kg/aim/MAS-APP-V1.0/flow/2>,
        <https://mpai.community/kg/aim/MAS-APP-V1.0/flow/3>,
        <https://mpai.community/kg/aim/MAS-APP-V1.0/flow/4>,
        <https://mpai.community/kg/aim/MAS-APP-V1.0/flow/5>,
        <https://mpai.community/kg/aim/MAS-APP-V1.0/flow/6>,
        <https://mpai.community/kg/aim/MAS-APP-V1.0/flow/7> ;
    mkg:ofStandard standard:MAS ;
    mkg:port <https://mpai.community/kg/aim/MAS-APP-V1.0/port/Input/MMC-EPS-V2.5/0>,
        <https://mpai.community/kg/aim/MAS-APP-V1.0/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/MAS-APP-V1.0/port/Input/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/MAS-APP-V1.0/port/Input/PAF-AVT-V1.6/0>,
        <https://mpai.community/kg/aim/MAS-APP-V1.0/port/Output/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/MAS-APP-V1.0/port/Output/XRV-SAV-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/MAS/V1.0/AIMs/MASApp.json> ;
    mkg:subAIM aim:MMC-ASR-V2.5,
        aim:PAF-RSR-V1.6 ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-mas/v1-0/> .

aim:MMC-MAC-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-MAC-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Multimodal Access Control: recognises a User from face and speech and issues a spoken/rendered verdict. Face Recognition and Speaker Recognition read the enrolled gallery (the User IDs) and the Scene Descriptors from Shared Storage - these are NOT ports. Time (OSD-STM) accompanies each captured object and is supplied by the User Agent's clock. ID Reconciliation reconciles the two candidate Instance Identifiers and issues the Response (the verdict words) and its Personal Status; Response and Scene Rendering speaks the Response and produces the lip-synced Machine Face Descriptors. The reconciled UserID stays internal; the User consumes the Response and the avatar. Acquisition and delivery are the User Agent, not sub-AIMs." ;
    mkg:flow <https://mpai.community/kg/aim/MMC-MAC-V2.5/flow/1>,
        <https://mpai.community/kg/aim/MMC-MAC-V2.5/flow/10>,
        <https://mpai.community/kg/aim/MMC-MAC-V2.5/flow/11>,
        <https://mpai.community/kg/aim/MMC-MAC-V2.5/flow/2>,
        <https://mpai.community/kg/aim/MMC-MAC-V2.5/flow/3>,
        <https://mpai.community/kg/aim/MMC-MAC-V2.5/flow/4>,
        <https://mpai.community/kg/aim/MMC-MAC-V2.5/flow/5>,
        <https://mpai.community/kg/aim/MMC-MAC-V2.5/flow/6>,
        <https://mpai.community/kg/aim/MMC-MAC-V2.5/flow/7>,
        <https://mpai.community/kg/aim/MMC-MAC-V2.5/flow/9> ;
    mkg:notAligned true ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-MAC-V2.5/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MAC-V2.5/port/Input/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MAC-V2.5/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MAC-V2.5/port/Input/PAF-AVT-V1.6/0>,
        <https://mpai.community/kg/aim/MMC-MAC-V2.5/port/Output/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MAC-V2.5/port/Output/XRV-SAV-V1.0/0>,
        <https://mpai.community/kg/aim/MMC-MAC-V2.5/port/Output/boolean/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/MultimodalAccessControl.json> ;
    mkg:subAIM aim:MMC-SIR-V2.5,
        aim:OSD-IDR-V1.5,
        aim:PAF-FIR-V1.6,
        aim:PAF-RSR-V1.6 ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/> .

aim:MMC-MPD-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-MPD-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Multimodal Personal Status-based Dialogue: speech-only affective dialogue. Automatic Speech Recognition recognises the speech; Natural Language Understanding produces the Text Descriptors, the (refined) NLU Text and the Text Personal Status; Personal Status Extraction reads the Speech Personal Status from the Speech Object and multiplexes it with the Text Personal Status into the entity's Personal Status; Entity Dialogue Processing produces the machine's response Text and Personal Status, aware of both the meaning and the feeling; Response and Scene Rendering renders the Speaking Avatar. The running Summary threads context across turns. Acquisition and delivery are the User Agent, not sub-AIMs." ;
    mkg:flow <https://mpai.community/kg/aim/MMC-MPD-V2.5/flow/1>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/flow/10>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/flow/11>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/flow/12>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/flow/13>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/flow/2>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/flow/3>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/flow/4>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/flow/5>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/flow/6>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/flow/7>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/flow/8> ;
    mkg:notAligned true ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-MPD-V2.5/port/Input/MMC-SUM-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/port/Input/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/port/Input/OSD-BTO-V1.5/2>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/port/Input/PAF-AVT-V1.6/0>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/port/Output/MMC-SUM-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/port/Output/XRV-SAV-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/MultimodalPersonalStatusDialogue.json> ;
    mkg:subAIM aim:MMC-ASR-V2.5,
        aim:MMC-EDP-V2.5,
        aim:MMC-NLU-V2.5,
        aim:MMC-PSE-V2.5,
        aim:PAF-RSR-V1.6 ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/> .

