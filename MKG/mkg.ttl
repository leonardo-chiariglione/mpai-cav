aim:CAE-AOD-V1.0 a mkg:AIM ;
    mkg:acronym "CAE-AOD-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "This AIM plays Audio Objects and Audio Scenes. A Basic Audio Object is played as it is, or, when it states a User Point of View, heard from there; an Audio Object is heard as a scene of its Basic Audio Objects; a Basic Audio Scene or an Audio Scene is rendered from its User Point of View, each member from its own if it has one, by spatial rendering - distance and air attenuation, the directional patterns of the Basic Audio Objects' Acoustic Profiles, binaural or onto a loudspeaker layout. What is played is also output, as a Basic Audio Object." ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-AOD-V1.0/port/Input/CAE-UCM-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-AOD-V1.0/port/Input/OSD-ASD-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-AOD-V1.0/port/Input/OSD-AUO-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-AOD-V1.0/port/Input/OSD-BAO-V1.5/0>,
