aim:HCI-IDR-V1.0 a mkg:AIM ;
    mkg:acronym "HCI-IDR-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "This AIM reconciles the Identifiers of an Entity produced by two recognition modalities. It receives a face Instance Identifier and a speaker Instance Identifier, fuses their ranked candidates by score-level fusion, and produces one reconciled Instance Identifier. Either input may be absent, in which case the reconciliation degrades to the modality present." ;
    mkg:ofStandard standard:HCI ;
    mkg:port <https://mpai.community/kg/aim/HCI-IDR-V1.0/port/Input/OSD-IID-V1.5/1>,
        <https://mpai.community/kg/aim/HCI-IDR-V1.0/port/Input/OSD-IID-V1.5/2>,
        <https://mpai.community/kg/aim/HCI-IDR-V1.0/port/Output/OSD-IID-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/HCI/V1.0/AIMs/IDReconciliation.json> ;
    mkg:sourceAI true ;
    mkg:title "ID Reconciliation V1.0" ;
    mkg:webSpec <https://mpai.community/standards/mpai-hci/> .

<https://mpai.community/kg/aim/HCI-IDR-V1.0/port/Input/OSD-IID-V1.5/1> a mkg:Port ;
    mkg:dataType datatype:OSD-IID-V1.5 ;
    mkg:direction "Input" ;
    mkg:label "FaceID" ;
    mkg:optional false ;
