aim:CAE-ASM-V1.0 a mkg:AIM ;
    mkg:acronym "CAE-ASM-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-cav/blob/main/AIMs/CAE3/V1.0/ASM/AsmProvider.cs> ;
    mkg:codePath "AIMs/CAE3/V1.0/ASM/AsmProvider.cs" ;
    mkg:description "Audio Scene Management, as the author's Reference Model draws it (2026/10/04): an audio chain - Audio Object Editing, then Audio Scene Editing - and a speech chain - Speech Object Editing, then Speech Scene Editing - whose Scenes Basic Multimodal Scene Editing (OSD-BME) composes into a Basic Multimodal Scene; each AIM with its own User Command, each returning the User Command with its report half (how each action was executed). Every edit is a new version in the Module's Shared Storage, from which Objects and Scenes are opened by their identifiers. Speech Object Editing has a Basic Speech Object translated by Text and Speech Translation (MMC-TST); the translation replaces the original, under its identifier, so every Speech Scene holding it holds the translation, at its place. Capture, reading the User's stored Objects, and hearing the Objects and Scenes - Audio and Speech Object Delivery - are the User Agent's, through the Units of its Physical Layer." ;
    mkg:flow <https://mpai.community/kg/aim/CAE-ASM-V1.0/flow/1>,
        <https://mpai.community/kg/aim/CAE-ASM-V1.0/flow/10>,
        <https://mpai.community/kg/aim/CAE-ASM-V1.0/flow/11>,
        <https://mpai.community/kg/aim/CAE-ASM-V1.0/flow/12>,
