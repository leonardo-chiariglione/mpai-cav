        <https://mpai.community/kg/aim/UAG-AOD-V1.0/port/Input/OSD-BAS-V1.5/0>,
        <https://mpai.community/kg/aim/UAG-AOD-V1.0/port/Output/OSD-AUO-V1.5/0>,
        <https://mpai.community/kg/aim/UAG-AOD-V1.0/port/Output/OSD-BAO-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/UAG/V1.0/AIMs/AudioObjectDelivery.json> ;
    mkg:sourceAI true ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-cae/> .

