aim:MMC-GSD-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-GSD-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Generative Speech Description: produces the Machine Speech Descriptors from the Text and, optionally, a Speech Personal Status for expression; the Descriptors drive the synthesis of the Machine Speech; when the Speech Personal Status is absent the speech is neutral." ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-GSD-V2.5/port/Input/MMC-SPS-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-GSD-V2.5/port/Input/OSD-BTO-V1.5/0>,
