    mkg:schema <https://schemas.mpai.community/PAF/V1.6/AIMs/ServiceParticipantAuthentication.json> ;
    mkg:title "Service Participant Authentication V1.6" ;
    mkg:webPage <https://mpai.community/standards/mpai-paf/v1-6/ai-modules/service-participant-authentication/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-paf/v1-6/> .

