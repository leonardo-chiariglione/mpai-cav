aim:CAV-AUS-V2.0 a mkg:AIM ;
    mkg:acronym "CAV-AUS-V2.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Audio Sensors: the set of Audio sensors of the CAV. Each sensor is served by an instance of the Audio Object Acquisition AIM, which receives what the sensor captures of the Audio Field and provides it as a Basic Audio Object: time-stamped on the CAV's time base, its Qualifier stating the sensor, its intrinsic calibration and its mounting pose on the CAV. An Implementation instantiates the Acquisition AIM once per sensor; the Basic Audio Objects of all sensors leave on one Port, each identifying its sensor." ;
    mkg:flow <https://mpai.community/kg/aim/CAV-AUS-V2.0/flow/1>,
        <https://mpai.community/kg/aim/CAV-AUS-V2.0/flow/2> ;
    mkg:ofStandard standard:CAV ;
    mkg:port <https://mpai.community/kg/aim/CAV-AUS-V2.0/port/Input/OSD-BAO-V1.5/0>,
        <https://mpai.community/kg/aim/CAV-AUS-V2.0/port/Output/OSD-BAO-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/CAV2/V2.0/AIMs/AudioSensors.json> ;
    mkg:subAIM aim:CAE-AOA-V1.0 ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-cav/tec/v2-0/ai-modules/audio-sensors/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-cav/> .

