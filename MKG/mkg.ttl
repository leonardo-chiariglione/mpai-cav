datatype:OSD-CSP-V1.5 a mkg:DataType ;
    mkg:acronym "OSD-CSP-V1.5" ;
    mkg:description "A space enclosed by walls: its shape a Simple Location - a combination of Right Parallelepipeds - and the Material of its walls. The walls are the faces of the Right Parallelepipeds, named Floor, Ceiling, Front, Back, Left and Right as Right Parallelepiped names them; a face where two Right Parallelepipeds meet is an opening, not a wall. A wall not given its own Material has the DefaultMaterial. Part of a wall - a glass panel in a plaster wall, a door - is a Region of its face, a 2D Right Parallelepiped, with a Material of its own; a door left open is a Region of air (Absorption 0, Transmission 1)." ;
    mkg:ofStandard standard:OSD ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/data/ClosedSpace.json> ;
    mkg:title "Closed Space V1.5" ;
    mkg:uses datatype:OSD-MTR-V1.5,
        datatype:OSD-RPP-V1.5,
        datatype:OSD-SLC-V1.5,
        datatype:OSD-SPT-V1.5,
        datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 .

aim:CAE-ASI-V2.5 a mkg:AIM ;
    mkg:acronym "CAE-ASI-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-cav/blob/main/AIMs/CAE3/V1.0/ASI/CaeAsiAimProcessor.cs> ;
    mkg:codePath "AIMs/CAE3/V1.0/ASI/CaeAsiAimProcessor.cs" ;
    mkg:description "Audio Scene object Identification: classifies each audio object of the Basic Audio Scene with YAMNet and requalifies it - a speech object becomes a Basic Speech Object (OSD-BSO) for Speaker Recognition/ASR/Personal Status; other sound stays a Basic Audio Object (OSD-BAO) for Audio Instance Identification." ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-ASI-V2.5/port/Input/OSD-BAS-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-ASI-V2.5/port/Output/OSD-BAO-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-ASI-V2.5/port/Output/OSD-BSO-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/CAE3/V1.0/AIMs/AudioSceneObjectIdentification.json> ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-cae/v1-0/> .

aim:MMC-PMX-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-PMX-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-cav/blob/main/AIMs/MMC/V2.5/PMX/PmxAimProcessor.cs> ;
    mkg:codePath "AIMs/MMC/V2.5/PMX/PmxAimProcessor.cs" ;
    mkg:description "This AIM assembles the per-modality Personal Statuses - Text, Speech, Face, and Body - into a single Entity Personal Status. It combines; it does not compute. Each modality input is optional, but at least one shall be present; the Entity Personal Status carries whichever modalities are supplied." ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-PMX-V2.5/port/Input/MMC-BPS-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-PMX-V2.5/port/Input/MMC-FPS-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-PMX-V2.5/port/Input/MMC-SPS-V2.5/0>,
