aim:UAG-ASD-V1.0 a mkg:AIM ;
    mkg:acronym "UAG-ASD-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "This AIM renders an Audio Scene to a destination - headphones, loudspeakers, a dome. The Scene Port accepts Basic Audio Scene Descriptors or full ones. Its output Port is Hardware and its consumer is the LISTENER, who may not be the person editing: the Audio Scene Descriptors reach the User Agent from CAE-ASE directly, without crossing this AIM, because they are data returning to a control loop while this is a rendering leaving the system for a human ear." ;
    mkg:ofStandard standard:UAG ;
    mkg:port <https://mpai.community/kg/aim/UAG-ASD-V1.0/port/Input/CAE-UCM-V1.0/0>,
        <https://mpai.community/kg/aim/UAG-ASD-V1.0/port/Input/OSD-ASD-V1.5/0>,
