aim:PAF-VMS-V1.6 a mkg:AIM ;
    mkg:acronym "PAF-VMS-V1.6" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Virtual Meeting Secretary: from the Portable Avatars of the participants it recognises and understands what they say, extracts their Personal Status, creates and edits the Summary of the meeting, and produces its own Portable Avatar - the VMS Portable Avatar - which speaks the text the secretary produces with its Personal Status. The Summary is also an output." ;
    mkg:flow <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/1>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/10>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/11>,
