    mkg:schema <https://schemas.mpai.community/PAF/V1.6/AIMs/VirtualMeetingSecretary.json> ;
    mkg:subAIM aim:MMC-ASR-V2.5,
        aim:MMC-EDP-V2.5,
        aim:MMC-NLU-V2.5,
        aim:MMC-PSE-V2.5,
        aim:MMC-SCM-V2.5,
        aim:PAF-PDX-V1.6,
        aim:PAF-PSD-V1.6 ;
    mkg:title "Virtual Meeting Secretary V1.6" ;
    mkg:webPage <https://mpai.community/standards/mpai-paf/v1-6/ai-modules/virtual-meeting-secretary/> ;
