aim:MMC-GTD-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-GTD-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Generative Text Description: produces the Machine Text Descriptors from the Text - the subject of what the machine is to say - and, optionally, a Text Personal Status for expression; when the Text Personal Status is absent the text is neutral." ;
