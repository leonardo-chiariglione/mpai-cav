aim:OSD-BVS-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-BVS-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-cav/blob/main/AIMs/OSD/V1.5/BVS/BvsAimProcessor.cs> ;
    mkg:codePath "AIMs/OSD/V1.5/BVS/BvsAimProcessor.cs" ;
    mkg:description "Basic Visual Scene Description: describes the acquired BasicVisualObject as BasicVisualSceneDescriptors. It raises an Alert when what it describes warrants one, without waiting for integration. Two of its inputs are optional, so that the same AIM serves applications that have something to connect to them and applications that do not: an application holding an ego Spatial Attitude receives descriptors already expressed in that frame, and one that maintains a running environment description returns it as a prior. Both are wired in EnvironmentSensingSubsystem.json and neither is wired in MMC-HCI." ;
    mkg:ofStandard standard:OSD ;
    mkg:port <https://mpai.community/kg/aim/OSD-BVS-V1.5/port/Input/CAV-BED-V2.0/0>,
        <https://mpai.community/kg/aim/OSD-BVS-V1.5/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BVS-V1.5/port/Input/OSD-OSA-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BVS-V1.5/port/Output/CAV-ALT-V2.0/0>,
        <https://mpai.community/kg/aim/OSD-BVS-V1.5/port/Output/OSD-BVS-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/AIMs/BasicVisualSceneDescription.json> ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-osd/v1-5/ai-modules/basic-visual-scene-description/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-osd/v1-5/> .

