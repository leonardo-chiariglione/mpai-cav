        <https://mpai.community/kg/aim/MMC-SCM-V2.5/port/Input/MMC-TDO-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-SCM-V2.5/port/Input/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-SCM-V2.5/port/Input/OSD-IID-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-SCM-V2.5/port/Input/OSD-SPT-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-SCM-V2.5/port/Output/MMC-SUM-V2.5/0> ;
