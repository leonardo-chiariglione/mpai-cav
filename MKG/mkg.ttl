        <https://mpai.community/kg/aim/MMC-PMX-V2.5/port/Output/MMC-EPS-V2.5/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/PersonalStatusMultiplexing.json> ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-mmc/v2-5/ai-modules/personal-status-multiplexing/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/> .

aim:MMC-SCM-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-SCM-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Summary Creation Module: produces a Summary from the Refined Text and the Meaning of what an entity says, using the Entity ID, the Personal Status and the Edited Summary, and optionally the Space-Time." ;
