aim:OSD-BAS-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-BAS-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-cav/blob/main/AIMs/OSD/V1.5/BAS/BasAimProcessor.cs> ;
    mkg:codePath "AIMs/OSD/V1.5/BAS/BasAimProcessor.cs" ;
    mkg:description "Basic Audio Scene Description: describes the acquired BasicAudioObject as BasicAudioSceneDescriptors. It raises an Alert when what it describes warrants one, without waiting for integration. Two of its inputs are optional, so that the same AIM serves applications that have something to connect to them and applications that do not: an application holding an ego Spatial Attitude receives descriptors already expressed in that frame, and one that maintains a running environment description returns it as a prior. Both are wired in EnvironmentSensingSubsystem.json and neither is wired in MMC-HCI." ;
    mkg:ofStandard standard:OSD ;
    mkg:port <https://mpai.community/kg/aim/OSD-BAS-V1.5/port/Input/CAV-BED-V2.0/0>,
        <https://mpai.community/kg/aim/OSD-BAS-V1.5/port/Input/OSD-BAO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BAS-V1.5/port/Input/OSD-OSA-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BAS-V1.5/port/Output/CAV-ALT-V2.0/0>,
        <https://mpai.community/kg/aim/OSD-BAS-V1.5/port/Output/OSD-BAS-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/AIMs/BasicAudioSceneDescription.json> ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-osd/v1-5/ai-modules/basic-audio-scene-description/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-osd/v1-5/> .

aim:OSD-BLS-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-BLS-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-cav/blob/main/AIMs/OSD/V1.5/BLS/BlsAimProcessor.cs> ;
    mkg:codePath "AIMs/OSD/V1.5/BLS/BlsAimProcessor.cs" ;
    mkg:description "Basic LiDAR Scene Description: describes the acquired BasicLiDARObject as BasicLiDARSceneDescriptors. It raises an Alert when what it describes warrants one, without waiting for integration. Two of its inputs are optional, so that the same AIM serves applications that have something to connect to them and applications that do not: an application holding an ego Spatial Attitude receives descriptors already expressed in that frame, and one that maintains a running environment description returns it as a prior. Both are wired in EnvironmentSensingSubsystem.json and neither is wired in MMC-HCI." ;
    mkg:ofStandard standard:OSD ;
    mkg:port <https://mpai.community/kg/aim/OSD-BLS-V1.5/port/Input/CAV-BED-V2.0/0>,
        <https://mpai.community/kg/aim/OSD-BLS-V1.5/port/Input/OSD-BLO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BLS-V1.5/port/Input/OSD-OSA-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BLS-V1.5/port/Output/CAV-ALT-V2.0/0>,
        <https://mpai.community/kg/aim/OSD-BLS-V1.5/port/Output/OSD-BLS-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/AIMs/BasicLiDARSceneDescription.json> ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-osd/v1-5/> .

aim:OSD-BME-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-BME-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-cav/blob/main/AIMs/OSD/V1.5/BME/BmeAimProcessor.cs> ;
    mkg:codePath "AIMs/OSD/V1.5/BME/BmeAimProcessor.cs" ;
    mkg:description "Basic Multimodal Scene Editing: Basic Scenes and Basic Objects of at least two media - Audio, Visual, Speech, LiDAR, 3D Model, RADAR, Ultrasound, Offline Map - composed into a Basic Multimodal Scene (a voice over music is a BMS of a BAS and a BSS, or of a BAO and a BSO). Each of its two Scene Ports takes a Basic Scene of any medium, and each of its two Object Ports a Basic Object of any medium, kept as it arrives. One Basic Multimodal Scene is open at a time: the User Command places the Scenes and Objects, named by their identifiers, in its common frame (AddedObjects), moves them, changes where they are, takes them out and sets where the Multimodal Scene is heard and seen from (UserPoV, also on its own Port). The Scenes and Objects being edited are followed: a member that is the version last arrived on its Port is replaced by the new version. Every edit is a new version in Shared Storage. Outputs: the open Basic Multimodal Scene - when its members are of at least two media - and the User Command, with its report half (UserCommandReport) saying how each action was executed." ;
    mkg:ofStandard standard:OSD ;
    mkg:port <https://mpai.community/kg/aim/OSD-BME-V1.5/port/Input/CAE-UCM-V1.0/0>,
        <https://mpai.community/kg/aim/OSD-BME-V1.5/port/Input/OSD-B3O-V1.5/1>,
