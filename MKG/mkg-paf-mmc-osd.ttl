aim:PAF-CRX-V1.6 a mkg:AIM ;
    mkg:acronym "PAF-CRX-V1.6" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Videoconference Client Receiver: from the Portable Avatar it receives from the server and the Point of View of the participant, it creates the Visual Scene of the avatars, merges it with their speech into the Audio-Visual Scene, passing the Avatars and their Personal Statuses on, renders the Speaking Avatar and passes the Basic Multimodal Scene through, which the User Agent delivers; the Output Text is the text of the Portable Avatar." ;
    mkg:flow <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/1>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/10>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/11>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/12>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/13>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/14>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/15>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/16>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/17>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/18>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/19>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/2>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/3>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/4>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/5>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/6>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/7>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/8>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/flow/9> ;
    mkg:ofStandard std:PAF ;
    mkg:port <https://mpai.community/kg/aim/PAF-CRX-V1.6/port/Input/OSD-OPV-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/port/Input/PAF-PAV-V1.6/0>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/port/Output/OSD-BMS-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/port/Output/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-CRX-V1.6/port/Output/XRV-SAV-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/PAF/V1.6/AIMs/VideoconferenceClientReceiver.json> ;
    mkg:subAIM aim:PAF-AVC-V1.6,
        aim:PAF-PDX-V1.6,
        aim:PAF-RSR-V1.6,
        aim:PAF-VSC-V1.6 ;
    mkg:title "Videoconference Client Receiver V1.6" ;
    mkg:webSpec <https://mpai.community/standards/mpai-paf/v1-6/> .

