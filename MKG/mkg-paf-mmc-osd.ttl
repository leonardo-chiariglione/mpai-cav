        <https://mpai.community/kg/aim/MMC-TST-V2.5/port/Output/OSD-SPO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-TST-V2.5/port/Output/OSD-TXO-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/TextAndSpeechTranslation.json> ;
    mkg:subAIM aim:MMC-ASR-V2.5,
        aim:MMC-TTS-V2.5,
        aim:MMC-TTT-V2.5 ;
    mkg:title "Text and Speech Translation V2.5" ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/ai-modules/text-and-speech-translation/> .

