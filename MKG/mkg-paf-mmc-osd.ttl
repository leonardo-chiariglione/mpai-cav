aim:PAF-SAF-V1.6 a mkg:AIM ;
    mkg:acronym "PAF-SAF-V1.6" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Speaking Avatar Formation: forms the Speaking Avatar of the input Avatar - its Model animated as it utters the Speech. Generative Face Description and Generative Body Description make the Face and Body Descriptors from the Speech and the Text, expressive when a Face or Body Personal Status is supplied; Speaking Avatar Synthesis packages the Avatar, the Speech and the Descriptors, time-aligned and ready to play." ;
    mkg:notAligned true ;
    mkg:ofStandard std:PAF ;
    mkg:port <https://mpai.community/kg/aim/PAF-SAF-V1.6/port/Input/MMC-BPS-V2.5/0>,
        <https://mpai.community/kg/aim/PAF-SAF-V1.6/port/Input/MMC-FPS-V2.5/0>,
        <https://mpai.community/kg/aim/PAF-SAF-V1.6/port/Input/OSD-BSO-V1.5/1>,
        <https://mpai.community/kg/aim/PAF-SAF-V1.6/port/Input/OSD-BSO-V1.5/2>,
        <https://mpai.community/kg/aim/PAF-SAF-V1.6/port/Input/OSD-BSO-V1.5/3>,
        <https://mpai.community/kg/aim/PAF-SAF-V1.6/port/Input/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/PAF-SAF-V1.6/port/Input/OSD-BTO-V1.5/2>,
        <https://mpai.community/kg/aim/PAF-SAF-V1.6/port/Input/OSD-SPO-V1.5/1>,
        <https://mpai.community/kg/aim/PAF-SAF-V1.6/port/Input/OSD-SPO-V1.5/2>,
        <https://mpai.community/kg/aim/PAF-SAF-V1.6/port/Input/OSD-SPO-V1.5/3>,
        <https://mpai.community/kg/aim/PAF-SAF-V1.6/port/Input/OSD-TXO-V1.5/1>,
        <https://mpai.community/kg/aim/PAF-SAF-V1.6/port/Input/OSD-TXO-V1.5/2>,
        <https://mpai.community/kg/aim/PAF-SAF-V1.6/port/Input/PAF-AVT-V1.6/0>,
        <https://mpai.community/kg/aim/PAF-SAF-V1.6/port/Output/XRV-SAV-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/PAF/V1.6/AIMs/SpeakingAvatarFormation.json> ;
    mkg:subAIM aim:PAF-GBD-V1.6,
        aim:PAF-GFD-V1.6,
        aim:PAF-SAS-V1.6 ;
    mkg:title "Speaking Avatar Formation V1.6" ;
    mkg:webSpec <https://mpai.community/standards/mpai-paf/v1-6/> .

aim:PAF-SAS-V1.6 a mkg:AIM ;
    mkg:acronym "PAF-SAS-V1.6" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Speaking Avatar Synthesis: makes a Speaking Avatar of the input Avatar - its 3D Model animated by the Face Descriptors and the Body Descriptors, uttering the Speech. The Speaking Avatar is ready to play: the Avatar it holds carries the Model, the Speech and the Face and Body Descriptors, time-aligned. The Avatar is kept: given once - when the Module starts, or when the User Agent changes avatar - it is used for every utterance until another arrives." ;
    mkg:ofStandard std:PAF ;
    mkg:port <https://mpai.community/kg/aim/PAF-SAS-V1.6/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-SAS-V1.6/port/Input/OSD-SPO-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-SAS-V1.6/port/Input/PAF-AVT-V1.6/0>,
        <https://mpai.community/kg/aim/PAF-SAS-V1.6/port/Input/PAF-BDO-V1.6/0>,
        <https://mpai.community/kg/aim/PAF-SAS-V1.6/port/Input/PAF-FDO-V1.6/0>,
        <https://mpai.community/kg/aim/PAF-SAS-V1.6/port/Output/XRV-SAV-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/PAF/V1.6/AIMs/SpeakingAvatarSynthesis.json> ;
    mkg:title "Speaking Avatar Synthesis V1.6" ;
    mkg:webSpec <https://mpai.community/standards/mpai-paf/v1-6/> .

