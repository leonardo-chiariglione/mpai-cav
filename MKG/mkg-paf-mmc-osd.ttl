aim:MMC-TST-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-TST-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Text and Speech Translation. Accepts a Speech Object or a Text Object, translates into the language named by the Language Selector, and produces the translated Text Object and Speech Object. Acquisition and delivery are NOT SubAIMs of this Composite AIM: they interact with the user directly, and therefore belong to the User Agent, travelling with it when the User Agent becomes a Remote Client Application. Speech Object Acquisition and Speech Object Delivery remain AIMs in their own right where they capture from or deliver to a source outside the AIF." ;
    mkg:notAligned true ;
    mkg:ofStandard std:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-TST-V2.5/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-TST-V2.5/port/Input/OSD-BTO-V1.5/0>,
