        <https://mpai.community/kg/aim/OSD-BME-V1.5/port/Input/OSD-BUS-V1.5/1>,
        <https://mpai.community/kg/aim/OSD-BME-V1.5/port/Input/OSD-BUS-V1.5/2>,
        <https://mpai.community/kg/aim/OSD-BME-V1.5/port/Input/OSD-BVO-V1.5/1>,
        <https://mpai.community/kg/aim/OSD-BME-V1.5/port/Input/OSD-BVO-V1.5/2>,
        <https://mpai.community/kg/aim/OSD-BME-V1.5/port/Input/OSD-BVS-V1.5/1>,
