    mkg:acronym "PAF-FIR-V1.6" ;
    mkg:apiProfile "Basic" ;
    mkg:description "This AIM implements the face recognition function: it identifies a face based on the Visual Object that contains it. It is the visual counterpart of Speaker Identity Recognition." ;
