        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/8>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/9> ;
    mkg:ofStandard std:PAF ;
    mkg:port <https://mpai.community/kg/aim/PAF-AVS-V1.6/port/Input/MMC-SUM-V2.5/0>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/port/Input/OSD-BMS-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/port/Input/OSD-BSO-V1.5/0>,
