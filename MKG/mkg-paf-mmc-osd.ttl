aim:MMC-SIR-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-SIR-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "This AIM implements the speaker recognition function: it identifies a speaker based on the Speech Object that contains their speech. It is the audio counterpart of Face Identity Recognition." ;
    mkg:ofStandard std:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-SIR-V2.5/port/Input/MMC-SOL-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-SIR-V2.5/port/Input/OSD-BAS-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-SIR-V2.5/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-SIR-V2.5/port/Input/OSD-SPO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-SIR-V2.5/port/Input/OSD-SSG-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-SIR-V2.5/port/Input/OSD-TXO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-SIR-V2.5/port/Output/OSD-IID-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/SpeakerIdentityRecognition.json> ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/> .

aim:OSD-IDR-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-IDR-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Identity Reconciliation: reconciles the Face ID and the Speaker ID into a single User ID, and issues the machine's Response (the words to say) together with the Personal Status the machine should display - serious while testing, welcoming when the user is recognised, reproaching when not." ;
    mkg:ofStandard std:OSD ;
    mkg:port <https://mpai.community/kg/aim/OSD-IDR-V1.5/port/Input/OSD-IID-V1.5/1>,
        <https://mpai.community/kg/aim/OSD-IDR-V1.5/port/Input/OSD-IID-V1.5/2>,
        <https://mpai.community/kg/aim/OSD-IDR-V1.5/port/Output/MMC-EPS-V2.5/0>,
        <https://mpai.community/kg/aim/OSD-IDR-V1.5/port/Output/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-IDR-V1.5/port/Output/OSD-IID-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-IDR-V1.5/port/Output/boolean/0> ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/AIMs/IDReconciliation.json> ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-osd/v1-5/> .

