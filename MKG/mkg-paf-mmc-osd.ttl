        <https://mpai.community/kg/aim/OSD-BME-V1.5/port/Input/OSD-OPV-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BME-V1.5/port/Output/CAE-UCM-V1.0/0>,
        <https://mpai.community/kg/aim/OSD-BME-V1.5/port/Output/OSD-BMS-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/AIMs/BasicMultimodalSceneEditing.json> ;
    mkg:title "Basic Multimodal Scene Editing V1.5" ;
    mkg:webSpec <https://mpai.community/standards/mpai-osd/> .

aim:OSD-BOS-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-BOS-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Basic Offline Map Scene Description: describes the acquired BasicOfflineMapObject as BasicOfflineMapSceneDescriptors. Two of its inputs are optional, so that the same AIM serves applications that have something to connect to them and applications that do not: an application holding an ego Spatial Attitude receives descriptors already expressed in that frame, and one that maintains a running environment description returns it as a prior. Both are wired in EnvironmentSensingSubsystem.json and neither is wired in MMC-HCI. It neither raises an Alert nor takes a prior: EnvironmentSensingSubsystem.json wires neither to the offline map, a stored map having nothing to react to and nothing to gain from the previous cycle." ;
    mkg:ofStandard std:OSD ;
    mkg:port <https://mpai.community/kg/aim/OSD-BOS-V1.5/port/Input/OSD-BOO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BOS-V1.5/port/Input/OSD-OSA-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BOS-V1.5/port/Output/OSD-BOS-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/AIMs/BasicOfflineMapSceneDescription.json> ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-osd/v1-5/> .

aim:OSD-BRS-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-BRS-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Basic RADAR Scene Description: describes the acquired BasicRADARObject as BasicRADARSceneDescriptors. It raises an Alert when what it describes warrants one, without waiting for integration. Two of its inputs are optional, so that the same AIM serves applications that have something to connect to them and applications that do not: an application holding an ego Spatial Attitude receives descriptors already expressed in that frame, and one that maintains a running environment description returns it as a prior. Both are wired in EnvironmentSensingSubsystem.json and neither is wired in MMC-HCI." ;
    mkg:ofStandard std:OSD ;
    mkg:port <https://mpai.community/kg/aim/OSD-BRS-V1.5/port/Input/CAV-BED-V2.0/0>,
        <https://mpai.community/kg/aim/OSD-BRS-V1.5/port/Input/OSD-BRO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BRS-V1.5/port/Input/OSD-OSA-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BRS-V1.5/port/Output/CAV-ALT-V2.0/0>,
        <https://mpai.community/kg/aim/OSD-BRS-V1.5/port/Output/OSD-BRS-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/AIMs/BasicRADARSceneDescription.json> ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-osd/v1-5/> .

aim:OSD-BUS-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-BUS-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Basic Ultrasound Scene Description: describes the acquired BasicUltrasoundObject as BasicUltrasoundSceneDescriptors. It raises an Alert when what it describes warrants one, without waiting for integration. Two of its inputs are optional, so that the same AIM serves applications that have something to connect to them and applications that do not: an application holding an ego Spatial Attitude receives descriptors already expressed in that frame, and one that maintains a running environment description returns it as a prior. Both are wired in EnvironmentSensingSubsystem.json and neither is wired in MMC-HCI." ;
    mkg:ofStandard std:OSD ;
    mkg:port <https://mpai.community/kg/aim/OSD-BUS-V1.5/port/Input/CAV-BED-V2.0/0>,
        <https://mpai.community/kg/aim/OSD-BUS-V1.5/port/Input/OSD-BUO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BUS-V1.5/port/Input/OSD-OSA-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BUS-V1.5/port/Output/CAV-ALT-V2.0/0>,
        <https://mpai.community/kg/aim/OSD-BUS-V1.5/port/Output/OSD-BUS-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/AIMs/BasicUltrasoundSceneDescription.json> ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-osd/v1-5/> .

aim:OSD-UID-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-UID-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "User Identification: identifies a user from their face and their speech and reconciles the two into one answer. Speaker Identity Recognition matches the speech, Face Identity Recognition matches the face, and Identity Reconciliation combines the two identities. Identification states whether the face and the speech match somebody known; User ID states who." ;
    mkg:notAligned true ;
    mkg:ofStandard std:OSD ;
    mkg:port <https://mpai.community/kg/aim/OSD-UID-V1.5/port/Input/OSD-BAS-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-UID-V1.5/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-UID-V1.5/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-UID-V1.5/port/Input/OSD-BVS-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-UID-V1.5/port/Output/OSD-IID-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-UID-V1.5/port/Output/boolean/0> ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/AIMs/UserIdentification.json> ;
    mkg:subAIM aim:MMC-SIR-V2.5,
        aim:OSD-IDR-V1.5,
        aim:PAF-FIR-V1.6 ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-osd/v1-5/> .

aim:PAF-EBD-V1.6 a mkg:AIM ;
    mkg:acronym "PAF-EBD-V1.6" ;
    mkg:apiProfile "Basic" ;
    mkg:description "This AIM receives a Body Object and produces its Body Descriptors Object: a 3D body pose/mocap representation (joints and posture of a human or humanoid body) expressing the body's semantics for Personal Status use." ;
    mkg:ofStandard std:PAF ;
    mkg:port <https://mpai.community/kg/aim/PAF-EBD-V1.6/port/Input/OSD-VIO-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-EBD-V1.6/port/Output/PAF-BDO-V1.6/0> ;
    mkg:schema <https://schemas.mpai.community/PAF/V1.6/AIMs/EntityBodyDescription.json> ;
    mkg:title "Entity Body Description V1.6" ;
    mkg:webSpec <https://mpai.community/standards/mpai-paf/v1-6/> .

aim:PAF-PBI-V1.6 a mkg:AIM ;
    mkg:acronym "PAF-PBI-V1.6" ;
    mkg:apiProfile "Basic" ;
    mkg:description "This AIM extracts the Body Personal Status from the Body Descriptors Object: the one supplied from outside (Port 1) and the one derived by the Entity Body Description (Port 2)." ;
    mkg:ofStandard std:PAF ;
    mkg:port <https://mpai.community/kg/aim/PAF-PBI-V1.6/port/Input/PAF-BDO-V1.6/1>,
        <https://mpai.community/kg/aim/PAF-PBI-V1.6/port/Input/PAF-BDO-V1.6/2>,
        <https://mpai.community/kg/aim/PAF-PBI-V1.6/port/Output/MMC-BPS-V2.5/0> ;
    mkg:schema <https://schemas.mpai.community/PAF/V1.6/AIMs/PSBodyInterpretation.json> ;
    mkg:title "PS-Body Interpretation V1.6" ;
    mkg:webSpec <https://mpai.community/standards/mpai-paf/v1-6/> .

aim:PAF-SAR-V1.6 a mkg:AIM ;
    mkg:acronym "PAF-SAR-V1.6" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Scene and Avatar Rendering: places a Speaking Avatar - at the Avatar PoV the requester gives - in a Basic Multimodal Scene seen and heard from the Point of View, and produces the Scene as data: either a Basic Audio Scene (the avatar's speech among the scene's audio) and a Basic Visual Scene (what is seen, as 2D Visual Objects), or the Basic Multimodal Scene and the 3D Model Scene with the avatar placed, which a 3D Model Object Delivery draws. It produces data; it does not play or draw." ;
    mkg:ofStandard std:PAF ;
    mkg:port <https://mpai.community/kg/aim/PAF-SAR-V1.6/port/Input/OSD-BMS-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-SAR-V1.6/port/Input/OSD-MSD-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-SAR-V1.6/port/Input/OSD-OPV-V1.5/1>,
        <https://mpai.community/kg/aim/PAF-SAR-V1.6/port/Input/OSD-OPV-V1.5/2>,
        <https://mpai.community/kg/aim/PAF-SAR-V1.6/port/Input/XRV-SAV-V1.0/0>,
        <https://mpai.community/kg/aim/PAF-SAR-V1.6/port/Output/OSD-3SD-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-SAR-V1.6/port/Output/OSD-B3S-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-SAR-V1.6/port/Output/OSD-BAS-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-SAR-V1.6/port/Output/OSD-BMS-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-SAR-V1.6/port/Output/OSD-BVS-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/PAF/V1.6/AIMs/SceneAndAvatarRendering.json> ;
    mkg:title "Scene and Avatar Rendering V1.6" ;
    mkg:webSpec <https://mpai.community/standards/mpai-paf/v1-6/> .

