aim:OSD-BAS-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-BAS-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Basic Audio Scene Description: describes the acquired BasicAudioObject as BasicAudioSceneDescriptors. It raises an Alert when what it describes warrants one, without waiting for integration. Two of its inputs are optional, so that the same AIM serves applications that have something to connect to them and applications that do not: an application holding an ego Spatial Attitude receives descriptors already expressed in that frame, and one that maintains a running environment description returns it as a prior. Both are wired in EnvironmentSensingSubsystem.json and neither is wired in MMC-HCI." ;
    mkg:ofStandard std:OSD ;
    mkg:port <https://mpai.community/kg/aim/OSD-BAS-V1.5/port/Input/CAV-BED-V2.0/0>,
        <https://mpai.community/kg/aim/OSD-BAS-V1.5/port/Input/OSD-BAO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BAS-V1.5/port/Input/OSD-OSA-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BAS-V1.5/port/Output/CAV-ALT-V2.0/0>,
        <https://mpai.community/kg/aim/OSD-BAS-V1.5/port/Output/OSD-BAS-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/AIMs/BasicAudioSceneDescription.json> ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-osd/v1-5/> .

