    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/EntityTextDescription.json> ;
    mkg:title "EntityTextDescription V2.5" ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/> .

aim:MMC-HCI-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-HCI-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Human-CAV Interaction. The Audio, Visual and LiDAR Objects are described as Basic Audio, Visual and LiDAR Scenes and aligned (Audio-Visual Alignment). The objects of the aligned scenes are identified per modality: Audio and Visual Scene Object Identification separate speech and faces from other objects, which go to Speaker and Face Identity Recognition and to Audio and Visual Instance Identification respectively. The identities are reconciled (ID Reconciliation). The speech is recognised and understood (Automatic Speech Recognition, Natural Language Understanding), and the entity's Personal Status is extracted (Personal Status Extraction). Entity Dialogue Processing produces the machine's response aware of meaning, Personal Status, scene geometry and identity, and Response and Scene Rendering renders it as a Speaking Avatar. The reconciled User ID and the recognised text are provided at the boundary." ;
    mkg:notAligned true ;
    mkg:ofStandard std:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-HCI-V2.5/port/Input/CAV-AHM-V2.0/0>,
        <https://mpai.community/kg/aim/MMC-HCI-V2.5/port/Input/CAV-ERH-V2.0/0>,
        <https://mpai.community/kg/aim/MMC-HCI-V2.5/port/Input/OSD-BAO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-HCI-V2.5/port/Input/OSD-BLO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-HCI-V2.5/port/Input/OSD-BMS-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-HCI-V2.5/port/Input/OSD-BOO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-HCI-V2.5/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-HCI-V2.5/port/Input/OSD-OPV-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-HCI-V2.5/port/Input/PAF-AVT-V1.6/0>,
        <https://mpai.community/kg/aim/MMC-HCI-V2.5/port/Output/CAV-AHM-V2.0/0>,
        <https://mpai.community/kg/aim/MMC-HCI-V2.5/port/Output/CAV-ERH-V2.0/0>,
        <https://mpai.community/kg/aim/MMC-HCI-V2.5/port/Output/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-HCI-V2.5/port/Output/OSD-BTO-V1.5/2>,
        <https://mpai.community/kg/aim/MMC-HCI-V2.5/port/Output/OSD-IID-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-HCI-V2.5/port/Output/XRV-SAV-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/HumanCAVInteraction.json> ;
    mkg:subAIM aim:CAE-AII-V2.5,
        aim:CAE-ASI-V2.5,
        aim:CAE-QCV-V1.0,
        aim:CVE-VII-V1.0,
        aim:CVE-VSI-V1.0,
        aim:MMC-ASR-V2.5,
        aim:MMC-EDP-V2.5,
        aim:MMC-NLU-V2.5,
        aim:MMC-PSE-V2.5,
        aim:MMC-SIR-V2.5,
        aim:OSD-AVA-V1.5,
        aim:OSD-BAS-V1.5,
        aim:OSD-BLS-V1.5,
        aim:OSD-BVS-V1.5,
        aim:OSD-IDR-V1.5,
        aim:PAF-FIR-V1.6,
        aim:PAF-RSR-V1.6 ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/> .

aim:MMC-MAC-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-MAC-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Multimodal Access Control: recognises a User from face and speech and issues a spoken/rendered verdict. Face Recognition and Speaker Recognition read the enrolled gallery (the User IDs) and the Scene Descriptors from Shared Storage - these are NOT ports. Time (OSD-STM) accompanies each captured object and is supplied by the User Agent's clock. ID Reconciliation reconciles the two candidate Instance Identifiers and issues the Response (the verdict words) and its Personal Status; Response and Scene Rendering speaks the Response and produces the lip-synced Machine Face Descriptors. The reconciled UserID stays internal; the User consumes the Response and the avatar. Acquisition and delivery are the User Agent, not sub-AIMs." ;
    mkg:notAligned true ;
    mkg:ofStandard std:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-MAC-V2.5/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MAC-V2.5/port/Input/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MAC-V2.5/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MAC-V2.5/port/Input/PAF-AVT-V1.6/0>,
        <https://mpai.community/kg/aim/MMC-MAC-V2.5/port/Output/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MAC-V2.5/port/Output/XRV-SAV-V1.0/0>,
        <https://mpai.community/kg/aim/MMC-MAC-V2.5/port/Output/boolean/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/MultimodalAccessControl.json> ;
    mkg:subAIM aim:MMC-SIR-V2.5,
        aim:OSD-IDR-V1.5,
        aim:PAF-FIR-V1.6,
        aim:PAF-RSR-V1.6 ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/> .

aim:MMC-MAD-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-MAD-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Multimodal Anonymous Dialogue: the HCI Module for anonymous dialogue with a Speaking Avatar (no identity, no Identity Reconciliation). Automatic Speech Recognition recognises the human's speech into text; Entity Dialogue Processing produces the machine's response Text and Personal Status, using the running Summary as memory; Response and Scene Rendering renders that response into the Machine Speech and the lip-synced Machine Face Descriptors. The affective path (the machine's Personal Status) is wired but optional; a User Agent that does not exercise affect simply supplies none, and the avatar renders neutrally. A turn may be spoken (Speech Object) or typed (Text Object). Acquisition and delivery are the User Agent, not sub-AIMs." ;
    mkg:notAligned true ;
    mkg:ofStandard std:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-MAD-V2.5/port/Input/MMC-EPS-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-MAD-V2.5/port/Input/MMC-SUM-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-MAD-V2.5/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MAD-V2.5/port/Input/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-MAD-V2.5/port/Input/OSD-BTO-V1.5/2>,
        <https://mpai.community/kg/aim/MMC-MAD-V2.5/port/Input/OSD-TXO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-MAD-V2.5/port/Input/PAF-AVT-V1.6/0>,
        <https://mpai.community/kg/aim/MMC-MAD-V2.5/port/Output/MMC-SUM-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-MAD-V2.5/port/Output/XRV-SAV-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/MultimodalAnonymousDialogue.json> ;
    mkg:subAIM aim:MMC-ASR-V2.5,
        aim:MMC-EDP-V2.5,
        aim:PAF-RSR-V1.6 ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/> .

aim:MMC-MAT-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-MAT-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Multimodal Anonymous Translation: the HCI Module for spoken translation with a Speaking Avatar. Automatic Speech Recognition recognises the human's speech into text; Text-to-Text Translation translates it into the language named by the Language Selector; Response and Scene Rendering speaks the translation and produces the lip-synced Machine Face Descriptors in the target language. The translated text is also exposed. Non-affective; no Personal Status is supplied. Acquisition and delivery are the User Agent, not sub-AIMs." ;
    mkg:notAligned true ;
    mkg:ofStandard std:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-MAT-V2.5/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MAT-V2.5/port/Input/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-MAT-V2.5/port/Input/OSD-BTO-V1.5/2>,
        <https://mpai.community/kg/aim/MMC-MAT-V2.5/port/Input/OSD-SEL-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MAT-V2.5/port/Input/PAF-AVT-V1.6/0>,
        <https://mpai.community/kg/aim/MMC-MAT-V2.5/port/Output/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MAT-V2.5/port/Output/XRV-SAV-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/MultimodalAnonymousTranslation.json> ;
    mkg:subAIM aim:MMC-ASR-V2.5,
        aim:MMC-TTT-V2.5,
        aim:PAF-RSR-V1.6 ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/> .

aim:MMC-MPD-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-MPD-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Multimodal Personal Status-based Dialogue: speech-only affective dialogue. Automatic Speech Recognition recognises the speech; Natural Language Understanding produces the Text Descriptors, the (refined) NLU Text and the Text Personal Status; Personal Status Extraction reads the Speech Personal Status from the Speech Object and multiplexes it with the Text Personal Status into the entity's Personal Status; Entity Dialogue Processing produces the machine's response Text and Personal Status, aware of both the meaning and the feeling; Response and Scene Rendering renders the Speaking Avatar. The running Summary threads context across turns. Acquisition and delivery are the User Agent, not sub-AIMs." ;
    mkg:flow <https://mpai.community/kg/aim/MMC-MPD-V2.5/flow/6> ;
    mkg:notAligned true ;
    mkg:ofStandard std:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-MPD-V2.5/port/Input/MMC-SUM-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/port/Input/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/port/Input/OSD-BTO-V1.5/2>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/port/Input/PAF-AVT-V1.6/0>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/port/Output/MMC-SUM-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-MPD-V2.5/port/Output/XRV-SAV-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/MultimodalPersonalStatusDialogue.json> ;
    mkg:subAIM aim:MMC-ASR-V2.5,
        aim:MMC-EDP-V2.5,
        aim:MMC-NLU-V2.5,
        aim:MMC-PSE-V2.5,
        aim:PAF-RSR-V1.6 ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/> .

aim:MMC-OCR-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-OCR-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "This AIM receives the image of a page as a Basic Visual Object and produces a Text Object: the lines of text found on the page, in reading order, each a Basic Text Object with its box on the page and its confidence. The box of a line is the Space-Time of the line in the Text Object: SpatialAttitude1 is its top-left corner, SpatialAttitude2 its bottom-right corner, in the pixels of the image (X to the right, Y down). The confidence of a line is in its Data Exchange Metadata." ;
    mkg:ofStandard std:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-OCR-V2.5/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-OCR-V2.5/port/Output/OSD-TXO-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/OpticalCharacterRecognition.json> ;
    mkg:title "" .

aim:MMC-SPE-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-SPE-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "This composite AIM extracts the Personal Status conveyed by Speech." ;
    mkg:notAligned true ;
    mkg:ofStandard std:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-SPE-V2.5/port/Input/MMC-SDO-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-SPE-V2.5/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-SPE-V2.5/port/Input/OSD-SPO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-SPE-V2.5/port/Output/MMC-SPS-V2.5/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/SpeechPersonalStatusExtraction.json> ;
    mkg:subAIM aim:MMC-ESD-V2.5,
        aim:MMC-PSI-V2.5 ;
    mkg:title "Speech Personal Status Extraction Composite V2.5" ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/> .

aim:OSD-BME-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-BME-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Basic Multimodal Scene Editing: Basic Scenes and Basic Objects of at least two media - Audio, Visual, Speech, LiDAR, 3D Model, RADAR, Ultrasound, Offline Map - composed into a Basic Multimodal Scene (a voice over music is a BMS of a BAS and a BSS, or of a BAO and a BSO). Each of its two Scene Ports takes a Basic Scene of any medium, and each of its two Object Ports a Basic Object of any medium, kept as it arrives. One Basic Multimodal Scene is open at a time: the User Command places the Scenes and Objects, named by their identifiers, in its common frame (AddedObjects), moves them, changes where they are, takes them out and sets where the Multimodal Scene is heard and seen from (UserPoV, also on its own Port). The Scenes and Objects being edited are followed: a member that is the version last arrived on its Port is replaced by the new version. Every edit is a new version in Shared Storage. Outputs: the open Basic Multimodal Scene - when its members are of at least two media - and the User Command, with its report half (UserCommandReport) saying how each action was executed." ;
    mkg:ofStandard std:OSD ;
    mkg:port <https://mpai.community/kg/aim/OSD-BME-V1.5/port/Input/CAE-UCM-V1.0/0>,
        <https://mpai.community/kg/aim/OSD-BME-V1.5/port/Input/OSD-B3O-V1.5/1>,
        <https://mpai.community/kg/aim/OSD-BME-V1.5/port/Input/OSD-B3O-V1.5/2>,
