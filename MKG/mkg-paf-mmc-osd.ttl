aim:MMC-ACR-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-ACR-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "MMC Access Control Registration (ACR) Module. Enrols a User: from the captured Face Object and Speech Object it produces the Face Descriptors (Entity Face Description) and Speech Descriptors (Entity Speech Description), which the descriptor AIMs write to the Shared Storage gallery under the User Name - the same gallery MMC-MAC reads to recognise. Response and Scene Rendering speaks the confirmation. The User Name is the User Agent's own datum (typed). Acquisition and delivery are the User Agent, not sub-AIMs. Where a data type occurs more than once at the boundary it carries a Port Number (OSD-STM: FaceTime 1 / SpeechTime 2; OSD-BTO: Response 1 / UserName 2)." ;
    mkg:notAligned true ;
    mkg:ofStandard std:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-ACR-V2.5/port/Input/MMC-EPS-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-ACR-V2.5/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-ACR-V2.5/port/Input/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-ACR-V2.5/port/Input/OSD-BTO-V1.5/2>,
        <https://mpai.community/kg/aim/MMC-ACR-V2.5/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-ACR-V2.5/port/Input/PAF-AVT-V1.6/0>,
        <https://mpai.community/kg/aim/MMC-ACR-V2.5/port/Output/XRV-SAV-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/AccessControlRegistration.json> ;
    mkg:subAIM aim:MMC-ESD-V2.5,
        aim:PAF-EFD-V1.6,
        aim:PAF-RSR-V1.6 ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/> .

aim:MMC-AMQ-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-AMQ-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Answer to Multimodal Question. Receives a Visual Object and a question - as a Speech Object or a Text Object - and returns the answer as Text, as a Speaking Avatar - its speech, face and body, rendered by Response and Scene Rendering with the Avatar the User Agent supplies - and as a Visual Object. Acquisition, presentation and delivery are NOT SubAIMs: they interact with the user directly and therefore belong to the User Agent, travelling with it when it becomes a Remote Client Application. The User Agent shows the image and invites the question before this Module is run, so the image and the question arrive together and the run completes without suspending. Every boundary Port is exchanged with the User Agent." ;
    mkg:notAligned true ;
    mkg:ofStandard std:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-AMQ-V2.5/port/Input/OSD-BSO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-AMQ-V2.5/port/Input/OSD-BSO-V1.5/2>,
        <https://mpai.community/kg/aim/MMC-AMQ-V2.5/port/Input/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-AMQ-V2.5/port/Input/OSD-BTO-V1.5/2>,
        <https://mpai.community/kg/aim/MMC-AMQ-V2.5/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-AMQ-V2.5/port/Input/PAF-AVT-V1.6/0>,
        <https://mpai.community/kg/aim/MMC-AMQ-V2.5/port/Output/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-AMQ-V2.5/port/Output/OSD-BTO-V1.5/2>,
        <https://mpai.community/kg/aim/MMC-AMQ-V2.5/port/Output/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-AMQ-V2.5/port/Output/XRV-SAV-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/AnswerToMultimodalQuestion.json> ;
    mkg:subAIM aim:MMC-ASR-V2.5,
        aim:MMC-TIQ-V2.5,
        aim:PAF-RSR-V1.6 ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/use-cases/answer-to-multimodal-question/> .

aim:MMC-ETD-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-ETD-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "This AIM computes the Text Descriptors." ;
    mkg:ofStandard std:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-ETD-V2.5/port/Input/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-ETD-V2.5/port/Input/OSD-BTO-V1.5/2>,
