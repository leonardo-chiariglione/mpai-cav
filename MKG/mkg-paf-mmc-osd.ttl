aim:MMC-ESD-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-ESD-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "This AIM computes the Speech Descriptors of an Entity from its Speech Object." ;
    mkg:ofStandard std:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-ESD-V2.5/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-ESD-V2.5/port/Input/OSD-BTO-V1.5/0>,
