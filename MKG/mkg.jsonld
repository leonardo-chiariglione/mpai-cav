  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Basic Environment Description: fuses the Basic Scene Descriptors of every Environment Sensing Technology and of the Offline Map into the Basic Environment Descriptors - one list of Basic Environment Objects on the ego frame of reference, each with its identity kept from one instance to the next, its class, its Spatial Attitude with velocity and accuracy, its extent, its confidence and the descriptors it was fused from. Weather Data weighs each technology; the Full Environment Descriptors of the Autonomous Motion Subsystem, where given, bring what other CAVs perceive. Its output returns to the scene describers as their prior."
   }
  ],
