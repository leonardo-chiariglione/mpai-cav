   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "This AIM reconciles the Identifiers of an Entity produced by two recognition modalities. It receives a face Instance Identifier and a speaker Instance Identifier, fuses their ranked candidates by score-level fusion, and produces one reconciled Instance Identifier. Either input may be absent, in which case the reconciliation degrades to the modality present."
   }
  ],
