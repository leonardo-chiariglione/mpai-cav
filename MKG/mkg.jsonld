 {
  "@id": "https://mpai.community/kg/datatype/OSD-CSP-V1.5",
  "@type": [
   "https://mpai.community/kg/vocab#DataType"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "OSD-CSP-V1.5"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "A space enclosed by walls: its shape a Simple Location - a combination of Right Parallelepipeds - and the Material of its walls. The walls are the faces of the Right Parallelepipeds, named Floor, Ceiling, Front, Back, Left and Right as Right Parallelepiped names them; a face where two Right Parallelepipeds meet is an opening, not a wall. A wall not given its own Material has the DefaultMaterial. Part of a wall - a glass panel in a plaster wall, a door - is a Region of its face, a 2D Right Parallelepiped, with a Material of its own; a door left open is a Region of air (Absorption 0, Transmission 1)."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/OSD"
   }
  ],
