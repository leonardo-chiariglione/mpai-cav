 {
  "@id": "https://mpai.community/kg/datatype/OSD-RPP-V1.5",
  "@type": [
   "https://mpai.community/kg/vocab#DataType"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "OSD-RPP-V1.5"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "A rectangle (2D) given by 3 of its vertices not on a straight line, or a right parallelepiped (3D) given by 4 of its vertices not on a plane: a vertex, then the three vertices adjacent to it. From the first vertex, the second gives the parallelepiped's Right, the third its Front and the fourth its Up; its faces are named accordingly: Floor (through the first, second and third vertices) and Ceiling opposite; Back (through the first, second and fourth) and Front opposite; Left (through the first, third and fourth) and Right opposite."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/OSD"
   }
  ],
  "https://mpai.community/kg/vocab#schema": [
