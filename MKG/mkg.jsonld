   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Identity Reconciliation: reconciles the Face ID and the Speaker ID into a single User ID, and issues the machine's Response (the words to say) together with the Personal Status the machine should display - serious while testing, welcoming when the user is recognised, reproaching when not."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
