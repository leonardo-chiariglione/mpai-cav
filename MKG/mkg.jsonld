   }
  ],
  "https://mpai.community/kg/vocab#codePath": [
   {
    "@value": "AIMs/CAE3/V1.0/SOE/SoeAimProcessor.cs"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Speech Object Editing. One Basic Speech Object is open at a time: a Basic Speech Object arriving is opened - from Shared Storage, by its identifier - or kept. The User Command changes where it is heard from (UserPoV, also on its own Port) and its Speech Qualifier or Spatial Attitude (ChangedObjects), and has it translated (TranslatedObjects): the Speech and a Language Selector go to Text and Speech Translation, and the Translation, when it comes back, replaces the original under its identifier - so every Speech Scene holding it holds the translation, at its place. Outputs: the open Basic Speech Object, to the Module and to Speech Scene Editing, and the User Command, with its report half (UserCommandReport) saying how each action was executed (for a translation, when it is done)."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/CAE"
   }
  ],
