   }
  ],
  "https://mpai.community/kg/vocab#codePath": [
   {
    "@value": "AIMs/CAE3/V1.0/SSE/SseAimProcessor.cs"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Speech Scene Editing. One Basic Speech Scene is open at a time: a Basic Speech Scene arriving is opened, and the first Object added to no open Scene creates one. The User Command places Basic Speech Objects - named by their identifiers in Shared Storage - (AddedObjects), moves them, changes where they are, takes them out and sets where the Scene is heard from (UserPoV, also on its own Port). Every edit is a new version in Shared Storage; a member is held by its identifier and read from Shared Storage when the Scene is output. Outputs: the open Basic Speech Scene, and the User Command, with its report half (UserCommandReport) saying how each action was executed."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/CAE"
   }
  ],
  "https://mpai.community/kg/vocab#port": [
   {
    "@id": "https://mpai.community/kg/aim/CAE-SSE-V1.0/port/Input/OSD-BSO-V1.5/0"
   },
