 {
  "@id": "https://mpai.community/kg/aim/CAE-AOE-V1.0",
  "@type": [
   "https://mpai.community/kg/vocab#AIM"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "CAE-AOE-V1.0"
   }
  ],
  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#code": [
   {
    "@id": "https://github.com/leonardo-chiariglione/mpai-cav/blob/main/AIMs/CAE3/V1.0/AOE/AoeAimProcessor.cs"
   }
  ],
  "https://mpai.community/kg/vocab#codePath": [
   {
    "@value": "AIMs/CAE3/V1.0/AOE/AoeAimProcessor.cs"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Audio Object Editing. One Basic Audio Object is open at a time, so a User Command need not name it: a Basic Audio Object arriving is opened - from Shared Storage, by its identifier - or, new (a sound the User Agent captured), created. The User Command modifies what it is like (ModifiedObjects: the Object part of the Acoustic Profile; LUFS) and where it is heard from (UserPoV, also on its own Port). Every edit is a new version in Shared Storage. Outputs: the open Basic Audio Object, to the Module and to Audio Scene Editing, and the User Command, with its report half (UserCommandReport) saying how each action was executed."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/CAE"
   }
  ],
  "https://mpai.community/kg/vocab#port": [
