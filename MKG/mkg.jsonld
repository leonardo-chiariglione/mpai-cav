   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Audio Sensors: the set of Audio sensors of the CAV. Each sensor is served by an instance of the Audio Object Acquisition AIM, which receives what the sensor captures of the Audio Field and provides it as a Basic Audio Object: time-stamped on the CAV's time base, its Qualifier stating the sensor, its intrinsic calibration and its mounting pose on the CAV. An Implementation instantiates the Acquisition AIM once per sensor; the Basic Audio Objects of all sensors leave on one Port, each identifying its sensor."
   }
  ],
  "https://mpai.community/kg/vocab#flow": [
   {
    "@id": "https://mpai.community/kg/aim/CAV-AUS-V2.0/flow/1"
