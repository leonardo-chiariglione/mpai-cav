 {
  "@id": "https://mpai.community/kg/aim/CAV-RAS-V2.0",
  "@type": [
   "https://mpai.community/kg/vocab#AIM"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "CAV-RAS-V2.0"
   }
  ],
  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "RADAR Sensors: the set of RADAR sensors of the CAV. Each sensor is served by an instance of the RADAR Object Acquisition AIM, which receives what the sensor captures of the RADAR Field and provides it as a Basic RADAR Object: time-stamped on the CAV's time base, its Qualifier stating the sensor, its intrinsic calibration and its mounting pose on the CAV. An Implementation instantiates the Acquisition AIM once per sensor; the Basic RADAR Objects of all sensors leave on one Port, each identifying its sensor."
   }
  ],
  "https://mpai.community/kg/vocab#flow": [
   {
    "@id": "https://mpai.community/kg/aim/CAV-RAS-V2.0/flow/1"
   },
   {
    "@id": "https://mpai.community/kg/aim/CAV-RAS-V2.0/flow/2"
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/CAV"
   }
  ],
