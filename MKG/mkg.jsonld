 {
  "@id": "https://mpai.community/kg/datatype/CVE/VisualProfile",
  "@type": [
   "https://mpai.community/kg/vocab#DataType"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "CVE/VisualProfile"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "How an Object or a Scene looks, as the Acoustic Profile says how it sounds. An Object's: its colour, metalness, roughness, transparency and emission - what it looks like wherever it is (#/$defs/Object). A Scene's: its light sources, its ambient light and its atmosphere - what the space does to what is seen in it (#/$defs/Scene). A Data Type refers to the one it has. Like the Acoustic Profile, it belongs to Basic Objects and Basic Scenes."
   }
  ],
  "https://mpai.community/kg/vocab#noAcronym": [
