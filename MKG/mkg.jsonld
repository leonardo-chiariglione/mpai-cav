   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#code": [
   {
    "@id": "https://github.com/leonardo-chiariglione/mpai-cav/blob/main/AIMs/CAE3/V1.0/ASE/AseAimProcessor.cs"
   }
  ],
  "https://mpai.community/kg/vocab#codePath": [
   {
    "@value": "AIMs/CAE3/V1.0/ASE/AseAimProcessor.cs"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Audio Scene Editing. One Basic Audio Scene is open at a time, so a User Command need not name it: a Basic Audio Scene arriving is opened, and the first Object added to no open Scene creates one. The User Command places Basic Audio Objects - named by their identifiers in Shared Storage - (AddedObjects), moves them (MovedObjects), changes where they are (ChangedObjects), takes them out (RemovedObjects) and sets where the Scene is heard from (UserPoV, also on its own Port). Every edit is a new version in Shared Storage. Outputs: the open Basic Audio Scene, and the User Command, with its report half (UserCommandReport) saying how each action was executed."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/CAE"
   }
  ],
  "https://mpai.community/kg/vocab#port": [
