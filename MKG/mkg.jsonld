  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "The acoustics of an Object or of a Scene. An Object's: its frequency range, spectrogram, loudness and directional patterns (#/$defs/Object). A Scene's: its reflectivity, reverberation, diffusion, absorption and Doppler effect (#/$defs/Scene). A Data Type refers to the one it has."
   }
  ],
