  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "MPAI as a Service App: the Module over which the MPAI-MAS workflow runs, letting a User Agent that has not yet chosen an App speak to the person through a Speaking Avatar. Response and Scene Rendering renders the Text the User Agent supplies into Machine Speech and Machine Face Descriptors; Automatic Speech Recognition gives as Text the person's spoken reply to a question the Module asked."
   }
  ],
