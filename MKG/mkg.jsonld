 {
  "@id": "https://mpai.community/kg/aim/CAV-ESS-V2.0",
  "@type": [
   "https://mpai.community/kg/vocab#AIM"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "CAV-ESS-V2.0"
   }
  ],
  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#code": [
   {
    "@id": "https://github.com/leonardo-chiariglione/mpai-cav/blob/main/AIMs/CAV/V2.0/ESS/BasicEnvironmentDescription.cs"
   }
  ],
  "https://mpai.community/kg/vocab#codePath": [
   {
    "@value": "AIMs/CAV/V2.0/ESS/BasicEnvironmentDescription.cs"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Environment Sensing Subsystem: senses the environment of the CAV with its Audio, Visual, RADAR, LiDAR and Ultrasound sensors, describes what each technology senses as Basic Scene Descriptors on the ego frame of reference given by Spatial Attitude Generation, converts the Offline Map into Basic Scene Descriptors of the same kind, and fuses them all into the Basic Environment Descriptors it gives the Autonomous Motion Subsystem. Each scene describer raises an Alert, without waiting for fusion, when what it senses requires urgent consideration. The Basic Environment Descriptors return to each scene describer as its prior. It runs continuously, and goes on when a sensor fails."
   }
  ],
