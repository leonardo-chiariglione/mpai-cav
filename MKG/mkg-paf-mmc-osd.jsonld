 {
  "@id": "https://mpai.community/kg/aim/PAF-SAS-V1.6",
  "@type": [
   "https://mpai.community/kg/vocab#AIM"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "PAF-SAS-V1.6"
   }
  ],
  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Speaking Avatar Synthesis: makes a Speaking Avatar of the input Avatar - its 3D Model animated by the Face Descriptors and the Body Descriptors, uttering the Speech. The Speaking Avatar is ready to play: the Avatar it holds carries the Model, the Speech and the Face and Body Descriptors, time-aligned. The Avatar is kept: given once - when the Module starts, or when the User Agent changes avatar - it is used for every utterance until another arrives."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/PAF"
   }
  ],
