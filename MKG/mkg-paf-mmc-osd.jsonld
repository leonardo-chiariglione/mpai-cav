 {
  "@id": "https://mpai.community/kg/aim/PAF-VMS-V1.6",
  "@type": [
   "https://mpai.community/kg/vocab#AIM"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "PAF-VMS-V1.6"
   }
  ],
  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Virtual Meeting Secretary: from the Portable Avatars of the participants it recognises and understands what they say, extracts their Personal Status, creates and edits the Summary of the meeting, and produces its own Portable Avatar - the VMS Portable Avatar - which speaks the text the secretary produces with its Personal Status. The Summary is also an output."
   }
  ],
