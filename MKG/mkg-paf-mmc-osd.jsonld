 {
  "@id": "https://mpai.community/kg/aim/MMC-AMQ-V2.5",
  "@type": [
   "https://mpai.community/kg/vocab#AIM"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "MMC-AMQ-V2.5"
   }
  ],
  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Answer to Multimodal Question. Receives a Visual Object and a question - as a Speech Object or a Text Object - and returns the answer as Text, as a Speaking Avatar - its speech, face and body, rendered by Response and Scene Rendering with the Avatar the User Agent supplies - and as a Visual Object. Acquisition, presentation and delivery are NOT SubAIMs: they interact with the user directly and therefore belong to the User Agent, travelling with it when it becomes a Remote Client Application. The User Agent shows the image and invites the question before this Module is run, so the image and the question arrive together and the run completes without suspending. Every boundary Port is exchanged with the User Agent."
   }
  ],
  "https://mpai.community/kg/vocab#notAligned": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#boolean",
    "@value": true
   }
  ],
