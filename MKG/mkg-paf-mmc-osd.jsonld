   }
  ],
  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Response and Scene Rendering: renders the machine's response - a Text - as a Speaking Avatar of the input Avatar Model, ready to play; whoever requested it places it in a scene and renders it (e.g. with Scene and Avatar Rendering). Personal Status De-multiplexing splits a Personal Status into the Speech, Face and Body Personal Statuses that make the avatar expressive; Text-To-Speech makes the Machine Speech, with a Speech Model when one is supplied; Speaking Avatar Formation forms the Speaking Avatar from it - or from an Input Speech, when one is supplied."
   }
  ],
