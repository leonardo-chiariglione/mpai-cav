  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Basic Visual Scene Description: describes the acquired BasicVisualObject as BasicVisualSceneDescriptors. It raises an Alert when what it describes warrants one, without waiting for integration. Two of its inputs are optional, so that the same AIM serves applications that have something to connect to them and applications that do not: an application holding an ego Spatial Attitude receives descriptors already expressed in that frame, and one that maintains a running environment description returns it as a prior. Both are wired in EnvironmentSensingSubsystem.json and neither is wired in MMC-HCI."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/OSD"
