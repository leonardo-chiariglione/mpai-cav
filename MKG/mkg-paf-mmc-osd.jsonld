 {
  "@id": "https://mpai.community/kg/aim/MMC-EDP-V2.5",
  "@type": [
   "https://mpai.community/kg/vocab#AIM"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "MMC-EDP-V2.5"
   }
  ],
  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "This AIM implements the Entity Dialogue Processing function: it produces the Machine Text and Machine Personal Status from the human Text, its Text Descriptors, the human Personal Status and identity, the identifiers of the scene objects and the Basic Audio and Visual Scene Geometries, using the running Summary as dialogue memory. In Audio Scene Management (CAE-ASM), given the Audio Scene the User edits, it turns what the User says into User Commands for CAE-ASM, says what was done or asks when the request is unclear, and tells the User Agent, as Text For UA, what only the User Agent does: undo, save, stop."
   }
  ],
