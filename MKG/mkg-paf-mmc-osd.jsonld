   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "User Identification: identifies a user from their face and their speech and reconciles the two into one answer. Speaker Identity Recognition matches the speech, Face Identity Recognition matches the face, and Identity Reconciliation combines the two identities. Identification states whether the face and the speech match somebody known; User ID states who."
   }
  ],
