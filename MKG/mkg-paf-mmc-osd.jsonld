 {
  "@id": "https://mpai.community/kg/aim/PAF-SAR-V1.6",
  "@type": [
   "https://mpai.community/kg/vocab#AIM"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "PAF-SAR-V1.6"
   }
  ],
  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Scene and Avatar Rendering: places a Speaking Avatar - at the Avatar PoV the requester gives - in a Basic Multimodal Scene seen and heard from the Point of View, and produces the Scene as data: either a Basic Audio Scene (the avatar's speech among the scene's audio) and a Basic Visual Scene (what is seen, as 2D Visual Objects), or the Basic Multimodal Scene and the 3D Model Scene with the avatar placed, which a 3D Model Object Delivery draws. It produces data; it does not play or draw."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/PAF"
   }
  ],
