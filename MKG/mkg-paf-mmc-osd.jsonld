  "@id": "https://mpai.community/kg/aim/PAF-CRX-V1.6",
  "@type": [
   "https://mpai.community/kg/vocab#AIM"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "PAF-CRX-V1.6"
   }
  ],
  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Videoconference Client Receiver: from the Portable Avatar it receives from the server and the Point of View of the participant, it creates the Visual Scene of the avatars, merges it with their speech into the Audio-Visual Scene, passing the Avatars and their Personal Statuses on, renders the Speaking Avatar and passes the Basic Multimodal Scene through, which the User Agent delivers; the Output Text is the text of the Portable Avatar."
   }
  ],
