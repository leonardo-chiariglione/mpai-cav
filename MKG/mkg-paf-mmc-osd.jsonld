   {
    "@value": "Secure"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Avatar Videoconference Server: at the start, it receives the Portable Avatars and the Speech and Face Objects of the participants, authenticates them, and distributes the Portable Avatars with the Audio-Visual Scene, the Spatial Attitudes and the Avatar IDs; during the meeting it translates the text and speech of the participants and of the Virtual Meeting Secretary according to their language preferences, and distributes the Portable Avatars. The Summary of the Virtual Meeting Secretary passes through."
   }
  ],
