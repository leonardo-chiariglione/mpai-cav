      "Name": "UserCommand",
      "Direction": "Input",
      "DataType": [
        "CAE-UCM-V1.0"
      ],
      "IsOptional": true,
      "Technology": "Software"
    },
    {
      "Name": "SensedAudio",
      "Direction": "Input",
      "DataType": [
        "OSD-BAO-V1.5",
        "OSD-BAS-V1.5"
      ],
      "PortNumber": 1,
      "IsOptional": true,
      "Technology": "Hardware"
    },
    {
      "Name": "StoredAudio",
      "Direction": "Input",
      "DataType": [
        "OSD-BAO-V1.5",
        "OSD-AUO-V1.5",
        "OSD-BAS-V1.5",
        "OSD-ASD-V1.5"
      ],
      "PortNumber": 2,
      "IsOptional": true,
      "Technology": "Software"
    },
    {
      "Name": "AcquiredAudio",
      "Direction": "Output",
      "DataType": [
        "OSD-BAO-V1.5",
        "OSD-AUO-V1.5",
        "OSD-BAS-V1.5",
        "OSD-ASD-V1.5"
      ],
      "PortNumber": 1,
