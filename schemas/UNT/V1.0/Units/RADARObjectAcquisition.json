      "Name": "SensedRADAR",
      "Direction": "Input",
      "DataType": [
        "OSD-BRO-V1.5",
        "OSD-BRS-V1.5"
      ],
      "PortNumber": 1,
      "IsOptional": true,
      "Technology": "Hardware"
    },
    {
      "Name": "StoredRADAR",
      "Direction": "Input",
      "DataType": [
        "OSD-BRO-V1.5",
        "OSD-RAO-V1.5",
        "OSD-BRS-V1.5",
        "OSD-RSD-V1.5"
      ],
      "PortNumber": 2,
      "IsOptional": true,
      "Technology": "Software"
    },
    {
      "Name": "AcquiredRADAR",
      "Direction": "Output",
      "DataType": [
        "OSD-BRO-V1.5",
        "OSD-RAO-V1.5",
        "OSD-BRS-V1.5",
        "OSD-RSD-V1.5"
      ],
