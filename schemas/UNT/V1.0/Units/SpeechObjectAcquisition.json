      "Name": "UserCommand",
      "Direction": "Input",
      "DataType": [
        "CAE-UCM-V1.0"
      ],
      "IsOptional": true,
      "Technology": "Software"
    },
    {
      "Name": "SensedSpeech",
      "Direction": "Input",
      "DataType": [
        "OSD-BSO-V1.5",
        "OSD-BSS-V1.5"
      ],
      "PortNumber": 1,
      "IsOptional": true,
      "Technology": "Hardware"
    },
    {
      "Name": "StoredSpeech",
      "Direction": "Input",
      "DataType": [
        "OSD-BSO-V1.5",
        "OSD-SPO-V1.5",
        "OSD-BSS-V1.5",
        "OSD-SSD-V1.5"
      ],
      "PortNumber": 2,
