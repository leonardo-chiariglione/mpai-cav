      "Direction": "Input",
      "DataType": [
        "OSD-BUO-V1.5",
        "OSD-BUS-V1.5"
      ],
      "PortNumber": 1,
      "IsOptional": true,
      "Technology": "Hardware"
    },
    {
      "Name": "StoredUltrasound",
      "Direction": "Input",
      "DataType": [
        "OSD-BUO-V1.5",
