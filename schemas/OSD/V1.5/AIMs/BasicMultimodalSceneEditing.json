{ "$schema":              "https://json-schema.org/draft/2020-12/schema",
  "$comment":             "https://schemas.mpai.community/AIF/V3.0/data/AIMMetadata.json",
  "$id":                  "https://schemas.mpai.community/OSD/V1.5/AIMs/BasicMultimodalSceneEditing.json",
  "title":                "Basic Multimodal Scene Editing V1.5",
  "Header":               "OSD-BME-V1.5",

  "Identifier":           {"ImplementerID": "/* String from IIDRA */", "ImplementationID": "/* String from Implementer */", "AIMName": "OSD-BME-V1.5"},

  "APIProfile":           "Basic",
  "Description":          "Basic Multimodal Scene Editing: Basic Scenes of at least two media - Audio, Visual, Speech, LiDAR, 3D Model, RADAR, Ultrasound, Offline Map - composed into a Basic Multimodal Scene (a voice over music is a BMS of a BAS and a BSS). Each of its two Scene Ports takes a Basic Scene of any medium, kept as it arrives. One Basic Multimodal Scene is open at a time: the User Command places the Scenes, named by their identifiers, in its common frame (AddedObjects), moves them, changes where they are, takes them out and sets where the Multimodal Scene is heard and seen from (UserPoV, also on its own Port). The Scenes being edited are followed: a member that is the version last arrived on its Port is replaced by the new version. Every edit is a new version in Shared Storage. Outputs: the open Basic Multimodal Scene - when its members are of at least two media - and the User Command, with its report half (UserCommandReport) saying how each action was executed.",

  "InternalTypes":        [],

  "ExternalPorts":        [{"Name": "BasicScene", "Direction": "Input", "DataType": ["OSD-BAS-V1.5", "OSD-BVS-V1.5", "OSD-BSS-V1.5", "OSD-BLS-V1.5", "OSD-B3S-V1.5", "OSD-BRS-V1.5", "OSD-BUS-V1.5", "OSD-BOS-V1.5"], "PortNumber": 1, "IsOptional": true, "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "OtherBasicScene", "Direction": "Input", "DataType": ["OSD-BAS-V1.5", "OSD-BVS-V1.5", "OSD-BSS-V1.5", "OSD-BLS-V1.5", "OSD-B3S-V1.5", "OSD-BRS-V1.5", "OSD-BUS-V1.5", "OSD-BOS-V1.5"], "PortNumber": 2, "IsOptional": true, "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "UserCommand", "Direction": "Input", "DataType": "CAE-UCM-V1.0", "IsOptional": true, "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "UserPoV", "Direction": "Input", "DataType": "OSD-OPV-V1.5", "IsOptional": true, "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "MultimodalScene", "Direction": "Output", "DataType": "OSD-BMS-V1.5", "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "UserCommandReport", "Direction": "Output", "DataType": "CAE-UCM-V1.0", "IsOptional": true, "Technology": "Software", "Protocol": "", "IsRemote": false}],

