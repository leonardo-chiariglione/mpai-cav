{ "$schema":                   "https://json-schema.org/draft/2020-12/schema",
  "$id":                       "https://schemas.mpai.community/OSD/V1.5/data/SceneGeometry.json",
  "title":                     "Scene Geometry V1.5",
  "type":                      "object",
  "additionalProperties":      false,
  "required":                  [ "Header", "SceneGeometryID" ],

  "properties":                {

    "Header":                  { "type": "string", "const": "OSD-SCG-V1.5" },
    "MInstanceID":             { "type": "string", "description": "Identifier of the M-Instance." },
    "UEnvironmentID":          { "type": "string", "description": "Identifier of the U-Environment." },
    "SceneGeometryID":         { "type": "string", "description": "ID of this Scene Geometry instance." },
    "SceneGeometryTime":       { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },
    "SceneGeometrySpaceTime":  { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
    "ObjectCount":             { "type": "integer", "minimum": 0, "description": "Number of Objects in Scene." },
    "SceneObjects":            { "type": "array", "description": "Set of Data related to Objects in the Scene.", "items": { "type": "object", "additionalProperties": false, "properties": {
      "SceneObjectSpaceTime":  { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
      "SceneObjectQualifier":  { "$ref": "https://schemas.mpai.community/TFA/V1.5/data/AnyQualifier.json" } } } },

    "SubSceneCount":           { "type": "integer", "minimum": 0, "description": "Number of Sub-Scenes in Scene." },
    "SubScenes":               { "type": "array", "description": "Set of Data related to Objects in the Scene.", "items": { "type": "object", "additionalProperties": false, "properties": {
      "SubSceneSpaceTime":     { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" } } } },

    "DataXMData":              { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":           { "type": "string", "maxLength": 2048, "description": "Descriptive Metadata" } } }