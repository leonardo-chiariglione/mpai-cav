{ "$schema":                             "https://json-schema.org/draft/2020-12/schema",
  "$id":                                 "https://schemas.mpai.community/OSD/V1.5/data/BasicAudioSceneGeometry.json",
  "title":                               "Basic Audio Scene Geometry V1.5",
  "type":                                "object",
  "additionalProperties":                false,
  "required":                            [ "Header", "AudioSceneGeometryID" ],

  "properties":                          {

    "Header":                            { "type": "string", "const": "OSD-BAG-V1.5" },
    "MInstanceID":                       { "type": "string", "description": "Identifier of the M-Instance." },
    "UEnvironmentID":                    { "type": "string", "description": "Identifier of the U-Environment." },
    "AudioSceneGeometryID":              { "type": "string", "description": "ID of this Audio Scene Geometry instance." },
    "AudioSceneGeometryTime":            { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },
    "AudioObjectCount":                  { "type": "integer", "minimum": 0, "description": "Number of AudioObjects in Scene." },
    "AudioSceneGeometrySpaceTime":       { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
    "BasicAudioSceneObjects":            { "type": "array", "description": "Set of Data related to AudioObjects in the Audio Scene.", "items": { "type": "object", "additionalProperties": false, "properties": {
      "AudioSceneObjectQualifiers":      { "$ref": "https://schemas.mpai.community/TFA/V1.5/data/AudioQualifier.json" },
      "BasicAudioSceneObjectSpaceTime":  { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" } } } },

    "DataXMData":                        { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                     { "type": "string", "maxLength": 2048, "description": "Descriptive Metadata" } } }