{ "$schema":                          "https://json-schema.org/draft/2020-12/schema",
  "$id":                              "https://schemas.mpai.community/OSD/V1.5/data/3DModelSceneGeometry.json",
  "title":                            "3 DModel Scene Geometry V1.5",
  "type":                             "object",
  "additionalProperties":             false,
  "required":                         [ "Header", "3DModelSceneGeometryID" ],

  "properties":                       {

    "Header":                         { "type": "string", "const": "OSD-3SG-V1.5" },
    "MInstanceID":                    { "type": "string", "description": "Identifier of the M-Instance." },
    "UEnvironmentID":                 { "type": "string", "description": "Identifier of the U-Environment." },
    "3DModelSceneGeometryID":         { "type": "string", "description": "ID of this 3DModel Scene Geometry instance." },
    "3DModelSceneGeometryTime":       { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },
    "3DModelSceneGeometrySpaceTime":  { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
    "ObjectCount":                    { "type": "integer", "minimum": 0, "description": "Number of Objects in 3DModel Scene." },
    "3DModelSceneObjects":            { "type": "array", "description": "Set of Data related to 3DModel Objects in the 3DModel Scene.", "items": { "type": "object", "additionalProperties": false, "properties": {
      "3DModelSceneObjectSpaceTime":  { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
      "3DModelSceneObjectQualifier":  { "$ref": "https://schemas.mpai.community/TFA/V1.5/data/3DModelQualifier.json" } } } },

    "Sub3DModelSceneCount":           { "type": "integer", "minimum": 0, "description": "Number of Sub-3DModel Scenes in the 3DModel Scene." },
    "Sub3DModelScenes":               { "type": "array", "description": "Set of Data related to 3DModel Objects in the 3DModel Scene.", "items": { "type": "object", "additionalProperties": false, "properties": {
      "Sub3DModelSceneSpaceTime":     { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" } } } },

    "DataXMData":                     { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                  { "type": "string", "maxLength": 2048, "description": "Descriptive Metadata" } } }