{ "$schema":                        "https://json-schema.org/draft/2020-12/schema",
  "$id":                            "https://schemas.mpai.community/OSD/V1.5/data/LiDARSceneGeometry.json",
  "title":                          "Li DARScene Geometry V1.5",
  "type":                           "object",
  "additionalProperties":           false,
  "required":                       [ "Header", "LiDARSceneGeometryID" ],

  "properties":                     {

    "Header":                       { "type": "string", "const": "OSD-LSG-V1.5" },
    "MInstanceID":                  { "type": "string", "description": "Identifier of the M-Instance." },
    "UEnvironmentID":               { "type": "string", "description": "Identifier of the U-Environment." },
    "LiDARSceneGeometryID":         { "type": "string", "description": "ID of this LiDAR Scene Geometry instance." },
    "LiDARSceneGeometryTime":       { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },
    "LiDARSceneGeometrySpaceTime":  { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
    "ObjectCount":                  { "type": "integer", "minimum": 0, "description": "Number of Objects in LiDAR Scene." },
    "LiDARSceneObjects":            { "type": "array", "description": "Set of Data related to LiDAR Objects in the LiDAR Scene.", "items": { "type": "object", "additionalProperties": false, "properties": {
      "LiDARSceneObjectSpaceTime":  { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
      "LiDARSceneObjectQualifier":  { "$ref": "https://schemas.mpai.community/TFA/V1.5/data/LiDARQualifier.json" } } } },

    "SubLiDARSceneCount":           { "type": "integer", "minimum": 0, "description": "Number of Sub-LiDAR Scenes in the LiDAR Scene." },
    "SubLiDARScenes":               { "type": "array", "description": "Set of Data related to LiDAR Objects in the LiDAR Scene.", "items": { "type": "object", "additionalProperties": false, "properties": {
      "SubLiDARSceneSpaceTime":     { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" } } } },

    "DataXMData":                   { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                { "type": "string", "maxLength": 2048, "description": "Descriptive Metadata" } } }