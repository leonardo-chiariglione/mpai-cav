{ "$schema":                             "https://json-schema.org/draft/2020-12/schema",
  "$id":                                 "https://schemas.mpai.community/OSD/V1.5/data/UltrasoundSceneGeometry.json",
  "title":                               "Ultrasound Scene Geometry V1.5",
  "type":                                "object",
  "additionalProperties":                false,
  "required":                            [ "Header", "UltrasoundSceneGeometryID" ],

  "properties":                          {

    "Header":                            { "type": "string", "const": "OSD-USG-V1.5" },
    "MInstanceID":                       { "type": "string", "description": "Identifier of the M-Instance." },
    "UEnvironmentID":                    { "type": "string", "description": "Identifier of the U-Environment." },
    "UltrasoundSceneGeometryID":         { "type": "string", "description": "ID of this Ultrasound Scene Geometry instance." },
    "UltrasoundSceneGeometryTime":       { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },
    "UltrasoundSceneGeometrySpaceTime":  { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
    "ObjectCount":                       { "type": "integer", "minimum": 0, "description": "Number of Objects in Ultrasound Scene." },
    "UltrasoundSceneObjects":            { "type": "array", "description": "Set of Data related to Ultrasound Objects in the Ultrasound Scene.", "items": { "type": "object", "additionalProperties": false, "properties": {
      "UltrasoundSceneObjectSpaceTime":  { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
      "UltrasoundSceneObjectQualifier":  { "$ref": "https://schemas.mpai.community/TFA/V1.5/data/UltrasoundQualifier.json" } } } },

    "SubUltrasoundSceneCount":           { "type": "integer", "minimum": 0, "description": "Number of Sub-Ultrasound Scenes in the Ultrasound Scene." },
    "SubUltrasoundScenes":               { "type": "array", "description": "Set of Data related to Ultrasound Objects in the Ultrasound Scene.", "items": { "type": "object", "additionalProperties": false, "properties": {
      "SubOfflineMapSceneSpaceTime":     { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" } } } },

    "DataXMData":                        { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                     { "type": "string", "maxLength": 2048, "description": "Descriptive Metadata" } } }