{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mpai.community/OSD/V1.5/data/OfflineMapEventDescriptors.json",
  "title": "Offline Map Event Descriptors V1.5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Header",
    "OfflineMapEventDescriptorsID"
  ],
  "properties": {
    "Header": {
      "type": "string",
      "const": "OSD-OEV-V1.5"
    },
    "MInstanceID": {
      "type": "string",
      "description": "Identifier of the M-Instance."
    },
    "UEnvironmentID": {
      "type": "string",
      "description": "Identifier of the U-Environment."
    },
    "OfflineMapEventDescriptorsID": {
      "type": "string",
      "description": "ID of this OfflineMap Event Descriptors instance."
    },
    "OfflineMapEventDescriptorsTime": {
      "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json"
    },
    "OfflineMapEventDescriptorsSpaceTime": {
      "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json"
    },
    "OfflineMapSceneDescriptors": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "https://schemas.mpai.community/OSD/V1.5/data/OfflineMapSceneDescriptors.json"
          },
          {
            "type": "string"
          }
        ]
      },
      "description": "Set of OfflineMap Scene Descriptors in the OfflineMap Event."
    },
    "DataXMData": {
      "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json"
    },
    "DescrMetadata": {
      "type": "string",
      "maxLength": 2048,
      "description": "Descriptive Metadata"
    }
  }
}
