{ "$schema":          "https://json-schema.org/draft/2020-12/schema",
  "$id":              "https://schemas.mpai.community/OSD/V1.5/data/Point.json",
  "title":            "Point V1.5",
  "type":             "object",
  "properties":       {

    "Header":         { "type": "string", "const": "OSD-PNT-V1.5" },
    "MInstanceID":    { "type": "string" },
    "UEnvironmentID": { "type": "string" },

    "Coordinates":    { "type": "object", "properties": {
                        "X": { "type": "number" },
                        "Y": { "type": "number" },
                        "Z": { "type": "number" } } },

    "SpatialQualifier": { "$ref": "https://schemas.mpai.community/TFA/V1.5/data/SpatialQualifier.json", "description": "Spatial Qualifier stating the conventions of the coordinates of the Point: frame, axes and their handedness, units. A Qualifier of an inner Data Type overrides this one." },
    "DataXMData":     { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":  { "type": "string", "maxLength": 2048 } } }