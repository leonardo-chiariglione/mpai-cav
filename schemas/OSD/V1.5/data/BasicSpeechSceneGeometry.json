{ "$schema":                               "https://json-schema.org/draft/2020-12/schema",
  "$id":                                   "https://schemas.mpai.community/OSD/V1.5/data/BasicSpeechSceneGeometry.json",
  "title":                                 "Basic Speech Scene Geometry V1.5",
  "type":                                  "object",
  "additionalProperties":                  false,
  "required":                              [ "Header", "SpeechSceneGeometryID" ],

  "properties":                            {

    "Header":                              { "type": "string", "const": "OSD-BSG-V1.5" },
    "MInstanceID":                         { "type": "string", "description": "Identifier of the M-Instance." },
    "UEnvironmentID":                      { "type": "string", "description": "Identifier of the U-Environment." },
    "SpeechSceneGeometryID":               { "type": "string", "description": "ID of this Basic Speech Scene Geometry instance." },
    "SpeechSceneGeometryTime":             { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },
    "SpeechObjectCount":                   { "type": "integer", "minimum": 0, "description": "Number of Speech Objects in Scene." },
    "SpeechSceneGeometrySpaceTime":        { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
    "BasicSpeechSceneObjects":             { "type": "array", "description": "Set of Data related to Speech Objects in the Speech Scene.", "items": { "type": "object", "additionalProperties": false, "properties": {
      "BasicSpeechSceneObjectQualifiers":  { "$ref": "https://schemas.mpai.community/TFA/V1.5/data/SpeechQualifier.json" },
      "BasicSpeechSceneObjectSpaceTime":   { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" } } } },

    "DataXMData":                          { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                       { "type": "string", "maxLength": 2048, "description": "Descriptive Metadata" } } }