{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mpai.community/OSD/V1.5/data/AudioEventDescriptors.json",
  "title": "Audio Event Descriptors V1.5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Header",
    "AudioEventDescriptorsID"
  ],
  "properties": {
    "Header": {
      "type": "string",
      "const": "OSD-AEV-V1.5"
    },
    "MInstanceID": {
      "type": "string",
      "description": "Identifier of the M-Instance."
    },
    "UEnvironmentID": {
      "type": "string",
      "description": "Identifier of the U-Environment."
    },
    "AudioEventDescriptorsID": {
      "type": "string",
      "description": "ID of this Audio Event Descriptors instance."
    },
    "AudioEventDescriptorsTime": {
      "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json"
    },
    "AudioEventDescriptorsSpaceTime": {
      "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json"
    },
    "AudioSceneDescriptors": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "https://schemas.mpai.community/OSD/V1.5/data/AudioSceneDescriptors.json"
          },
          {
            "type": "string"
          }
        ]
      },
      "description": "Set of Audio Scene Descriptors in the Audio Event."
    },
    "DataXMData": {
      "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json"
    },
    "DescrMetadata": {
      "type": "string",
      "maxLength": 2048,
      "description": "Descriptive Metadata"
    }
  }
}
