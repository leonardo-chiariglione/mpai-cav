{ "$schema":                         "https://json-schema.org/draft/2020-12/schema",
  "$id":                             "https://schemas.mpai.community/OSD/V1.5/data/ClosedSpace.json",
  "title":                           "Closed Space V1.5",
  "description":                     "A space enclosed by walls: its shape a Simple Location - a combination of Right Parallelepipeds - and the Material of its walls. The walls are the faces of the Right Parallelepipeds, named Floor, Ceiling, Front, Back, Left and Right as Right Parallelepiped names them; a face where two Right Parallelepipeds meet is an opening, not a wall. A wall not given its own Material has the DefaultMaterial.",
  "type":                            "object",
  "required":                        [ "Header", "ClosedSpaceID", "Shape" ],
  "additionalProperties":            false,
  "properties":                      {

    "Header":                        { "type": "string", "const": "OSD-CSP-V1.5" },
    "MInstanceID":                   { "type": "string" },
    "UEnvironmentID":                { "type": "string" },
    "ClosedSpaceID":                 { "type": "string" },
    "ClosedSpaceTime":               { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },
    "ClosedSpaceSpaceTime":          { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json", "description": "Where and when the Closed Space is." },

    "Shape":                         { "$ref": "#/$defs/SimpleLocationIDOrSimpleLocation", "description": "The Simple Location giving the shape of the Closed Space." },

    "Walls":                         { "type": "array", "description": "The Materials of walls, each a face of one of the Right Parallelepipeds of the Shape.",
                                       "items": { "type": "object", "required": [ "RightParallelepipedID", "Face", "MaterialIDOrMaterial" ], "additionalProperties": false, "properties": {
      "RightParallelepipedID":       { "type": "string", "description": "The Right Parallelepiped of the Shape whose face this wall is." },
      "Face":                        { "type": "string", "enum": [ "Floor", "Ceiling", "Front", "Back", "Left", "Right" ] },
      "MaterialIDOrMaterial":        { "$ref": "#/$defs/MaterialIDOrMaterial" } } } },

    "DefaultMaterial":               { "$ref": "#/$defs/MaterialIDOrMaterial", "description": "The Material of every wall not given its own." },

    "DataXMData":                    { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                 { "type": "string", "maxLength": 2048 } },

  "$defs":                           {

    "SimpleLocationIDOrSimpleLocation": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "oneOf": [
                                     { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleLocation.json" },
                                     { "type": "string" } ] } },

    "MaterialIDOrMaterial":          { "type": "array", "minItems": 1, "maxItems": 1, "items": { "oneOf": [
                                     { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Material.json" },
                                     { "type": "string" } ] } } } }
