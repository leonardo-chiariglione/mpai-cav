{ "$schema":                            "https://json-schema.org/draft/2020-12/schema",
  "$id":                                "https://schemas.mpai.community/OSD/V1.5/data/VisualEventDescriptors.json",
  "title":                              "Visual Event Descriptors V1.5",
  "type":                               "object",
  "additionalProperties":               false,
  "required":                           [ "Header", "VisualEventDescriptorsID" ],

  "properties":                         {

    "Header":                           { "type": "string", "const": "OSD-VED-V1.5" },
    "MInstanceID":                      { "type": "string", "description": "Identifier of the M-Instance." },
    "UEnvironmentID":                   { "type": "string", "description": "Identifier of the U-Environment." },
    "VisualEventDescriptorsID":         { "type": "string", "description": "ID of this Visual Event Descriptors instance." },
    "VisualEventDescriptorsTime":       { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },
    "VisualEventDescriptorsSpaceTime":  { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
    "VisualSceneDescriptors":           { "type": "array", "items": { "oneOf": [ { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/VisualSceneDescriptors.json" }, { "type": "string" } ] },
                                          "description": "Set of Visual Scene Descriptors in the Visual Event." },

    "DataXMData":                       { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                    { "type": "string", "maxLength": 2048, "description": "Descriptive Metadata" } } }