{ "$schema":                             "https://json-schema.org/draft/2020-12/schema",
  "$id":                                 "https://schemas.mpai.community/OSD/V1.5/data/MultimodalSceneGeometry.json",
  "title":                               "Multimodal Scene Geometry V1.5",
  "type":                                "object",
  "additionalProperties":                false,
  "required":                            [ "Header", "MultimodalSceneGeometryID" ],

  "properties":                          {

    "Header":                            { "type": "string", "const": "OSD-MSG-V1.5" },
    "MInstanceID":                       { "type": "string", "description": "Identifier of the M-Instance." },
    "UEnvironmentID":                    { "type": "string", "description": "Identifier of the U-Environment." },
    "MultimodalSceneGeometryID":         { "type": "string", "description": "ID of this Multimodal Scene Geometry instance." },
    "MultimodalSceneGeometryTime":       { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },
    "MultimodalSceneGeometrySpaceTime":  { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
    "ObjectCount":                       { "type": "integer", "minimum": 0, "description": "Number of Objects in Multimodal Scene." },
    "MultimodalSceneObjects":            { "type": "array", "description": "Set of Data related to Multimodal Objects in the Multimodal Scene.", "items": { "type": "object", "additionalProperties": false, "properties": {
      "MultimodalSceneObjectSpaceTime":  { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
      "MultimodalSceneObjectQualifier":  { "$ref": "https://schemas.mpai.community/TFA/V1.5/data/AnyQualifier.json" } } } },

    "SubMultimodalSceneCount":           { "type": "integer", "minimum": 0, "description": "Number of Sub-Multimodal Scenes in the Multimodal Scene." },
    "SubMultimodalScenes":               { "type": "array", "description": "Set of Data related to Multimodal Objects in the Multimodal Scene.", "items": { "type": "object", "additionalProperties": false, "properties": {
      "SubMultimodalSceneSpaceTime":     { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" } } } },

    "DataXMData":                        { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                     { "type": "string", "maxLength": 2048, "description": "Descriptive Metadata" } } }