                           {"Name": "SpeechSceneDescriptors", "Direction": "Output", "DataType": "OSD-SSD-V1.5", "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "UserCommandRS", "Direction": "Output", "DataType": "CAE-UCM-V1.0", "IsOptional": true, "Technology": "Software", "Protocol": "", "IsRemote": false}],

