                      {"Name": "LanguageSelector", "Direction": "Input",  "DataType": "OSD-SEL-V1.5",                   "PortNumber": 1, "Technology": "Software", "Protocol": "", "IsRemote": false},
                      {"Name": "InputText",        "Direction": "Input",  "DataType": ["OSD-BTO-V1.5", "OSD-TXO-V1.5"], "PortNumber": 1, "IsOptional": true, "Technology": "Software", "Protocol": "", "IsRemote": false},
                      {"Name": "TextSpeechSelector","Direction": "Input", "DataType": "OSD-SEL-V1.5",                   "PortNumber": 2, "IsOptional": true, "Technology": "Software", "Protocol": "", "IsRemote": false},
