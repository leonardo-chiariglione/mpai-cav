  "APIProfile":       "Basic",
  "Description":      "Speech Translation with Descriptors: translates a Speech Object into the language that the Language Selector names and gives the translated Speech Object in the voice of the input speech, and the translated Text Object. Automatic Speech Recognition recognises the speech; Entity Speech Description describes the voice; Text-to-Text Translation translates the text; Text-to-Speech with Descriptors speaks the translation with the voice described. There is no direct speech-to-speech translation.",

  "InternalTypes":   [{"Name": "RecognisedText",    "DataType": ["OSD-BTO-V1.5", "OSD-TXO-V1.5"]},
                      {"Name": "TranslatedText",    "DataType": ["OSD-BTO-V1.5", "OSD-TXO-V1.5"]},
                      {"Name": "SpeechDescriptors", "DataType": "MMC-SDO-V2.5"}],

