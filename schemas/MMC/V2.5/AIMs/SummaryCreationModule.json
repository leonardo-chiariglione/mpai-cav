{ "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "https://schemas.mpai.community/AIF/V3.0/data/AIMMetadata.json",
  "$id": "https://schemas.mpai.community/MMC/V2.5/AIMs/SummaryCreationModule.json",
  "title": "Summary Creation Module V2.5",

  "Identifier":   { "ImplementerID": "/* String from IIDRA */", "ImplementationID": "/* String from Implementer */", "AIMName": "MMC-SCM-V2.5" },

  "Header":       "MMC-SCM-V2.5",

  "APIProfile":   "Basic",
  "Description":  "Summary Creation Module: produces a Summary from the Refined Text and the Meaning of what an entity says, using the Entity ID, the Personal Status and the Edited Summary, and optionally the Space-Time.",

  "InternalTypes":  [ ],

  "ExternalPorts":  [
    { "Name": "EntityID"      , "Direction": "Input",   "DataType": "OSD-IID-V1.5",  "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "TextObject"    , "Direction": "Input",   "DataType": "OSD-BTO-V1.5",  "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "SpaceTime"     , "Direction": "Input",   "DataType": "OSD-SPT-V1.5",  "IsOptional": true, "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "TextDescriptors", "Direction": "Input",   "DataType": "MMC-TDO-V2.5",  "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "PersonalStatus", "Direction": "Input",   "DataType": "MMC-EPS-V2.5",  "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "EditedSummary" , "Direction": "Input",   "DataType": "MMC-SUM-V2.5",  "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "Summary"       , "Direction": "Output",  "DataType": "MMC-SUM-V2.5",  "Technology": "Software", "Protocol": "", "IsRemote": false }
  ],

  "SubAIMs":  [ ],
  "Topology":  [ ],

  "Implementations":      [{"ImplementationURI": "/* absolute URI locating the Implementation */", "BinaryName": "/* provided by implementer */", "Architecture": "/* x86-64 | ARM64 */", "MASPort": 443, "Firewall": [{"Protocol": "TCP | UDP", "Version": "IPV4 | IPV6", "Direction": "Ingress | Egress | Both", "Range": "9990[-9999]", "Source": "0.0.0.0/0"}], "OperatingSystem": "/* Windows | Linux | MacOS */", "Version": "/* implementer version */", "Source": "/* AIMStorage | MPAIStore */", "Destination": "/* provided by implementer */"}],
  "ResourcePolicies":     [{"Name": "Memory", "Minimum": "/* GB */", "Maximum": "/* GB */", "Request": "/* GB */"},
                          {"Name": "CPU:Number", "Minimum": "/* integer, 0=all */", "Maximum": "/* integer, 0=all */", "Request": "/* integer */"},
                          {"Name": "CPU:Class", "Minimum": "/* string */", "Maximum": "/* string */", "Request": "/* string */"},
                          {"Name": "GPU:Number", "Minimum": "/* integer, 0=all */", "Maximum": "/* integer, 0=all */", "Request": "/* integer */"},
                          {"Name": "GPU:CUDA:Class", "Minimum": "/* string */", "Maximum": "/* string */", "Request": "/* string */"},
                          {"Name": "GPU:CUDA:FrameBuffer", "Minimum": "/* GB */", "Maximum": "/* GB */", "Request": "/* GB */"},
                          {"Name": "GPU:CUDA:MemorySpeed", "Minimum": "/* GB/s */", "Maximum": "/* GB/s */", "Request": "/* GB/s */"}],
  "DataXMData":  { },

  "Documentation":  [{ "Type": "Tutorial", "URI": "https://mpai.community/standards/mpai-mmc/v2-5/" }] }