{ "$schema":                     "https://json-schema.org/draft/2020-12/schema",
  "$id":                         "https://schemas.mpai.community/XRV1/V1.0/data/LightingConsole.json",
  "title":                       "Lighting Console V1.0",
  "type":                        "object",
  "additionalProperties":        false,
  "required":                    [ "Header", "LightingConsoleID", "LightingCommands", "UEnvironmentID", "LightingConsoleTime" ],
  "properties":                  {

    "Header":                    { "type": "string", "const": "XRV-LTC-V1.0" },
    "MInstanceID":               { "type": "string" },
    "UEnvironmentID":            { "type": "string" },
    "LightingConsoleID":         { "type": "string" },
    "LightingConsoleTime":       { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "LightingConsoleSpaceTime":  { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
    "LightingCueNumber":         { "type": "integer", "minimum": 0 },

    "MasterDimmer":              { "type": "number", "minimum": 0, "maximum": 100, "description": "Master dimmer, in percent (0 to 100)." },

    "LightingCommands":          { "type": "array", "minItems": 0, "items": { "type": "object", "additionalProperties": false, "properties": {

      "MetaverseObject":         { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/MetaverseObject.json" },

      "ManufacturerID":          { "type": "string" },
      "FixtureID":               { "type": "string" },
      "FixturePoV":              { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/PointOfView.json" },

      "LightSource":             { "$ref": "https://schemas.mpai.community/CVE/V1.0/data/LightSource.json" },
      "Dimming":                 { "type": "string" },

      "Colour":                  { "type": "object", "additionalProperties": false, "properties": {
        "ComponentID":           { "type": "string" },
        "ControlObject":         { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/ControlObject.json" } } },

      "Gobo":                    { "type": "object", "additionalProperties": false, "properties": {
        "GoboID":                { "type": "string" },
        "Rotation":              { "type": "boolean" },
        "Direction":             { "type": "integer", "minimum": -1, "maximum": 1, "description": "Rotation direction: -1 counter-clockwise, 0 no rotation, 1 clockwise." },
        "Rate":                  { "type": "number", "minimum": 0, "description": "Rotation rate, in revolutions per minute (not less than 0)." },
        "ControlObject":         { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/ControlObject.json" } } },

      "Prism":                   { "type": "object", "additionalProperties": false, "properties": {
        "PrismID":               { "type": "string" },
        "Rotation":              { "type": "boolean" },
        "Direction":             { "type": "integer", "minimum": -1, "maximum": 1, "description": "Rotation direction: -1 counter-clockwise, 0 no rotation, 1 clockwise." },
        "Rate":                  { "type": "number", "minimum": 0, "description": "Rotation rate, in revolutions per minute (not less than 0)." },
        "ControlObject":         { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/ControlObject.json" } } },

      "Pan":                     { "type": "number", "minimum": -270, "maximum": 270, "description": "Pan, in degrees (-270 to 270)." },
      "Tilt":                    { "type": "number", "minimum": -135, "maximum": 135, "description": "Tilt, in degrees (-135 to 135)." },
      "BeamFocus":               { "type": "number", "minimum": 0, "maximum": 100, "description": "Beam focus, on a scale from 0 to 100." },
      "AudioResponse":           { "type": "boolean" } } } },

    "DataXMData":               { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":            { "type": "string", "maxLength": 2048 } } }
