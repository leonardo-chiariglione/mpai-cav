{ "$schema":                      "https://json-schema.org/draft/2020-12/schema",
  "$id":                          "https://schemas.mpai.community/XRV1/V1.0/data/VEPerformanceDescriptors.json",
  "title":                        "VE Performance Descriptors V1.0",
  "description":                  "Descriptor set for Virtual Environment (VE) performance: scene, performers, objects, camera, and timing.",
  "type":                         "object",
  "additionalProperties":         false,
  "required":                     [ "Header", "VEPerformanceDescriptorsID", "VEPerformerDescriptors" ],
  "properties":                   {

    "Header":                     { "type": "string", "const": "XRV-VFD-V1.0" },
    "MInstanceID":                { "type": "string" },
    "UEnvironmentID":             { "type": "string" },
    "VEPerformanceDescriptorsID": { "type": "string" },
    "VEPerformanceDescriptorsTime": { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },
    "AVSceneDescriptors":         { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/AudioVisualSceneDescriptors.json" },

    "VEPerformerDescriptors":     { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": [ "VEPerformerID" ], "properties": {

        "VEPerformerID":          { "type": "string" },
        "SpatialAttitude":        { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" },
        "Avatar":                 { "$ref": "https://schemas.mpai.community/PAF/V1.6/data/Avatar.json" },
        "SpeechObject":           { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpeechObject.json" },
        "BiometricData":          { "$ref": "https://schemas.mpai.community/AIH1/V1.0/data/BiometricData.json" },
        "Brainwavefreq":          { "type": "object", "additionalProperties": false, "description": "Brainwave frequencies: the frequency, in Hz, of each EEG band.", "properties": {
          "alpha":                { "type": "number", "minimum": 8, "maximum": 13, "description": "Frequency of the alpha band, in Hz (8 to 13 Hz)." },
          "theta":                { "type": "number", "minimum": 4, "maximum": 8, "description": "Frequency of the theta band, in Hz (4 to 8 Hz)." },
          "delta":                { "type": "number", "minimum": 0.5, "maximum": 4, "description": "Frequency of the delta band, in Hz (0.5 to 4 Hz)." },
          "beta":                 { "type": "number", "minimum": 13, "maximum": 30, "description": "Frequency of the beta band, in Hz (13 to 30 Hz)." },
          "gamma":                { "type": "number", "minimum": 30, "maximum": 100, "description": "Frequency of the gamma band, in Hz (30 to 100 Hz)." } } } } } },

    "VEObjectDescriptors":        { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": [ "VEObjectID", "VEObject" ], "properties": {

        "VEObjectID":             { "type": "string" },
        "VEObject":               { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/3DModelObject.json" },
        "SpatialAttitude":        { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" },
        "ControlObject":              { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/ControlObject.json" } } } },

    "VCameraData":                { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": {
        "VEVisualObject":         { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/3DModelObject.json" },
        "FieldOfView":            { "type": "number", "minimum": 0, "maximum": 180, "description": "Field of view, in degrees." },
        "VEAudioObject":          { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/AudioObject.json" },
        "SpatialAttitude":        { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" } } } },

    "DataXMData":                 { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":              { "type": "string", "maxLength": 2048 } } }
