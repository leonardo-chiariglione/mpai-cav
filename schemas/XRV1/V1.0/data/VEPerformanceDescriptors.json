{ "$schema":                      "https://json-schema.org/draft/2020-12/schema",
  "$id":                          "https://schemas.mpai.community/XRV1/V1.0/data/VEPerformanceDescriptors.json",
  "title":                        "VE Performance Descriptors V1.0",
  "description":                  "Descriptor set for Virtual Environment (VE) performance: scene, performers, objects, camera, and timing.",
  "type":                         "object",
  "additionalProperties":         false,
  "required":                     [ "Header", "VEPerformanceDescriptorsID", "VEPerformanceDescriptorsData", "UEnvironmentID", "VEPerformanceDescriptorsTime" ],
  "properties":                   {

    "Header":                     { "type": "string", "const": "XRV-VFD-V1.0" },
    "MInstanceID":                { "type": "string" },
    "UEnvironmentID":             { "type": "string" },
    "VEPerformanceDescriptorsID": { "type": "string" },
    "VEPerformanceDescriptorsTime": { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },
    "AVSceneDescriptors":         { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/MultimodalSceneDescriptors.json" },

    "VEPerformanceDescriptorsData":     { "type": "array", "minItems": 0, "items": { "type": "object", "additionalProperties": false, "required": [ "VEPerformerID" ], "properties": {

        "VEPerformerID":          { "type": "string" },
        "SpatialAttitude":        { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" },
        "AvatarOrAvatarID":       { "type": "array", "items": { "oneOf": [
                                    { "$ref": "https://schemas.mpai.community/PAF/V1.6/data/PortableAvatar.json" },
                                    { "type": "string" } ] }, "description": "Array of Portable Avatars (objects) or Portable Avatar IDs (string)." },
        "UtteredSpeech":           { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpeechObject.json" },
        "BiometricData":          { "$ref": "https://schemas.mpai.community/AIH1/V1.1/data/BiometricData.json" },
        "Brainwaves": { "$ref": "https://schemas.mpai.community/AIH1/V1.1/data/Brainwaves.json" } } } },

    "VEObjectDescriptors":        { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": [ "VEObjectID", "VEObject" ], "properties": {

        "VEObjectID":             { "type": "string" },
        "VEObject":               { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/3DModelObject.json" },
        "SpatialAttitude":        { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" },
        "ControlObject":              { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/ControlObject.json" } } } },

    "VECameraData":                { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": {
        "VEVisualObject":         { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/3DModelObject.json" },
        "FieldOfView":            { "type": "number", "minimum": 0, "maximum": 180, "description": "Field of view, in degrees." },
        "VEAudioObject":          { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/AudioObject.json" },
        "SpatialAttitude":        { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" } } } },

    "DataXMData":                 { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":              { "type": "string", "maxLength": 2048 } } }
