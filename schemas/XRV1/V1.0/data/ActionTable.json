{ "$schema":                  "https://json-schema.org/draft/2020-12/schema",
  "$id":                      "https://schemas.mpai.community/XRV1/V1.0/data/ActionTable.json",
  "title":                    "Action Table V1.0", 
  "type":                     "object", 
  "additionalProperties":     false,
  "required":                 [ "Header", "ActionTableID" ],
  "properties":               {

    "Header":                 { "type": "string", "const": "XRV-ATB-V1.0" },
    "MInstanceID":            { "type": "string" },
    "UEnvironmentID":         { "type": "string" },
    "ActionTableID":          { "type": "string" },
    "ActionTableTime":        { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "ActionTableData":        { "type": "array", "minItems": 1, "items": { 
                                "type": "object", "additionalProperties": false, "required": [ "ActionID" ], "properties": {

        "ActionID":           { "type": "string" },
        "ActionName":         { "type": "string" },

        "Action":             { "type": "array", "items": { "type": "object", "properties": {
          "ActionCommand":    { "type": "object" },
          "ActionData":       { "type": "object" } } } } } } },

    "DataXMData":             { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":          { "type": "string", "maxLength": 2048 } } }
