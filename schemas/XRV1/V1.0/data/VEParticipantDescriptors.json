{ "$schema":                        "https://json-schema.org/draft/2020-12/schema",
  "$id":                            "https://schemas.mpai.community/XRV1/V1.0/data/VEParticipantDescriptors.json",
  "title":                          "VE Participant Descriptors V1.0",
  "description":                    "Descriptors of participants in a Virtual Environment (VE): scene, per-participant identity, pose, avatar, speech, and biometrics.",
  "type":                           "object",
  "additionalProperties":           false,
  "required":                       [ "Header", "VEParticipantDescriptorsID", "VEParticipantDescriptorsData", "UEnvironmentID", "VEParticipantDescriptorsTime" ],
  "properties":                     {

    "Header":                       { "type": "string", "const": "XRV-VTD-V1.0" },
    "MInstanceID":                  { "type": "string" },
    "UEnvironmentID":               { "type": "string" },
    "VEParticipantDescriptorsID":   { "type": "string" },
    "VEParticipantDescriptorsTime": { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },
    "AVSceneDescriptors":           { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/MultimodalSceneDescriptors.json" },

    "SeatOccupation":               { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/SeatOccupation.json" },

    "VEParticipantDescriptorsData": { "type": "array", "minItems": 0, "items": { "type": "object", "additionalProperties": false, "required": [ "VEParticipantID" ], "properties": {

      "VEParticipantID":            { "type": "string" },
      "SeatID":                     { "type": "string" },
      "SpatialAttitude":            { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" },

      "BiometricData":              { "$ref": "https://schemas.mpai.community/AIH1/V1.1/data/BiometricData.json" },
      "Brainwaves": { "$ref": "https://schemas.mpai.community/AIH1/V1.1/data/Brainwaves.json" },
      "ControlObject":              { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/ControlObject.json" },

      "AvatarOrAvatarID":           { "type": "array", "items": { "oneOf": [
                                    { "$ref": "https://schemas.mpai.community/PAF/V1.6/data/PortableAvatar.json" },
                                    { "type": "string" } ] }, "description": "Array of Portable Avatars (objects) or Portable Avatar IDs (string)." } } } },

    "DataXMData":                   { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                { "type": "string", "maxLength": 2048 } } }
