{ "$schema":                "https://json-schema.org/draft/2020-12/schema",
  "$id":                    "https://schemas.mpai.community/XRV1/V1.0/data/MetaverseObject.json",
  "title":                  "Metaverse Object V1.0", 
  "type":                   "object", 
  "additionalProperties":   false,
  "required":               [ "Header", "MetaverseObjectID", "MetaverseObjectData", "MetaverseQualifier", "UEnvironmentID", "MetaverseObjectTime" ],
  "properties":             {

    "Header":               { "type": "string", "const": "XRV-MVO-V1.0" },
    "MInstanceID":          { "type": "string" },
    "UEnvironmentID":       { "type": "string" },
    "MetaverseObjectID":    { "type": "string" },
    "MetaverseObjectTime":  { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "MetaverseObjectData":  { "type": "array", "items": { "oneOf": [
                            { "type": "object", "additionalProperties": false, "required": [ "DataURI" ], "properties": {
      "DataLength":         { "type": "integer", "minimum": 0 },
      "DataURI":            { "type": "string", "format": "uri" } } },
                            { "type": "object", "additionalProperties": false, "required": [ "Data" ], "properties": {
      "Data":               { "type": "string" } } },
                            { "type": "object", "additionalProperties": false, "required": [ "ID" ], "properties": {
      "ID":                 { "type": "string" } } } ] } },

    "MetaverseQualifier":   { "$ref": "https://schemas.mpai.community/TFA/V1.5/data/MetaverseQualifier.json" },

    "DataXMData":           { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":        { "type": "string", "maxLength": 2048 } } }
