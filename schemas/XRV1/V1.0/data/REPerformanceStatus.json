{ "$schema":                      "https://json-schema.org/draft/2020-12/schema",
  "$id":                          "https://schemas.mpai.community/XRV1/V1.0/data/REPerformanceStatus.json",
  "title":                        "RE Performance Status V1.0",
  "type":                         "object",
  "additionalProperties":         false,
  "required":                     [ "Header", "REPerformanceStatusID", "REPerformanceStatusData", "UEnvironmentID", "REPerformanceStatusTime" ],
  "properties":                   {

    "Header":                     { "type": "string", "const": "XRV-RFS-V1.0" },
    "MInstanceID":                { "type": "string" },
    "UEnvironmentID":             { "type": "string" },
    "REPerformanceStatusID":      { "type": "string" },
    "REPerformanceStatusTime":    { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "AVSceneDescriptors":         { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/MultimodalSceneDescriptors.json" },

    "REPerformanceStatusData":    { "type": "object", "additionalProperties": false, "properties": {

      "IndividualStatuses":       { "type": "array", "minItems": 0, "items": { "type": "object", "required": ["REPerformerID"], "additionalProperties": false, "properties": {
        "REPerformerID":          { "type": "string" },
        "SpatialAttitude":        { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" },
        "AudioBehaviour":         { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/AudioBehaviour.json" },
        "VisualBehaviour":        { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/VisualBehaviour.json" },
        "PersonalStatus":         { "$ref": "https://schemas.mpai.community/MMC/V2.5/data/PersonalStatus.json" },
        "Brainwaves": { "$ref": "https://schemas.mpai.community/AIH1/V1.1/data/Brainwaves.json" },
        "BiometricData":          { "$ref": "https://schemas.mpai.community/AIH1/V1.1/data/BiometricData.json" } } } },

      "CollectiveStatuses":       { "type": "array", "minItems": 0, "items": { "type": "object", "required": ["GroupID", "CentroidPosition", "PrincipalAxes"], "additionalProperties": false, "properties": {
        "GroupID":                { "type": "string" },
        "CentroidPosition":       { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Position.json" },
        "PrincipalAxes":          { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Orientation.json" },

        "PrincipalAxisVariances": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "minimum": 0 } },

        "PerformerPercentage":    { "type": "number", "minimum": 0, "maximum": 100 },

        "Brainwaves": { "$ref": "https://schemas.mpai.community/AIH1/V1.1/data/Brainwaves.json" },

        "BiometricSynchrony":     { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/BiometricSynchrony.json" },

        "AudioBehaviour":         { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/AudioBehaviour.json" },
        "VisualBehaviour":        { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/VisualBehaviour.json" },

        "Performers":             { "type": "array", "minItems": 0, "items": { "type": "object", "required": ["REPerformerID"], "additionalProperties": false, "properties": {
          "REPerformerID":          { "type": "string" },
          "DistanceFromCentroid": { "type": "number", "minimum": 0 } } } } } } },

      "Objects":                  { "type": "array", "minItems": 0, "items": { "type": "object", "required": ["REObjectID"], "additionalProperties": false, "properties": {
        "REObjectID":             { "type": "string" },
        "REObject":               { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/3DModelObject.json" },
        "SpatialAttitude":        { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" },
        "ControlObject":          { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/ControlObject.json" } } } },

      "RECameraData":              { "type": "array", "minItems": 0, "items": { "type": "object", "additionalProperties": false, "properties": {
        "REVisualObject":         { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/VisualObject.json" },
        "FieldOfView":            { "type": "number", "minimum": 0, "maximum": 180, "description": "Field of view, in degrees." },
        "REAudioObject":          { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/AudioObject.json" },
        "SpatialAttitude":        { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" } } } } } },

    "DataXMData":                 { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":              { "type": "string", "maxLength": 2048 } } }
