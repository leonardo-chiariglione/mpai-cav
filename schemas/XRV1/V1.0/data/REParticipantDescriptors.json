{ "$schema":                        "https://json-schema.org/draft/2020-12/schema",
  "$id":                            "https://schemas.mpai.community/XRV1/V1.0/data/REParticipantDescriptors.json",
  "title":                          "RE Participant Descriptors V1.0",
  "type":                           "object",
  "additionalProperties":           false,
  "required":                       [ "Header", "REParticipantDescriptorsID", "REParticipantDescriptorsData", "UEnvironmentID", "REParticipantDescriptorsTime" ],
  "properties":                     {

    "Header":                       { "type": "string", "const": "XRV-RTD-V1.0" },
    "MInstanceID":                  { "type": "string" },
    "UEnvironmentID":               { "type": "string" },
    "REParticipantDescriptorsID":   { "type": "string" },
    "REParticipantDescriptorsTime": { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "MultimodalSceneDescriptors":           { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/MultimodalSceneDescriptors.json" },
    "SeatOccupation":               { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/SeatOccupation.json" },

    "REParticipantDescriptorsData": { "type": "array", "minItems": 0, "items": { "type": "object", "required": ["REParticipantID"], "additionalProperties": false, "properties": {
      "REParticipantID":            { "type": "string" },
      "SeatID":                     { "type": "string" },
      "SpatialAttitude":            { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" },
      "FaceDescriptorsObject":      { "$ref": "https://schemas.mpai.community/PAF/V1.6/data/FaceDescriptorsObject.json" },
      "BodyDescriptorsObject":      { "$ref": "https://schemas.mpai.community/PAF/V1.6/data/BodyDescriptorsObject.json" },
      "ControlObject":              { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/ControlObject.json" },
      "BiometricData":              { "$ref": "https://schemas.mpai.community/AIH1/V1.1/data/BiometricData.json" },
      "Brainwaves":                 { "$ref": "https://schemas.mpai.community/AIH1/V1.1/data/Brainwaves.json" } } } },

    "DataXMData":                   { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                { "type": "string", "maxLength": 2048 } } }
