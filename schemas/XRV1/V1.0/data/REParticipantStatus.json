{ "$schema":                   "https://json-schema.org/draft/2020-12/schema",
  "$id":                       "https://schemas.mpai.community/XRV1/V1.0/data/REParticipantStatus.json",
  "title":                     "RE Participant Status V1.0",
  "type":                      "object",
  "additionalProperties":      false,
  "required":                  ["Header", "UEnvironmentID", "REParticipantStatusID", "REParticipantStatusTime", "REParticipantStatusData"],
  "properties":                {

    "Header":                  { "type": "string", "const": "XRV-RTS-V1.0" },
    "MInstanceID":             { "type": "string" },
    "UEnvironmentID":          { "type": "string" },
    "REParticipantStatusID":   { "type": "string" },
    "REParticipantStatusTime": { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "AVSceneDescriptors":      { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/AudioVisualSceneDescriptors.json" },
    "SeatOccupation":          { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/SeatOccupation.json" },

    "REParticipantStatusData": { "type": "object", "additionalProperties": false, "properties": {

      "IndividualStatuses":    { "type": "array", "minItems": 0, "items": { "type": "object", "required": ["REParticipantID"], "additionalProperties": false, "properties": {
        "REParticipantID":     { "type": "string" },
        "SeatID":              { "type": "string" },
        "SpatialAttitude":     { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" },
        "AudioBehaviour":      { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/AudioBehaviour.json" },
        "VisualBehaviour":     { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/VisualBehaviour.json" },
        "PersonalStatus":      { "$ref": "https://schemas.mpai.community/MMC/V2.5/data/PersonalStatus.json" },
        "Brainwaves":          { "$ref": "https://schemas.mpai.community/AIH1/V1.1/data/Brainwaves.json" },
        "BiometricData":       { "$ref": "https://schemas.mpai.community/AIH1/V1.1/data/BiometricData.json" },
        "ControlObject":          { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/ControlObject.json" } } } },

    "CollectiveStatuses":      { "type": "array", "minItems": 0, "items": { "type": "object", "additionalProperties": false, "required": ["GroupID", "CentroidPosition", "PrincipalAxes"], "properties": {
      "GroupID":               { "type": "string" },
      "CentroidPosition":      { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Position.json" },
      "PrincipalAxes":         { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Orientation.json" },

      "PrincipalAxisVariances":{ "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "minimum": 0 } },

      "ParticipantPercentage": { "type": "number", "minimum": 0, "maximum": 100 },
      "AudioBehaviour":        { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/AudioBehaviour.json" },
      "VisualBehaviour":       { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/VisualBehaviour.json" },

      "Brainwaves":            { "$ref": "https://schemas.mpai.community/AIH1/V1.1/data/Brainwaves.json" },
      "BiometricSynchrony":    { "$ref": "https://schemas.mpai.community/XRV1/V1.0/data/BiometricSynchrony.json" },
      "BiometricData":         { "$ref": "https://schemas.mpai.community/AIH1/V1.1/data/BiometricData.json" },

      "Participants":          { "type": "array", "minItems": 0, "items": { "type": "object", "required": ["REParticipantID"], "additionalProperties": false, "properties": {
        "REParticipantID":     { "type": "string" },
        "DistanceFromCentroid":{ "type": "number", "minimum": 0 } } } } } } } } },

    "DataXMData":              { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":           { "type": "string", "maxLength": 2048 } } }
