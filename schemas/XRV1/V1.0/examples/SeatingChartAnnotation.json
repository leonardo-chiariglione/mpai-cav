{ "$schema":                  "https://json-schema.org/draft/2020-12/schema",
  "$id":                      "https://schemas.mpai.community/XRV1/V1.0/examples/SeatingChartAnnotation.json",
  "title":                    "Annotation V1.5", "type": "object", "required": [ "Header", "AnnotationID", "AnnotationTime" ],
                              "additionalProperties": false, "properties": {

    "Header":                 { "type": "string", "const": "XRV-SCA-V1.0" },
    "MInstanceID":            { "type": "string" },
    "UEnvironmentID":         { "type": "string" },
    "AnnotationID":           { "type": "string" },
    "AnnotationTime":         { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "SeatingChart":           { "type": "object", "properties": {
      "SectorID":             { "type": "string" },
      "RowID":                { "type": "string" },
      "SeatID":               { "type": "string" },
      "PointOfView":          { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/PointOfView.json" } } },

    "DataXMData":             { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":          { "type": "string", "maxLength": 2048 } } }
