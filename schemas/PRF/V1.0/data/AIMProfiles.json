{ "$schema":                "https://json-schema.org/draft/2020-12/schema",
  "$id":                    "https://schemas.mpai.community/PRF/V1.0/data/AIMProfiles.json",
  "title":                  "AIMProfiles",
  "type":                   "object",
  "properties":             {
    "Header":               { "type": "string", "pattern": "^PRF-V[0-9]{1,2}[.][0-9]{1,2}$" },
    "Profile":              { "type": "string", "pattern": "^(ALL|NUL)([+-](AUO|AVG|AVM|BDO|BDD|FCI|FCO|FCD|EPS|ISD|LGP|MEM|SPM|OII|POV|PAV|SPD|SPI|SPO|TXD|TXO|TXR|TRN|VIO)|@EPS(#(SPT|PSS|PSF|PSG))+|@TRN(#([a-z]{3})(<->|->)([a-z]{3}))+)+$" } } }
