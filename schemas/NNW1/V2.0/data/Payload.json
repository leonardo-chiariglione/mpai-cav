{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mpai.community/NNW1/V2.0/data/Payload.json",
  "title": "Payload V2.0",
  "description": "The payload that a watermark carries: a bitstring. The original payload (the one embedded) and the retrieved one (the one a decoder returns) are two ports of this Data Type.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Header",
    "PayloadID",
    "PayloadData"
  ],
  "properties": {
    "Header": {
      "type": "string",
      "const": "NNW-PLD-V2.0"
    },
    "MInstanceID": {
      "type": "string"
    },
    "UEnvironmentID": {
      "type": "string"
    },
    "PayloadID": {
      "type": "string",
      "minLength": 1
    },
    "PayloadTime": {
      "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json"
    },
    "PayloadData": {
      "type": "string",
      "pattern": "^[01]+$",
      "description": "The payload, a bitstring (V1.1: bitstring)."
    },
    "DataXMData": {
      "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json"
    },
    "DescrMetadata": {
      "type": "string",
      "maxLength": 2048
    }
  }
}
