{ "$schema":              "https://json-schema.org/draft/2020-12/schema",
  "$comment":             "https://schemas.mpai.community/AIF/V3.0/data/AIMMetadata.json",
  "$id":                  "https://schemas.mpai.community/CAE3/V1.0/AIMs/SpeechSceneEditing.json",
  "title":                "Speech Scene Editing V1.0",
  "Header":               "CAE-SSE-V1.0",

  "Identifier":           {"ImplementerID": "/* String from IIDRA */", "ImplementationID": "/* String from Implementer */", "AIMName": "CAE-SSE-V1.0"},

  "APIProfile":           "Basic",
  "Description":          "Speech Scene Editing. One Basic Speech Scene is open at a time: a Basic Speech Scene arriving is opened, and the first Object added to no open Scene creates one. The User Command places Basic Speech Objects - named by their identifiers in Shared Storage - (AddedObjects), moves them, changes where they are, takes them out and sets where the Scene is heard from (UserPoV, also on its own Port). Every edit is a new version in Shared Storage; a member is held by its identifier and read from Shared Storage when the Scene is output. Outputs: the open Basic Speech Scene, and the User Command, with its report half (UserCommandReport) saying how each action was executed.",

  "InternalTypes":        [],

  "ExternalPorts":        [{"Name": "SpeechObject", "Direction": "Input", "DataType": "OSD-BSO-V1.5", "IsOptional": true, "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "SpeechScene", "Direction": "Input", "DataType": "OSD-BSS-V1.5", "IsOptional": true, "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "UserCommand", "Direction": "Input", "DataType": "CAE-UCM-V1.0", "IsOptional": true, "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "UserPoV", "Direction": "Input", "DataType": "OSD-OPV-V1.5", "IsOptional": true, "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "SpeechSceneDescriptors", "Direction": "Output", "DataType": "OSD-BSS-V1.5", "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "UserCommandReport", "Direction": "Output", "DataType": "CAE-UCM-V1.0", "IsOptional": true, "Technology": "Software", "Protocol": "", "IsRemote": false}],

