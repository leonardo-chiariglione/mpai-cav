{ "$schema":                  "https://json-schema.org/draft/2020-12/schema",
  "$id":                      "https://schemas.mpai.community/TFA/V1.5/data/ActionQualifier.json",
  "title":                    "Action Qualifier V1.5",
  "description":              "Action of the Persona with no effect on the M-Instance, produced by Basic Knowledge in a vocabulary named by its Qualifier and consumed by A-User Formation.",
  "type":                     "object",
  "additionalProperties":     false,
  "required":                 [ "Header", "ActionQualifierID", "Formats" ],
  "properties":               {

    "Header":                 { "type": "string", "const": "TFA-ACQ-V1.5" },
    "MInstanceID":            { "type": "string" },
    "UEnvironmentID":         { "type": "string" },
    "ActionQualifierID":      { "type": "string" },
    "ActionQualifierTime":    { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "Formats":                { "type": "object", "additionalProperties": false, "required": [ "ContentFormat" ], "properties": {
      "ContentFormat":        { "type": "string",
                               "description": "Identifier (name or URI) of the vocabulary or format of the content of the Object. MPAI recognises the identifiers it needs; this Data Type does not enumerate them." },
      "TransportFormat":      { "type": "string" } } },

    "Attributes":             { "type": "object" },

    "DataXMData":             { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":          { "type": "string", "maxLength": 2048 } } }
