{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mpai.community/PGM1/V1.0/data/LinguisticParalinguisticEvidence.json",
  "title": "Linguistic-Paralinguistic Evidence V1.0",
  "description": "The evidence borne by the content of the utterances of an Entity and by the manner of their delivery, with the agreement between the two, produced by Linguistic-Paralinguistic Analysis. Evidence that cannot be attributed to an Entity is reported but not asserted of any Entity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Header",
    "MInstance",
    "UEnvironment",
    "SessionID",
    "LinguisticParalinguisticEvidenceID",
    "LinguisticParalinguisticEvidenceTime",
    "Utterances"
  ],
  "properties": {
    "Header": {
      "type": "string",
      "const": "PGM-LPE-V1.0"
    },
    "MInstance": {
      "type": "string",
      "description": "Identifier of the M-Instance."
    },
    "UEnvironment": {
      "type": "string",
      "description": "Identifier of the U-Environment."
    },
    "SessionID": {
      "type": "string",
      "description": "Identifier of the A-User session."
    },
    "LinguisticParalinguisticEvidenceID": {
      "type": "string",
      "description": "Identifier of this instance."
    },
    "LinguisticParalinguisticEvidenceTime": {
      "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json"
    },
    "Utterances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "UtteranceID": {
            "type": "string"
          },
          "EntityID": {
            "type": "string",
            "description": "Entity to which the Harmonised Multimodal Context attributed the utterance; absent if unattributed."
          },
          "Interval": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "StartTime": {
                "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json"
              },
              "EndTime": {
                "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json"
              }
            },
            "description": "Time interval, on the time base of the capture."
          },
          "Linguistic": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "Content": {
                "type": "string",
                "description": "Propositional content."
              },
              "SpeechAct": {
                "type": "string",
                "enum": [
                  "asserting",
                  "asking",
                  "requesting",
                  "promising",
                  "declining",
                  "acknowledging",
                  "other"
                ]
              },
              "ReferringExpressions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "Text": {
                      "type": "string"
                    },
                    "EntityIDs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "Text"
                  ]
                }
              },
              "DiscourseRole": {
                "type": "string",
                "enum": [
                  "opening",
                  "responding",
                  "continuing",
                  "closing",
                  "interrupting"
                ]
              },
              "Sentiment": {
                "type": "string"
              },
              "Stance": {
                "type": "string"
              },
              "Language": {
                "type": "string"
              },
              "Register": {
                "type": "string"
              },
              "Formality": {
                "type": "string"
              }
            }
          },
          "Paralinguistic": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "Prosody": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "PitchContour": {
                    "type": "string"
                  },
                  "Stress": {
                    "type": "string"
                  },
                  "Intonation": {
                    "type": "string"
                  }
                }
              },
              "Timing": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "SpeechRate": {
                    "type": "number"
                  },
                  "Pausing": {
                    "type": "string"
                  },
                  "Hesitation": {
                    "type": "string"
                  }
                }
              },
              "VoiceQuality": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "Intensity": {
                    "type": "string"
                  },
                  "Breathiness": {
                    "type": "string"
                  },
                  "Tension": {
                    "type": "string"
                  },
                  "Tremor": {
                    "type": "string"
                  }
                }
              },
              "Disfluency": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "repetition",
                    "repair",
                    "filled_pause"
                  ]
                }
              },
              "NonVerbal": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "laughter",
                    "sigh",
                    "throat_clearing",
                    "other"
                  ]
                }
              }
            }
          },
          "Agreement": {
            "type": "string",
            "enum": [
              "reinforcing",
              "at_variance",
              "one_absent"
            ],
            "description": "Whether the delivery reinforces the content, is at variance with it, or one of the two is absent or unusable."
          },
          "Confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Confidence, 0 to 1."
          }
        },
        "required": [
          "UtteranceID",
          "Interval"
        ]
      }
    },
    "DataXMData": {
      "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json"
    },
    "DescrMetadata": {
      "type": "string",
      "maxLength": 2048
    }
  }
}
