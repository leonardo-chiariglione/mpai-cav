{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mpai.community/PGM1/V1.0/data/AUCPAL.json",
  "title": "AUC-PAL V1.0",
  "description": "The Data Type exchanged between A-User Control (AUC) and Personality Alignment (PAL). It has two modes, told apart by Mode: Request (RQ), sent by AUC to PAL (previously PAL Directive), and Response (RS), sent by PAL to AUC (previously PAL Status). Personality Alignment is a reasoning AIM: it decides the stance of the A-User and says whether, and how far, it adopted the correction proposed by AUC according to its Weight. A-User Control directs the constraints and the evidence it may use, whether it is Basic or Composite. Every Request is answered by a Response.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Header",
    "Mode",
    "MInstance",
    "UEnvironment",
    "SessionID",
    "AUCPALID",
    "AUCPALTime"
  ],
  "properties": {
    "Header": {
      "type": "string",
      "const": "PGM-UCP-V1.0"
    },
    "Mode": {
      "type": "string",
      "enum": [
        "RQ",
        "RS"
      ],
      "description": "RQ: Request (AUC to PAL), the old PAL Directive. RS: Response (PAL to AUC), the old PAL Status."
    },
    "MInstance": {
      "type": "string",
      "description": "Identifier of the M-Instance."
    },
    "UEnvironment": {
      "type": "string",
      "description": "Identifier of the U-Environment."
    },
    "SessionID": {
      "type": "string",
      "description": "Identifier of the A-User session."
    },
    "AUCPALID": {
      "type": "string",
      "description": "Identifier of this Request or Response."
    },
    "AUCPALTime": {
      "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json"
    },
    "Timeout": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "description": "Request only. The time, in milliseconds from the time of the Request, within which the Response shall be received. When it elapses without a Response, A-User Control treats the Request as not answered and the AIM shall not act on it any more."
    },
    "RequestID": {
      "type": "string",
      "description": "Response only. ID of the Request this Response answers."
    },
    "Instruction": {
      "type": "string",
      "enum": [
        "PED",
        "GLA",
        "PKQ",
        "GII",
        "PRF",
        "PCE",
        "CME",
        "AFR"
      ],
      "description": "Request only. The Instruction under which AUC issues the Request."
    },
    "Exchange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Phase": {
          "type": "string",
          "enum": [
            "new",
            "continuation"
          ]
        },
        "ResponseID": {
          "type": "string",
          "description": "ID of the Response to which a continuation Request follows."
        }
      },
      "required": [
        "Phase"
      ],
      "description": "Request only."
    },
    "Storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Write": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "Category": {
                "type": "string"
              },
              "Readers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "Time": {
                "type": "string",
                "enum": [
                  "module",
                  "session",
                  "persistent"
                ]
              }
            },
            "required": [
              "Category"
            ]
          }
        },
        "Read": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Request only. What the AIM may write to and read from the Private Storage of the Module, under the rules set by AUC."
    },
    "ProcessActionOutcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "PAStatus": {
          "type": "string"
        },
        "Complements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "Constraint": {
          "type": "string",
          "description": "Resulting constraint on the Goal."
        }
      },
      "description": "Request only. Outcome of a Process Action performed by AUC in the M-Instance, conveyed so that the AIM operates knowing the current M-Instance state."
    },
    "Outcome": {
      "type": "string",
      "enum": [
        "achieved",
        "achieved_differently",
        "not_achieved"
      ],
      "description": "Response only. The outcome reached."
    },
    "Reason": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Code": {
          "type": "string",
          "enum": [
            "none",
            "ambiguity_unresolved",
            "partner_unavailable",
            "constraint_conflict",
            "insufficient_context",
            "deadline_exceeded",
            "not_permitted"
          ]
        },
        "Description": {
          "type": "string"
        }
      },
      "required": [
        "Code"
      ],
      "description": "Response only. Structured reason, required when Outcome is not 'achieved'."
    },
    "StorageOutcome": {
      "type": "array",
      "description": "Response only. Outcome of the writes instructed by the Request.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "Category": {
            "type": "string"
          },
          "Result": {
            "type": "string",
            "enum": [
              "written",
              "not_authorised",
              "not_attempted"
            ]
          }
        },
        "required": [
          "Category",
          "Result"
        ]
      }
    },
    "Operation": {
      "type": "string",
      "enum": [
        "align",
        "style",
        "tone",
        "calibrate"
      ],
      "description": "Request only."
    },
    "Goal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Objective": {
          "type": "string"
        },
        "Constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "Objective"
      ],
      "description": "Request only. Binding as to the objective and the constraints."
    },
    "Correction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Proposal": {
          "type": "string"
        },
        "Weight": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "Rationale": {
          "type": "string"
        }
      },
      "required": [
        "Proposal",
        "Weight"
      ],
      "description": "Request only. A correction proposed by AUC. The AIM may adopt it, adopt it partially or decline it, and says so in the Response."
    },
    "Framing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Style": {
          "type": "string"
        },
        "Tone": {
          "type": "string"
        }
      },
      "description": "Request only. Framing strategy for the expression of the A-User."
    },
    "Constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Role": {
          "type": "string"
        },
        "Locale": {
          "type": "string"
        },
        "Guidelines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Request only. Role, locale and expressive or behavioural constraints to apply."
    },
    "Personality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ProfileTarget": {
          "type": "string"
        },
        "ForceProfileSwitch": {
          "type": "boolean"
        },
        "FallbackProfile": {
          "type": "string"
        }
      },
      "description": "Request only. Personality reconfiguration."
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "History": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Include": {
              "type": "boolean"
            },
            "MaxTurns": {
              "type": "integer",
              "minimum": 0
            },
            "TimeWindow": {
              "type": "string"
            }
          },
          "description": "How much of the Interaction History is used."
        },
        "MInstanceServices": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "M-Instance services (e.g., Personality profiles) that Personality Alignment may consult."
        }
      },
      "description": "Request only. The evidence Personality Alignment may use."
    },
    "Properties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "AUserState": {
          "type": "string",
          "enum": [
            "required",
            "optional",
            "not_requested"
          ]
        }
      },
      "description": "Request only. The properties to be produced, at property level."
    },
    "GoalUnderstood": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Objective": {
          "type": "string"
        },
        "Constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "Objective"
      ],
      "description": "Response only. The goal as the AIM understood it."
    },
    "Alignment": {
      "type": "string",
      "enum": [
        "aligned",
        "calibrating",
        "out_of_range"
      ],
      "description": "Response only."
    },
    "AUserStateID": {
      "type": "string",
      "description": "Response only. Identifier of the A-User State sent to A-User Formation."
    },
    "PropertyFulfilment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "AUserState": {
          "type": "string",
          "enum": [
            "produced",
            "partial",
            "missing",
            "not_requested"
          ]
        }
      },
      "description": "Response only. Fulfilment of the requested properties."
    },
    "AdoptedStance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Headline": {
          "type": "string"
        },
        "SelectedProfile": {
          "type": "string"
        },
        "FallbackUsed": {
          "type": "boolean"
        }
      },
      "required": [
        "Headline"
      ],
      "description": "Response only. The stance adopted for the A-User State."
    },
    "CorrectionResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Decision": {
          "type": "string",
          "enum": [
            "none",
            "adopted",
            "partial",
            "declined"
          ]
        },
        "Reason": {
          "type": "string"
        }
      },
      "required": [
        "Decision"
      ],
      "description": "Response only. Treatment of the Correction proposed by AUC."
    },
    "FramingOutcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Style": {
          "type": "string"
        },
        "Tone": {
          "type": "string"
        }
      },
      "description": "Response only. Framing as delivered."
    },
    "DataXMData": {
      "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json"
    },
    "DescrMetadata": {
      "type": "string",
      "maxLength": 2048
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "Mode": {
            "const": "RQ"
          }
        }
      },
      "then": {
        "required": [
          "Instruction",
          "Exchange",
          "Operation",
          "Goal"
        ],
        "properties": {
          "RequestID": false,
          "Outcome": false,
          "Reason": false,
          "StorageOutcome": false,
          "GoalUnderstood": false,
          "Alignment": false,
          "AUserStateID": false,
          "PropertyFulfilment": false,
          "AdoptedStance": false,
          "CorrectionResponse": false,
          "FramingOutcome": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "Mode": {
            "const": "RS"
          }
        }
      },
      "then": {
        "required": [
          "RequestID",
          "Outcome",
          "GoalUnderstood",
          "AdoptedStance"
        ],
        "properties": {
          "Instruction": false,
          "Exchange": false,
          "Storage": false,
          "ProcessActionOutcome": false,
          "Operation": false,
          "Goal": false,
          "Correction": false,
          "Framing": false,
          "Constraints": false,
          "Personality": false,
          "Evidence": false,
          "Properties": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "Mode": {
            "const": "RS"
          },
          "Outcome": {
            "enum": [
              "achieved_differently",
              "not_achieved"
            ]
          }
        },
        "required": [
          "Mode",
          "Outcome"
        ]
      },
      "then": {
        "required": [
          "Reason"
        ]
      }
    }
  ]
}