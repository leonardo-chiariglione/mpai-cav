{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mpai.community/PGM1/V1.0/data/RankedAudioObjects.json",
  "title": "Ranked Audio Objects V1.0",
  "description": "The Audio Objects of the scene ordered by the salience score computed by Audio Salience Mapping.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Header",
    "MInstance",
    "UEnvironment",
    "SessionID",
    "RankedAudioObjectsID",
    "RankedAudioObjectsTime",
    "Ranking"
  ],
  "properties": {
    "Header": {
      "type": "string",
      "const": "PGM-RAO-V1.0"
    },
    "MInstance": {
      "type": "string",
      "description": "Identifier of the M-Instance."
    },
    "UEnvironment": {
      "type": "string",
      "description": "Identifier of the U-Environment."
    },
    "SessionID": {
      "type": "string",
      "description": "Identifier of the A-User session."
    },
    "RankedAudioObjectsID": {
      "type": "string",
      "description": "Identifier of this instance."
    },
    "RankedAudioObjectsTime": {
      "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json"
    },
    "Ranking": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "AudioObjectID": {
            "type": "string"
          },
          "Rank": {
            "type": "integer",
            "minimum": 1
          },
          "SalienceScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "Components": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "Physical": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Motion, proximity, acoustic prominence and clarity."
              },
              "Semantic": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Audio object type."
              },
              "Contextual": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Directive and domain."
              }
            },
            "description": "The dimensions that contributed to the score."
          }
        },
        "required": [
          "AudioObjectID",
          "Rank",
          "SalienceScore"
        ]
      }
    },
    "DataXMData": {
      "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json"
    },
    "DescrMetadata": {
      "type": "string",
      "maxLength": 2048
    }
  }
}
