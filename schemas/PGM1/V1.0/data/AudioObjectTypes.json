{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mpai.community/PGM1/V1.0/data/AudioObjectTypes.json",
  "title": "Audio Object Types V1.0",
  "description": "The semantic object-type labels assigned to the Audio Objects of the scene by Audio Instance Identification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Header",
    "MInstance",
    "UEnvironment",
    "SessionID",
    "AudioObjectTypesID",
    "AudioObjectTypesTime",
    "Types"
  ],
  "properties": {
    "Header": {
      "type": "string",
      "const": "PGM-AOT-V1.0"
    },
    "MInstance": {
      "type": "string",
      "description": "Identifier of the M-Instance."
    },
    "UEnvironment": {
      "type": "string",
      "description": "Identifier of the U-Environment."
    },
    "SessionID": {
      "type": "string",
      "description": "Identifier of the A-User session."
    },
    "AudioObjectTypesID": {
      "type": "string",
      "description": "Identifier of this instance."
    },
    "AudioObjectTypesTime": {
      "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json"
    },
    "Types": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "AudioObjectID": {
            "type": "string"
          },
          "ObjectType": {
            "type": "string",
            "description": "Label or class (URI) assigned."
          },
          "Confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Confidence, 0 to 1."
          },
          "Basis": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "classification",
                "domain",
                "history"
              ]
            },
            "description": "What the assignment rests on."
          }
        },
        "required": [
          "AudioObjectID",
          "ObjectType"
        ]
      }
    },
    "DataXMData": {
      "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json"
    },
    "DescrMetadata": {
      "type": "string",
      "maxLength": 2048
    }
  }
}
