              }
            },
            "required": [
              "Reason"
            ]
          }
        },
        "PropertyFulfilment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "PromptGoal": {
              "type": "string",
              "enum": [
                "produced",
                "partial",
                "missing",
