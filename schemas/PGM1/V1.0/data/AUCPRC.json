  "allOf": [
    {
      "if": {
        "properties": {
          "Mode": {
            "const": "RQ"
          }
        }
      },
      "then": {
        "required": [
          "Instruction",
          "Exchange",
          "Operation",
          "Goal"
        ],
        "properties": {
          "RequestID": false,
          "Outcome": false,
          "Reason": false,
          "StorageOutcome": false,
          "GoalUnderstood": false,
          "PromptState": false,
          "PCPromptID": false,
          "BKNSessionOpened": false,
          "IntentOutcome": false,
          "PropositionsOutcome": false,
          "PromptGoalOutcome": false,
          "PersonalityOutcome": false,
          "ActionsOutcome": false,
          "FramingOutcome": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "Mode": {
            "const": "RS"
          }
        }
      },
      "then": {
        "required": [
          "RequestID",
          "Outcome",
          "GoalUnderstood",
          "PromptState"
        ],
        "properties": {
          "Instruction": false,
          "Exchange": false,
