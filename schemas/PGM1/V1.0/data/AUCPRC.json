                "not_requested"
              ]
            }
          },
          "description": "Fulfilment of the requested properties."
        },
        "GoalType": {
          "type": "string",
          "enum": [
            "clarify",
            "elaborate",
            "contrast",
            "summarize"
          ]
        }
      },
      "required": [
        "Outcome"
      ],
      "description": "Response only. Outcome of the Goal of the PC Prompt."
    },
    "PersonalityOutcome": {
