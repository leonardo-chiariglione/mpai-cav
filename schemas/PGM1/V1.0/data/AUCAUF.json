{ "$schema":                     "https://json-schema.org/draft/2020-12/schema",
  "$id":                         "https://schemas.mpai.community/PGM1/V1.0/data/AUCAUF.json",
  "title":                       "AUC-AUF V1.0",
  "description":                 "The Data Type exchanged between A-User Control (AUC) and A-User Formation (AUF). It has two modes, told apart by Mode: Request (RQ), sent by AUC to AUF, and Response (RS), sent by AUF to AUC. A-User Formation receives the Final Response of Basic Knowledge, which holds all the outputs of Basic Knowledge: the Text, the Actions and the Process Actions. It gives the Process Actions to AUC unchanged and generates, from the Actions, the Animation Objects for the rendering of the Portable Avatar. A-User Formation also forms the Portable Avatar and gives it to AUC. The Request controls the formation and each animation; the Response reports the outcome of each step and the progress of the animations. A-User Formation sends nothing to the M-Instance and the Portable Avatar leaves the A-User only if AUC authorises it. Every Request is answered by a Response.",
  "type":                        "object",
  "additionalProperties":        false,
  "required":                    [ "Header", "Mode", "MInstance", "UEnvironment", "SessionID", "AUCAUFID", "AUCAUFTime" ],

  "properties":                  {

    "Header":                    { "type": "string", "const": "PGM-UCF-V1.0" },
    "Mode":                      { "type": "string", "enum": [ "RQ", "RS" ], "description": "RQ: Request (AUC to AUF). RS: Response (AUF to AUC)." },
    "MInstance":                 { "type": "string", "description": "Identifier of the M-Instance." },
    "UEnvironment":              { "type": "string", "description": "Identifier of the U-Environment." },
    "SessionID":                 { "type": "string", "description": "Identifier of the A-User session." },
    "AUCAUFID":                  { "type": "string", "description": "Identifier of this Request or Response." },
    "AUCAUFTime":                { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },
    "Timeout":                   { "type": "integer", "exclusiveMinimum": 0,
                                   "description": "Request only. The time, in milliseconds from the time of the Request, within which the Response shall be received. When it elapses without a Response, A-User Control treats the Request as not answered and the AIM shall not act on it any more." },

    "RequestID":                 { "type": "string", "description": "Response only. ID of the Request this Response answers." },
    "Exchange":                  { "type": "object", "additionalProperties": false, "required": [ "Phase" ], "description": "Request only.", "properties": {
      "Phase":                   { "type": "string", "enum": [ "new", "continuation" ] },
      "ResponseID":              { "type": "string", "description": "ID of the Response to which a continuation Request follows." } } },

    "FormationControl":          { "type": "object", "additionalProperties": false, "description": "Request only. What A-User Formation forms (Speech, Face, Body and Avatar: required, optional or not_requested), whether the Personal Status modulates the delivery, and the spatial placement and orientation of the Portable Avatar.", "properties": {
      "Speech":                  { "type": "string", "enum": [ "required", "optional", "not_requested" ] },
      "Face":                    { "type": "string", "enum": [ "required", "optional", "not_requested" ] },
      "Body":                    { "type": "string", "enum": [ "required", "optional", "not_requested" ] },
      "Avatar":                  { "type": "string", "enum": [ "required", "optional", "not_requested" ] },
      "ExpressiveDelivery":      { "type": "string", "enum": [ "enabled", "disabled" ] },
      "SpatialOutput":           { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpatialAttitude.json" } } },

    "ActionControl":             { "type": "array", "description": "Request only. For an Action that A-User Formation is turning into Animation Objects: proceed with the animation or stop it.", "items": { "type": "object", "additionalProperties": false, "required": [ "Action", "Control" ], "properties": {
      "Action":          { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Actions.json#/properties/Action" },
      "Control":                 { "type": "string", "enum": [ "proceed", "stop" ] } } } },

    "Storage":                   { "type": "object", "additionalProperties": false, "description": "Request only. What A-User Formation may read from and write to the Private Storage of the Module, under the rules set by AUC. The Avatar Model and the Speech Model are read from there.", "properties": {
      "Write":                   { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": [ "Category" ], "properties": {
        "Category":              { "type": "string" },
        "Readers":               { "type": "array", "items": { "type": "string" } },
        "Time":                  { "type": "string", "enum": [ "module", "session", "persistent" ] } } } },

      "Read":                    { "type": "array", "items": { "type": "string" } } } },

    "ProcessActionOutcome":      { "type": "object", "additionalProperties": false, "description": "Request only. Outcome of a Process Action performed by AUC in the M-Instance, conveyed so that the AIM operates knowing the current M-Instance state.", "properties": {
      "PAStatus":                { "type": "string" },
      "Complements":             { "type": "array", "items": { "type": "string" } },
      "Constraint":              { "type": "string", "description": "Resulting constraint on the Goal." } } },

    "Outcome":                   { "type": "string", "enum": [ "achieved", "achieved_differently", "not_achieved" ], "description": "Response only. The outcome reached." },
    "Reason":                    { "type": "object", "additionalProperties": false, "required": [ "Code" ], "description": "Response only. Structured reason, required when Outcome is not 'achieved'.", "properties": {
      "Code":                    { "type": "string", "enum": [ "none", "ambiguity_unresolved", "partner_unavailable", "constraint_conflict", "insufficient_context", "deadline_exceeded", "not_permitted" ] },
      "Description":             { "type": "string" } } },

    "RenderState":               { "type": "string", "enum": [ "pending", "rendering", "rendered", "not_rendered" ],
                                   "description": "Response only. Current state of the formation of the Portable Avatar." },

    "ElementOutcomes":           { "type": "object", "additionalProperties": false, "description": "Response only. Outcome, and reason for any failure, of each formation step.", "properties": {
      "SpeechSynthesis":         { "type": "object", "additionalProperties": false, "required": [ "Outcome" ], "properties": {
        "Outcome":               { "type": "string", "enum": [ "success", "failure", "not_requested" ] },
        "Reason":                { "type": "string", "enum": [ "none", "model_unavailable", "asset_missing", "synthesis_error", "unsupported_qualifier", "input_invalid" ] } } },

      "FaceDescription":         { "type": "object", "additionalProperties": false, "required": [ "Outcome" ], "properties": {
        "Outcome":               { "type": "string", "enum": [ "success", "failure", "not_requested" ] },
        "Reason":                { "type": "string", "enum": [ "none", "model_unavailable", "asset_missing", "synthesis_error", "unsupported_qualifier", "input_invalid" ] } } },

      "BodyDescription":         { "type": "object", "additionalProperties": false, "required": [ "Outcome" ], "properties": {
        "Outcome":               { "type": "string", "enum": [ "success", "failure", "not_requested" ] },
        "Reason":                { "type": "string", "enum": [ "none", "model_unavailable", "asset_missing", "synthesis_error", "unsupported_qualifier", "input_invalid" ] } } },

      "AvatarSynthesis":         { "type": "object", "additionalProperties": false, "required": [ "Outcome" ], "properties": {
        "Outcome":               { "type": "string", "enum": [ "success", "failure", "not_requested" ] },
        "Reason":                { "type": "string", "enum": [ "none", "model_unavailable", "asset_missing", "synthesis_error", "unsupported_qualifier", "input_invalid" ] } } } } },

    "ActionStatus":              { "type": "array", "description": "Response only. Progress of the animations generated from the Actions.", "items": { "type": "object", "additionalProperties": false, "required": [ "Action", "Status" ], "properties": {
      "Action":          { "$ref": "https://schemas.mpai.community/MMM4/V2.2/data/Actions.json#/properties/Action" },
      "Status":                  { "type": "string", "description": "For instance proceeding, completed, stopped, failed." } } } },

    "PortableAvatarID":          { "type": "string", "description": "Response only. Identifier of the Portable Avatar produced and given to A-User Control for authorisation." },
    "StorageOutcome":            { "type": "array", "description": "Response only. Outcome of the writes instructed by the Request.", "items": { "type": "object", "additionalProperties": false, "required": [ "Category", "Result" ], "properties": {
      "Category":                { "type": "string" },
      "Result":                  { "type": "string", "enum": [ "written", "not_authorised", "not_attempted" ] } } } },

    "DataXMData":                { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":             { "type": "string", "maxLength": 2048 } } }