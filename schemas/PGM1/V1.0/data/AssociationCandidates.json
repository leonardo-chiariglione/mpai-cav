{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mpai.community/PGM1/V1.0/data/AssociationCandidates.json",
  "title": "Association Candidates V1.0",
  "description": "The admissible pairings of Audio Entities with Visual Entities proposed by Cross-Modal Candidate Association, each with its association score and the contribution of each kind of evidence. The association is many-to-many: no pairing is committed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Header",
    "MInstance",
    "UEnvironment",
    "SessionID",
    "AssociationCandidatesID",
    "AssociationCandidatesTime",
    "Candidates"
  ],
  "properties": {
    "Header": {
      "type": "string",
      "const": "PGM-ASC-V1.0"
    },
    "MInstance": {
      "type": "string",
      "description": "Identifier of the M-Instance."
    },
    "UEnvironment": {
      "type": "string",
      "description": "Identifier of the U-Environment."
    },
    "SessionID": {
      "type": "string",
      "description": "Identifier of the A-User session."
    },
    "AssociationCandidatesID": {
      "type": "string",
      "description": "Identifier of this instance."
    },
    "AssociationCandidatesTime": {
      "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json"
    },
    "Candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "AudioEntityID": {
            "type": "string"
          },
          "VisualEntityID": {
            "type": "string"
          },
          "AssociationScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "Evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "Spatial": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "Score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "Available": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "Available"
                ]
              },
              "Temporal": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "Score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "Available": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "Available"
                ]
              },
              "MotionCorrelation": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "Score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "Available": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "Available"
                ]
              },
              "Precedence": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "Score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "Available": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "Available"
                ]
              }
            },
            "description": "The contribution of each kind of evidence, with whether it was available."
          },
          "UnavailableEvidence": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "spatial",
                "temporal",
                "motion",
                "precedence"
              ]
            },
            "description": "Kinds of evidence that were unavailable for the pairing."
          }
        },
        "required": [
          "AudioEntityID",
          "VisualEntityID",
          "AssociationScore"
        ]
      }
    },
    "DataXMData": {
      "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json"
    },
    "DescrMetadata": {
      "type": "string",
      "maxLength": 2048
    }
  }
}
