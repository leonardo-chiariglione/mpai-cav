{ "$schema":                      "https://json-schema.org/draft/2020-12/schema",
  "$id":                          "https://schemas.mpai.community/AIH1/V1.1/data/Audit.json",
  "title":                        "Audit V1.1",
  "type":                         "object",
  "additionalProperties":         false,
  "required":                     [ "Header", "UserID", "AuditID", "AuditTime", "Audit" ],
  "properties":                   {

    "Header":                     { "type": "string", "const": "AIH-ADT-V1.1" },
    "MInstanceID":                { "type": "string", "description": "Metaverse instance ID (optional)." },
    "UEnvironment":               { "type": "string" },
    "UserID":                     { "type": "string", "description": "ID of End User auditing the system." },
    "AuditID":                    { "type": "string", "description": "Unique audit envelope ID." },
    "AuditTime":                  { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },

    "Audit":                      { "type": "object", "oneOf": [
                                  { "type": "object", "additionalProperties": false, "required": [ "Request" ], "properties": {
      "Request":                  { "type": "object", "additionalProperties": false, "required": [ "AuditPeriod", "ProcessingOperations", "Tokens" ],
                                    "properties": {
        "Tokens":                 { "$ref": "https://schemas.mpai.community/AIH1/V1.1/data/Tokens.json", "description": "The Tokens the End User was given on registering: the request is served if they grant the Auditing service." },
        "AuditPeriod":            { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },
        "ProcessingOperations":   { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false,
                                    "required": [ "ProcessingOperation" ], "properties": {
          "ProcessingOperation":  { "$ref": "https://schemas.mpai.community/AIH1/V1.1/data/AIHDataProcessingType.json" },
          "DataClass":            { "$ref": "https://schemas.mpai.community/AIH1/V1.1/data/AIHTaxonomies.json#/properties/DataClass" } } } } } } } },
                                  { "type": "object", "additionalProperties": false, "required": [ "Response" ], "properties": {
      "Response":                 { "type": "object", "additionalProperties": false, "required": [ "AIHDataIDs" ], "properties": {
        "ProcessingState":        { "type": "boolean", "description": "False if the request was refused (its Tokens do not grant the Auditing service); omitted or true if it was served." },
        "AIHDataIDs":             { "type": "array", "description": "The AIH Data processed against the licence; none where the audit found no violations.", "items": { "type": "object", "additionalProperties": false,
                                    "required": [ "AIHDataID" ], "properties": {
          "AIHDataID":            { "type": "string" },
          "ProcessTime":          { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },
          "AIMInstance":          { "$ref": "https://schemas.mpai.community/AIF/V3.0/data/AIMInstance.json"} } } } } } } } ] },

    "DataXMData":                 { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":              { "type": "string", "maxLength": 2048 } } }
