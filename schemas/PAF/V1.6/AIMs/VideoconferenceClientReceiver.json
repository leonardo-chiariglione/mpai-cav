                          {"Name": "OutputAvatarID", "Direction": "Output", "DataType": "string", "Technology": "Software", "Protocol": "", "IsRemote": false},
                          {"Name": "OutputText", "Direction": "Output", "DataType": "OSD-BTO-V1.5", "Technology": "Software", "Protocol": "", "IsRemote": false},
