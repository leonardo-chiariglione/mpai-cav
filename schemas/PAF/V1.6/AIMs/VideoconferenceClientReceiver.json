  "APIProfile":           "Basic",
  "Execution":            "Continuous",
  "Description":          "Videoconference Client Receiver: from the Portable Avatar it receives from the server it places the avatars in the Multimodal Scene Descriptors and adds their speech (Multimodal Scene Creation); Response and Scene Rendering adds the Personal Statuses to the avatars' speech, faces and bodies and gives the Avatars' IDs and the Multimodal Scene Descriptors. The Point of View of the participant goes to it, and round it. The Summary the server sends goes to the participant, who may correct it; the Output Text is the text of the Portable Avatar. It runs continuously.",

  "InternalTypes":        [ ],

  "ExternalPorts":        [{"Name": "PortableAvatars", "Direction": "Input", "DataType": "PAF-PAV-V1.6", "Technology": "Software", "Protocol": "", "IsRemote": true},
                          {"Name": "Summary", "Direction": "Input", "DataType": "MMC-SUM-V2.5", "IsOptional": true, "Technology": "Software", "Protocol": "", "IsRemote": true},
