  "Header":               "PAF-VMS-V1.6",

  "APIProfile":           "Basic",
  "Description":          "Virtual Meeting Secretary: from the Portable Avatar of each participant who speaks, it recognises and understands what was said, and creates the Summary of the meeting from it, from the participant's ID and from the Personal Status the Portable Avatar carries; Entity Dialogue Processing edits the Summary, gives it out, and - when the secretary has something to say - produces the text, the Personal Status and the Avatar Model of the VMS Portable Avatar, which Personal Status Display forms. The Summary goes round from Summary Creation to Entity Dialogue Processing and back: the Module runs continuously. Its External Ports (IsRemote) take the Portable Avatars from, and give its own and the Summary to, the Avatar Videoconference Server through Communication.",
  "Execution":            "Continuous",

  "InternalTypes":        [ ],

  "ExternalPorts":        [{"Name": "PortableAvatars", "Direction": "Input", "DataType": "PAF-PAV-V1.6", "Technology": "Software", "Protocol": "", "IsRemote": true},
