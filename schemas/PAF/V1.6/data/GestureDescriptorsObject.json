{ "$schema":                        "https://json-schema.org/draft/2020-12/schema",
  "$id":                            "https://schemas.mpai.community/PAF/V1.6/data/GestureDescriptorsObject.json",
  "title":                          "Gesture Descriptors Object V1.6",
  "type":                           "object",
  "additionalProperties":           false,
  "required":                       [ "Header", "GestureDescriptorsObjectID", "GestureDescriptorsData" ],
  "properties":                     {

    "Header":                       { "type": "string", "const": "PAF-GDO-V1.6",
                                      "description": "Gesture Descriptors Object Header - Standard PAF-GDO-V1.6. The Gesture Descriptors are a subset of the Body Descriptors of PAF-BDO-V1.6." },
    "MInstanceID":                  { "type": "string" },
    "UEnvironmentID":               { "type": "string" },
    "GestureDescriptorsObjectID":   { "type": "string" },
    "GestureDescriptorsObjectTime": { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "GestureDescriptorsData":       { "type": "array", "minItems": 0, "description": "Gesture Descriptors Data: the gesture-relevant subset of the body's joints and posture.",
                                    "items": { "anyOf": [
                                    { "type": "object", "additionalProperties": false, "properties": {
      "Confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "How likely it is that the Descriptors describe the input as it is." },
      "DataLength":                 { "type": "integer" },
      "DataURI":                    { "type": "string", "format": "uri" } } },
                                    { "type": "object", "additionalProperties": false, "properties": {
      "Confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "How likely it is that the Descriptors describe the input as it is." },
      "Data":                       { "type": "string" } } },
                                    { "type": "object", "additionalProperties": false, "properties": {
      "Confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "How likely it is that the Descriptors describe the input as it is." },
      "DataID":                     { "type": "string" } } } ] } },

    "GestureDescriptorsQualifier":  { "$ref": "https://schemas.mpai.community/TFA/V1.5/data/BodyDescriptorsQualifier.json",
                                      "description": "Gesture uses the SAME single Body Descriptors Qualifier (TFA-BDQ) and content-format enumeration as Body." },

    "DataXMData":                   { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                { "type": "string", "maxLength": 2048 } } }
