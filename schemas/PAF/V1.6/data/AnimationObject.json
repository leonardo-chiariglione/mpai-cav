{ "$schema":              "https://json-schema.org/draft/2020-12/schema",
  "$id":                  "https://schemas.mpai.community/PAF/V1.6/data/AnimationObject.json",
  "title":                "Animation Object V1.6",
  "type":                 "object",
  "additionalProperties": false,
  "required":             [ "Header", "AnimationObjectID", "AnimationObjectData" ],
  "properties":           {

    "Header":             { "type": "string", "const": "PAF-AMO-V1.6" },
    "MInstanceID":        { "type": "string" },
    "UEnvironmentID":     { "type": "string" },
    "AnimationObjectID":  { "type": "string" },
    "AnimationObjectTime":{ "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },

    "AnimationObjectData":{ "type": "array", "items": { "anyOf": [
                          { "type": "object", "properties": {
      "Data":             { "type": "string" } } },
                          { "type": "object", "properties": {
      "DataLength":       { "type": "integer" },
      "DataURI":          { "type": "string", "format": "uri" } } },
                          { "type": "object", "properties": {
      "ID":               { "type": "string" } } } ] } },

    "AnimationQualifier": { "$ref": "https://schemas.mpai.community/TFA/V1.5/data/AnimationQualifier.json" },

    "DataXMData":         { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":      { "type": "string", "maxLength": 2048 } } }
