{ "$schema":              "https://json-schema.org/draft/2020-12/schema",
  "$id":                  "https://schemas.mpai.community/PTF/V1.0/data/SecurityEvidenceTaxonomy.json",
  "title":                "Security Evidence Taxonomy V1.0",
  "description":          "Taxonomy of evidence types used for attestation and runtime trust decisions.",
  "type":                 "object",
  "additionalProperties": false,

  "definitions":          {
    "EvidenceType":       { "type": "string", "enum": [ "AIF-EVID-TEE-REPORT",
                                                        "AIF-EVID-TPM-QUOTE",
                                                        "AIF-EVID-CODE-HASH",
                                                        "AIF-EVID-CONFIG-HASH",
                                                        "AIF-EVID-RUNTIME-MEASUREMENT",
                                                        "AIF-EVID-ENVIRONMENT",
                                                        "AIF-EVID-CUSTOM" ] } },

  "properties":           {
    "TEEReport":          { "const": "AIF-EVID-TEE-REPORT" },
    "TPMQuote":           { "const": "AIF-EVID-TPM-QUOTE",
                            "description": "A quote of a TPM 2.0: the TPMS_ATTEST of TPM2_Quote over a nonce the verifier chose, its signature by the attestation key, and the certificate of that key by the TPM's manufacturer. The measurements it covers are given as AIF-EVID-RUNTIME-MEASUREMENT items, in the order they were extended." },
    "CodeHash":           { "const": "AIF-EVID-CODE-HASH" },
    "ConfigHash":         { "const": "AIF-EVID-CONFIG-HASH" },
    "RuntimeMeasurement": { "const": "AIF-EVID-RUNTIME-MEASUREMENT" },
    "Environment":        { "const": "AIF-EVID-ENVIRONMENT" },
    "Custom":             { "const": "AIF-EVID-CUSTOM" } } }

