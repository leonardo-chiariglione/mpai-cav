{ "Identifier":           {"ImplementerID": "1", "ImplementationID": "MMC-AMC-V2.5-I01", "AIMName": "1MMC-AMC-V2.5-I01"},
  "Header":               "MMC-AMC-V2.5",

  "APIProfile":           "Basic",
  "OnDegraded":           "Continue",
  "Description":          "Affective Multimodal Conversation: speech-only affective dialogue. Automatic Speech Recognition recognises the speech; Natural Language Understanding produces the Text Descriptors, the (refined) NLU Text and the Text Personal Status; Personal Status Extraction reads the Speech Personal Status from the Speech Object and multiplexes it with the Text Personal Status into the entity's Personal Status; Entity Dialogue Processing produces the machine's response Text and Personal Status, aware of both the meaning and the feeling; Text-To-Speech makes the Speech Object of the response; Portable Avatar Multiplexing puts the response, text and speech, with its Personal Status, in the Portable Avatar, which the User Agent renders. The Summary of the conversation is internal to Entity Dialogue Processing. Acquisition and delivery are the User Agent, not sub-AIMs.",

  "InternalTypes":        [{"Name": "RecognisedText", "DataType": "OSD-BTO-V1.5"}, {"Name": "NLUText", "DataType": "OSD-BTO-V1.5"}, {"Name": "TextPersonalStatus", "DataType": "MMC-TPS-V2.5"}, {"Name": "PersonalStatus", "DataType": "MMC-EPS-V2.5"}, {"Name": "MachineText", "DataType": "OSD-BTO-V1.5", "Output": 1}, {"Name": "MachinePersonalStatus", "DataType": "MMC-EPS-V2.5"}],

