{ "Identifier":           {"ImplementerID": "1", "ImplementationID": "MMC-OCR-V2.5-I01", "AIMName": "1MMC-OCR-V2.5-I01"},
  "Header":               "MMC-OCR-V2.5",

  "APIProfile":           "Basic",
  "Description":          "Optical Character Recognition. Receives the image of a page as a Basic Visual Object and, optionally, a Point on it (OSD-PNT-V1.5), and produces a Text Object: the lines of text found on a band of the page about the Point (at the top of the page with no Point), in the full width of the page, in reading order, each a Basic Text Object with its box on the page and its confidence. A box is given by the Space-Time of the line in the Text Object: SpatialAttitude1 its top-left corner, SpatialAttitude2 its bottom-right corner, in the pixels of the image (X to the right, Y down); the Text Object's own Space-Time is the whole image.",

  "InternalTypes":        [],

  "ExternalPorts":        [{"Name": "PageImage", "Direction": "Input",  "DataType": "OSD-BVO-V1.5", "Technology": "Software", "Protocol": "", "IsRemote": false},
