{ "Identifier":       {"ImplementerID": "1", "ImplementationID": "AIH-HFE-V1.1-I02", "AIMName": "1AIH-HFE-V1.1-I02"},
  "Header":           "AIH-HFE-V1.1",
  "APIProfile":       "Secure",
  "Execution":        "Continuous",
  "Description":      "This AIM implements the AIH-HSP Health Front End. What it does depends on the User Profile it ingests. For an End User - an individual - it makes the End User's AIH Data, keeps it in the Secure Data Vault, trains on it, and has the Health Back End keep, process, de-identify, anonymise and audit it: that AIH Data only, and it needs no control of licence. For a Third-Party User - a Third-Party User Profile, or a User Profile of an individual who is a member of an organisation - it makes and keeps no AIH Data and trains nothing: it asks the Health Back End to process AIH Data, as the licence of each AIH Data prescribes, and does nothing else. It is a Composite AIM of AIH-ARA-V1.1, AIH-HDP-V1.1, AIH-MDL-V1.1.",
  "InternalTypes":    [{"Name": "AIHData", "DataType": "AIH-AHD-V1.1"}, {"Name": "ARAData", "DataType": "AIH-ARD-V1.1"}, {"Name": "AIHDataProcess", "DataType": "AIH-AHP-V1.1"}, {"Name": "HealthData", "DataType": "AIH-HLD-V1.1"}, {"Name": "ModelLicence", "DataType": "AIH-MDL-V1.1"}, {"Name": "Register", "DataType": "AIH-REG-V1.1"}, {"Name": "FederatedLearn", "DataType": "AIH-FDL-V1.1"}, {"Name": "DeIDAndAnonym", "DataType": "AIH-DIA-V1.1"}, {"Name": "Audit", "DataType": "AIH-ADT-V1.1"}],
