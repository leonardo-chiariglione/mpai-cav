<Project Sdk="Microsoft.NET.Sdk">

  <!-- RcaConsole - a Remote Client Application with no face.
       Runs a Workflow Description against a Controller with stand-in devices, so
       that the interpreter can be proved before a window, a camera and a
       loudspeaker are added. It knows no application: the workflow names the
       Modules and the registry names the devices. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RcaConsole</AssemblyName>
    <RootNamespace>MpaiRca.Console</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\UserAgent\Rca\Mpai.Rca.csproj" />
    <ProjectReference Include="..\..\..\UserAgent\Wdl\Mpai.Wdl.csproj" />
    <ProjectReference Include="..\..\..\AIF\ControllerApi\Mpai.Aif.Api.csproj" />
    <ProjectReference Include="..\..\..\UserAgent\Remote\Mpai.Mas.Client.csproj" />
    <ProjectReference Include="..\..\..\AIMs\Core\Mpai.Core.csproj" />
  </ItemGroup>

</Project>